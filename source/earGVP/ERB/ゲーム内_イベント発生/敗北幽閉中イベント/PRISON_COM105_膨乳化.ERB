;**********************************************************
;幽閉コマンド
;PRISON_COM105
;膨乳化 限界の場合は膨乳攻め
;**********************************************************
@PRISON_COM105
#DIM CCOUNT
VARSET LOCAL
TFLAG:10 = 105

;取得する珠
;LOCAL:0 快Ｃ
;LOCAL:1 快Ｖ
;LOCAL:2 快Ａ
;LOCAL:3 快Ｂ
;LOCAL:4 潤滑 潤滑は未使用
;LOCAL:5 恭順
;LOCAL:6 習得
;LOCAL:7 欲情
;LOCAL:8 屈服
;LOCAL:9 恥情
;LOCAL:10 苦痛
;LOCAL:11 恐怖

;経験数の上量値記録用
;LOCAL:120 V経験
;LOCAL:121 A経験
;LOCAL:123 精液経験
;LOCAL:124 フェラ経験
;LOCAL:130 露出快楽経験,
;LOCAL:131 奉仕快楽経験,
;LOCAL:132 苦痛快楽経験,
;LOCAL:140 自慰経験,
;LOCAL:150 異常経験
;LOCAL:151 Ｖ拡張経験
;LOCAL:152 Ａ拡張経験
;LOCAL:153 射精経験
;LOCAL:154 噴乳経験
;LOCAL:155 放尿経験
;LOCAL:156 寄生経験
;LOCAL:157 出産経験

;汚染度
CFLAG:30 += 10 + RAND:5

;膨乳の余地を判定
IF TALENT:巨乳+MAX(0,TALENT:変身時胸サイズ変動) < 2+(CONFIG_CHECK_MANIAC_F(19) == 1 ? 3 # 0)
	;変身時に「縮」乳している場合は変身時膨乳を優先
	IF TALENT:変身時胸サイズ変動 < 0
		TALENT:変身時胸サイズ変動 += 1
		CFLAG:38 += 1
	ELSE
		;膨乳処理
		IF TALENT:巨乳 - TALENT:貧乳 < 0
			TALENT:貧乳 -= 1
		ELSE
			TALENT:巨乳 += 1
		ENDIF

		;変身時に限界突破してしまう場合は変身時胸サイズを調整
		;極端なサイズを抑制されているなら爆乳までが限界
		IF (TALENT:巨乳 + TALENT:変身時胸サイズ変動 > 5) || (CONFIG_CHECK_MANIAC_F(19) == 0 && TALENT:巨乳 + TALENT:変身時胸サイズ変動 >= 2)
			TALENT:変身時胸サイズ変動 -= 1
			CFLAG:38 -= 1
		ENDIF

		CFLAG:37 += 1
	ENDIF
	;プロフィールに反映
	CALL SET_PROFILE, TARGET

	;恐怖　固定で
	LOCAL:11 = 800
	
	;地の文：悪堕ちキャラが幽閉中の操作キャラを膨乳化した
	SIF CFLAG:20 == 2
		CALL MESSAGE_OTHER_PRISON_BOUNYU
	;地の文：膨乳化
	CALL MESSAGE_PRISON_BOUNYU

	
ELSE
	;快B
	IF ABL:Ｂ感覚 == 0
		LOCAL:3 = 100
	ELSEIF ABL:Ｂ感覚 == 1
		LOCAL:3 = 150
	ELSEIF ABL:Ｂ感覚 == 2
		LOCAL:3 = 200
	ELSEIF ABL:Ｂ感覚 == 3
		LOCAL:3 = 600
	ELSEIF ABL:Ｂ感覚 == 4
		LOCAL:3 = 1000
	ELSEIF ABL:Ｂ感覚 >= 5
		LOCAL:3 = 1500
	ENDIF

	;メイン部位絶頂見込みの予測
	CALL PALAM_VABCestimate(LOCAL,3,-1)


	
	;習得
	IF ABL:奉仕精神 == 0
		LOCAL:6 = 10
	ELSEIF ABL:奉仕精神 == 1
		LOCAL:6 = 25
	ELSEIF ABL:奉仕精神 == 2
		LOCAL:6 = 50
	ELSEIF ABL:奉仕精神 == 3
		LOCAL:6 = 80
	ELSEIF ABL:奉仕精神 == 4
		LOCAL:6 = 125
	ELSEIF ABL:奉仕精神 >= 5
		LOCAL:6 = 180
	ENDIF

	;地の文：悪堕ちキャラが幽閉中の操作キャラに膨乳攻めをした
	SIF CFLAG:20 == 2
		CALL MESSAGE_OTHER_PRISON_COM_105
	;地の文：膨乳攻め
	CALL MESSAGE_PRISON_COM_105
	
ENDIF

;習得基本値
LOCAL:6 += 20

;欲情基本値
LOCAL:7 += 100

;屈服基本値
LOCAL:8 += 200

;恥情基本値
LOCAL:9 += 200

;苦痛基本値
LOCAL:10 += 0

;恐怖基本値
LOCAL:11 += 50

;幽閉中パラメータ変動共通処理へ
CALL COMMON_PRISON, LOCAL:0, LOCAL:1, LOCAL:2, LOCAL:3, LOCAL:4, LOCAL:5, LOCAL:6, LOCAL:7, LOCAL:8, LOCAL:9, LOCAL:10, LOCAL:11

;経験数の増加
CALL COMMON_PRISON_EXP_SH, LOCAL:120, LOCAL:121, LOCAL:151, LOCAL:152
LOCAL:120 = RESULT:0
LOCAL:121 = RESULT:1
LOCAL:151 = RESULT:2
LOCAL:152 = RESULT:3

;拡張度による拡張経験
CALL PRISON_GAPING, LOCAL:120, LOCAL:121, LOCAL:151, LOCAL:152, LOCAL:152, LOCAL:0, LOCAL:1, LOCAL:2, LOCAL:3
LOCAL:151 += RESULT:0
LOCAL:152 += RESULT:1

;表示と増加の処理
FOR CCOUNT, 100, 200
	CALL COMMON_PRISON_EXP, CCOUNT, LOCAL:CCOUNT
NEXT

PRINTL 

;珠の取得へ
CALL _ABLUP, 1
