;**********************************************************
;幽閉コマンドのCOMABLE
;キャラの身体的特徴によって実行不可なコマンドを他のコマンドに割り振ったりしている

;ARG=コマンド番号
@PRISON_COMABLE, ARG
#DIM LCOUNT
#DIM SH_VAR, 感覚数

;結界振替え用
IF ARG == -1
	$SHIELDED

	;部位結界で阻まれた場合、結界ない箇所をランダムで中心攻め(全箇所結界ならランダム)
	REPEAT 感覚数
		LOCAL:COUNT = 0
	REND
	LCOUNT = 0
	REPEAT 感覚数
		IF BASE:(COUNT + 30) < 1
			LOCAL:LCOUNT = COUNT
			LCOUNT += 1
		ENDIF
	REND
	IF LCOUNT
		ARG = LOCAL:(RAND:LCOUNT)
	ELSE
		ARG = RAND:感覚数
	ENDIF
;元のはこちら
;	VARSET SH_VAR
;	FOR LCOUNT, 0, 感覚数
;		SIF BASE:(LCOUNT + 30) > 0
;			SH_VAR:LCOUNT = 1
;	NEXT
;
;	DO
;		ARG = RAND:感覚数
;	LOOP SH_VAR:ARG == 1
ENDIF

SELECTCASE ARG
	;C中心攻め
	CASE 0
		CALL PRISON_COM0
	;V中心攻め
	CASE 1
		;男の娘の場合はA中心攻めで代替する
		IF TALENT:男の娘 > 0
			CALL PRISON_COM2
		;オトコの場合はC中心攻めで代替する
		ELSEIF ISMALE()
			CALL PRISON_COM0
		;聖処女用だったやつ(B攻めに振り変えてたけどやめ)
		;ELSEIF CHECK_HOLYVIRGIN_F()==1
		;	CALL PRISON_COM3
		ELSE
			CALL PRISON_COM1
		ENDIF
	;A中心攻め
	CASE 2
		CALL PRISON_COM2
	;B中心攻め
	CASE 3
		CALL PRISON_COM3
	;Sな攻め
	CASE 4
		CALL PRISON_COM4
	;強制奉仕
	CASE 5
		CALL PRISON_COM5
	;羞恥な攻め
	CASE 6
		;感情乏しい場合はSな攻めで代替する
		IF TALENT:感情乏しい > 0
			CALL PRISON_COM4
		ELSE
			CALL PRISON_COM6
		ENDIF
	;子触手に犯される
	CASE 7
		;部位結界
		SIF SHIELD:1 > 0
			GOTO SHIELDED
		;男の娘の場合はA中心攻めで代替する
		IF TALENT:男の娘 > 0
			CALL PRISON_COM2
		;オトコの場合はC中心攻めで代替する
		ELSEIF ISMALE()
			CALL PRISON_COM0
		;聖処女の場合は強制奉仕で代替する
		ELSEIF CHECK_HOLYVIRGIN_F()==1
			CALL PRISON_COM5
		ELSE
			CALL PRISON_COM7
		ENDIF
	;ふたなり攻め
	CASE 100
		;部位結界
		SIF SHIELD:0 > 0
			GOTO SHIELDED
		;オトコの場合やフィルタ×の場合はC中心攻めで代替する
		IF ISMALE() || CONFIG_CHECK_MANIAC_F(1) == 0
			CALL PRISON_COM0
		ELSE
			CALL PRISON_COM100
		ENDIF
	;V拡張
	CASE 101
		;部位結界
		SIF SHIELD:1 > 0
			GOTO SHIELDED
		;A経験が少ない男の娘の場合、A中心攻めにする
		IF TALENT:男の娘 > 0 && EXP:Ａ経験 < 20
			CALL PRISON_COM2
		;男の娘の場合はA拡張攻めで代替する
		ELSEIF TALENT:男の娘 > 0
			;部位結界
			SIF SHIELD:2 > 0
				GOTO SHIELDED
			CALL PRISON_COM102
		;オトコの場合はC中心攻めで代替する
		ELSEIF ISMALE()
			CALL PRISON_COM0
		;聖処女の場合は強制奉仕で代替する
		ELSEIF CHECK_HOLYVIRGIN_F()==1
			CALL PRISON_COM5
		;V経験が少ない場合、V中心攻めにする
		ELSEIF EXP:Ｖ経験 < 20
			CALL PRISON_COM1
		ELSE
			CALL PRISON_COM101
		ENDIF
		
	;A拡張
	CASE 102
		;部位結界
		SIF SHIELD:2 > 0
			GOTO SHIELDED
		;A経験が少ない場合、A中心攻めにする
		IF EXP:Ａ経験 < 20
			CALL PRISON_COM2
		ELSE
			CALL PRISON_COM102
		ENDIF
		
	;搾乳攻め
	CASE 103
		;部位結界
		SIF SHIELD:3 > 0
			GOTO SHIELDED
		;オトコの場合やフィルタ×の場合はB中心攻めで代替する
		IF ISMALE() || CONFIG_CHECK_MANIAC_F(2) == 0
			CALL PRISON_COM3
		ELSE
			CALL PRISON_COM103
		ENDIF
	;種付け
	CASE 104
		;部位結界
		SIF SHIELD:1 > 0
			GOTO SHIELDED
		;男の娘の場合は強制奉仕で代替する
		IF TALENT:男の娘 > 0
			CALL PRISON_COM5
		;オトコの場合はC中心攻めで代替する
		ELSEIF ISMALE()
			CALL PRISON_COM0
		;聖処女の場合は強制奉仕で代替する
		ELSEIF CHECK_HOLYVIRGIN_F()==1
			CALL PRISON_COM5
		ELSE
			;Ｖ感覚Lv5以上かＶ拡張経験が10以上でなければＶ拡張
			IF ABL:Ｖ感覚 < 5 && EXP:Ｖ拡張経験 < 10
				;V経験が少ない場合、V中心攻めにする
				IF EXP:Ｖ経験 < 20
					CALL PRISON_COM1
				ELSE
					CALL PRISON_COM101
				ENDIF
			ELSE
				CALL PRISON_COM104
			ENDIF
		ENDIF
	;膨乳化
	CASE 105
		;部位結界
		SIF SHIELD:3 > 0
			GOTO SHIELDED
		;オトコの場合やフィルタ×の場合はB中心攻めで代替する
		IF ISMALE() || CONFIG_CHECK_MANIAC_F(18) == 0
			CALL PRISON_COM3
		ELSE
			CALL PRISON_COM105
		ENDIF
	;Vに産卵
	CASE 200
		;部位結界
		SIF SHIELD:1 > 0
			GOTO SHIELDED
		;男の娘の場合はAに産卵で代替する
		IF TALENT:男の娘 > 0
			;部位結界
			SIF SHIELD:2 > 0
				GOTO SHIELDED
			IF EXP:Ａ拡張経験 > 3
				CALL PRISON_COM201
			;拡張経験が足りなければ拡張コマンドにする
			ELSE
				CALL PRISON_COM102
			ENDIF
		;オトコの場合はC中心攻めで代替する
		ELSEIF ISMALE()
			CALL PRISON_COM0
		;聖処女の場合はAに産卵で代替する
		ELSEIF CHECK_HOLYVIRGIN_F()==1
			;部位結界
			SIF SHIELD:2 > 0
				GOTO SHIELDED
			IF EXP:Ａ拡張経験 > 3
				CALL PRISON_COM201
			;拡張経験が足りなければ拡張コマンドにする
			ELSE
				CALL PRISON_COM102
			ENDIF
		ELSEIF EXP:Ｖ拡張経験 > 3
			CALL PRISON_COM200
		;拡張経験が足りなければ拡張コマンドにする
		ELSE
			CALL PRISON_COM101
		ENDIF
	;Aに産卵
	CASE 201
		;部位結界
		SIF SHIELD:2 > 0
			GOTO SHIELDED
		IF EXP:Ａ拡張経験 > 3
			CALL PRISON_COM201
		;拡張経験が足りなければ拡張コマンドにする
		ELSE
			CALL PRISON_COM102
		ENDIF
	;注射　淫乱系素質をつける
	CASE 300
		CALL PRISON_COM300
	;寄生　触手を寄生させる
	CASE 301
		;フィルタ×の場合や既に寄生持ちの場合は、C攻め、B攻め、注射に割り振る
		IF TALENT:寄生 || CONFIG_CHECK_MANIAC_F(3) == 0
			SELECTCASE RAND:3
				CASE 0
					CALL PRISON_COM0
				CASE 1
					CALL PRISON_COM1
				CASE 2
					CALL PRISON_COM300
			ENDSELECT
		ELSE
			CALL PRISON_COM301
		ENDIF
ENDSELECT
