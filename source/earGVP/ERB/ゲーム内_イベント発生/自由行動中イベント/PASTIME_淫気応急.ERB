;-----------------------------------------------------------------------------------------
;経験増加・妊娠判定など	ARG:0 == 部位渡し, ARG:1 == SHOJO(性交の種類), ARG:2 == S_膣内精液
;-----------------------------------------------------------------------------------------
@CALC_INKIOKYU, ARG:0, ARG:1 = 0, ARG:2 = 0
#DIM CCOUNT
#DIM SHOJO
#DIM S_回数
#DIM S_膣内精液
#DIM C_計算元
#DIM 部位

VARSET LOCAL

;(部位渡し 手 == 1 割れ目 == 2 下着 ==  3 脚 == 4 尻肉 == 5 顔 == 6 双丘 == 7)
部位 = ARG:0
SHOJO = ARG:1
S_膣内精液 = ARG:2

;総処置数
S_回数 = 12 + RAND:5
;精液経験
LOCAL:123 = 15 + RAND:16
;ACTION_SEISANを参考に基準値を定義
C_計算元 = BASE:体力 * (10 + RAND:3) / 100

;Ｖ経験	Ａ経験---------------------------------------------
IF SHOJO == 1
	;Ｖ経験
	LOCAL:120 += 1
ELSEIF SHOJO == 2
	;Ａ経験
	LOCAL:121 += 1
ELSEIF SHOJO == 3
	IF ABL:Ｖ感覚 >= 4 && ABL:Ａ感覚 >= 4
		;Ｖ経験
		LOCAL:120 += 2 + RAND:5
		;Ａ経験
		LOCAL:121 += 2 + RAND:5
	ELSEIF ABL:Ｖ感覚 >= ABL:Ａ感覚
		;Ｖ経験
		LOCAL:120 += 4 + RAND:5
	ELSE
		;Ａ経験
		LOCAL:121 += 4 + RAND:5
	ENDIF
ELSEIF SHOJO == 4
	;Ａ経験
	LOCAL:121 += 4 + RAND:5
ELSEIF SHOJO == 5
	;Ｖ経験
	LOCAL:120 = S_回数 - 6
ELSEIF SHOJO == 6
	;Ａ経験
	LOCAL:121 = S_回数 - 6
ENDIF

;被姦経験--------------------------------------------------
SIF SHOJO == 1 || SHOJO == 2 || SHOJO == 5 || SHOJO == 6
	LOCAL:110 += 1

;絶頂、奉仕快楽、射精、噴乳、放尿経験----------------------
IF SHOJO == 1 || SHOJO == 2
	LOCAL:122 += 1
	IF (部位 == 7 && ABL:Ｂ感覚 >= 4) || (部位 == 6 && ABL:精液中毒 >= 4) || (部位 == 3 && ABL:Ｃ感覚 >= 3) || (部位 == 2 && ABL:Ｃ感覚 >= 2)
		;絶頂経験
		LOCAL:122 += C_計算元 * (1 + RAND:2) / 100 + RAND:4
		;奉仕快楽経験
		LOCAL:131 += C_計算元 * (2 + RAND:3) / 100
		SIF ISPENIS()
			LOCAL:153 += C_計算元 * (1 + RAND:3) / 100
		SIF TALENT:母乳体質 > 0
			LOCAL:154 += C_計算元 * (1 + RAND:3) / 100
		SIF TALENT:お漏らし癖 > 0
			LOCAL:155 += C_計算元 * (1 + RAND:3) / 100
	ENDIF
ELSEIF SHOJO == 3 || SHOJO == 4
	;絶頂経験
	SIF (部位 == 7 && ABL:Ｂ感覚 >= 4) || (部位 == 6 && ABL:精液中毒 >= 4) || (部位 == 3 && ABL:Ｃ感覚 >= 3) || (部位 == 2 && ABL:Ｃ感覚 >= 2)
		LOCAL:122 += C_計算元 * (1 + RAND:2) / 100
	IF ABL:Ｖ感覚 >= 4 && ABL:Ａ感覚 >= 4
		LOCAL:122 += C_計算元 * (1 + RAND:2) / 100 + RAND:(1 + (ABL:Ｖ感覚 + ABL:Ａ感覚) / 4)
	ELSEIF ABL:Ｖ感覚 >= ABL:Ａ感覚
		LOCAL:122 += C_計算元 * (1 + RAND:2) / 100 + RAND:(2 + (ABL:Ｖ感覚 + 4) / 4)
	ELSE
		LOCAL:122 += C_計算元 * (1 + RAND:2) / 100 + RAND:(2 + (ABL:Ａ感覚 + 4) / 4)
	ENDIF
	;奉仕快楽経験
	LOCAL:131 += C_計算元 * (2 + RAND:3) / 100
	SIF ISPENIS()
		LOCAL:153 += C_計算元 * (1 + RAND:3) / 100
	SIF TALENT:母乳体質 > 0
		LOCAL:154 += C_計算元 * (1 + RAND:3) / 100
	SIF TALENT:お漏らし癖 > 0
		LOCAL:155 += C_計算元 * (1 + RAND:3) / 100

ELSEIF SHOJO == 5 || SHOJO == 6
	;絶頂経験
	IF SHOJO == 5
		LOCAL:122 += C_計算元 * (1 + RAND:2) / 100 + RAND:(2 + (ABL:Ｖ感覚 + 4) / 4)
	ELSEIF SHOJO == 6
		LOCAL:122 += C_計算元 * (1 + RAND:2) / 100 + RAND:(2 + (ABL:Ａ感覚 + 4) / 4)
	ENDIF
	;奉仕快楽経験
	LOCAL:131 += C_計算元 * (2 + RAND:3) / 100
	SIF ISPENIS()
		LOCAL:153 += C_計算元 * (1 + RAND:3) / 100
	SIF TALENT:母乳体質 > 0
		LOCAL:154 += C_計算元 * (1 + RAND:3) / 100
	SIF TALENT:お漏らし癖 > 0
		LOCAL:155 += C_計算元 * (1 + RAND:3) / 100
ELSE
	IF (部位 == 7 && ABL:Ｂ感覚 >= 4) || (部位 == 6 && ABL:精液中毒 >= 4) || (部位 == 3 && ABL:Ｃ感覚 >= 3) || (部位 == 2 && ABL:Ｃ感覚 >= 2)
		;絶頂経験
		LOCAL:122 += C_計算元 * (1 + RAND:2) / 100 + RAND:4
		;奉仕快楽経験
		LOCAL:131 += C_計算元 * (2 + RAND:3) / 100
		SIF ISPENIS()
			LOCAL:153 += C_計算元 * (1 + RAND:3) / 100
		SIF TALENT:母乳体質 > 0
			LOCAL:154 += C_計算元 * (1 + RAND:3) / 100
		SIF TALENT:お漏らし癖 > 0
			LOCAL:155 += C_計算元 * (1 + RAND:3) / 100
	ENDIF
ENDIF
;フェラ経験------------------------------------------------
;(セックスの分、フェラ回数が減る。フェラ処理以外はさらに減る)
IF 部位 == 6 || SHOJO == 3 || SHOJO == 4
	LOCAL:124 = MAX(S_回数 - (LOCAL:120 + LOCAL:121), 0)
ELSEIF 部位 == 1 || 部位 == 7 || SHOJO == 5 || SHOJO == 6
	LOCAL:124 = MAX(S_回数 - (LOCAL:120 + LOCAL:121 + RAND:3), 0)
ELSE
	LOCAL:124 = MAX(S_回数 - (LOCAL:120 + LOCAL:121 + 4 + RAND:6), 0)
