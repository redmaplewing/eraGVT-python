@BATTLE_EVENT_CLOTH_STATUS_6xxx(mode,parts)
;(任意)イベント戦闘で使用する専用装備のデータ
;　　　・既存の装備では表現できないイベント
;　　　・正式な装備として実装しにくい服装(いかにもペナルティ戦闘っぽい衣装とか)
;　　　で用いる。キーワードについては衣装フォルダのデータベースを参照
	#dims mode,1
	#dims parts,1
	RESULTS'=""
	;設定するのはイベント内で設定する部位だけでいい
	;オプションは現在フレーバーテキスト
	;(ステータス直接設定orイベント側状態異常orシチュエーションタグorターン終了時イベントで調整する方が早い)
	IF parts=="OUTER"
	;	IF mode=="info"
	;		CSTR:TARGET:82'="触手カルト教団の儀装束"
	;		SAVESTR:0'="SLOT-1,HP15,SEITAISEI95,"
	;	ELSEIF mode=="option"
	;		RESULTS'="[過剰な露出]"
	;	ENDIF
	ELSEIF parts=="OUTER_TRANS"
	;	IF mode=="info"
	;		CSTR:TARGET:82'="触手カルト教団の儀装束"
	;		SAVESTR:0'="SLOT-1,HP15,SEITAISEI95,"
	;	ELSEIF mode=="option"
	;		RESULTS'="[過剰な露出]"
	;	ENDIF
	ELSEIF parts=="INNER"
		IF mode=="info"
			CSTR:TARGET:82'="触手カルト教団のマイクロビキニ"
			SAVESTR:0'="SLOT-1,HP25,SEITAISEI45,"
		ELSEIF mode=="option"
			RESULTS'="[媚毒ピアス][過剰な露出]"
		ENDIF
	ENDIF


@EVENT_BATTLE_EXEC_6xxx(補足)
;イベント処理
;・自由行動から派生するクズ市民戦
;　　イベント呼び出し側で一通りテキストを用意している可能性が高い
;　　⇒ここではタグなどのみ設定する
;・情報収集から派生するクズ市民戦
;　　ここにテキスト含めてイベントを書く(パッケージングする)のが良さそう

;イベント呼び出し側で渡せる補足(任意)
#dims 補足,1

	;;現在の変身状態に対応するアウターを「イベント専用装備」に一時設定する
	;CALL EVENT_BATTLE_SET_COSTUME(TARGET,(CFLAG:TARGET:1==0 ? 990 # -1),(CFLAG:TARGET:1>0 ? 991 # -1),-1,-1)

	;アウターを一時的に没収、インナーを「イベント専用装備」に一時設定する
	CALL EVENT_BATTLE_SET_COSTUME(TARGET,(CFLAG:TARGET:1==0 ? 0 # -1),(CFLAG:TARGET:1>0 ? 0 # -1),992,-1)

	;;現在の変身状態に対応するアウターを「ステージ衣装」に一時設定する
	;CALL EVENT_BATTLE_SET_COSTUME(TARGET,(CFLAG:TARGET:1==0 ? 105 # -1),(CFLAG:TARGET:1>0 ? 105 # -1),-1,-1)


	;PRINTL
	;SETCOLORBYNAME HOTPINK
	;PRINTFORML （！！）
	;RESETCOLOR
	;PRINTW 
	DRAWLINE

	;強制発情
	CALL STATE_CHANGE_HATUJOU(100)

	ターン上限=15
	CALL ADDBATTLESITUATION("先制無し,支援無効,レイプなし,")


@EVENT_BATTLE_TURNEND_6xxx
	;各ターン終了時に発生するイベント
	;TFLAG:0が現在ターン、TCVARn:13が終了ターン

@EVENT_BATTLE_MISSION_CHECKER_6xxx
	;追加ミッションの達成判定(1で達成、0で失敗)
	;負けていなければミッション達成
	IF TFLAG:98 == 2
		RETURN 0
	ELSE
		RETURN 1
	ENDIF

