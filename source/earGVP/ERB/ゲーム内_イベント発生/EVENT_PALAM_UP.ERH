;==============================================================================
;非戦闘イベント時のパラメータ上昇処理の条件判定定数定義ファイル
;しきい値は必ず昇順に値を埋めること
;==============================================================================
;----------------------------------------------------------
;MARK（刻印）の上昇しきい値定義（イベント板）
;上昇判定	: UP >= 刻印判定基礎値 + MARK:対象刻印防止 * 刻印防止係数
;			  かつ、2以上へ上昇する場合は1低い刻印を得ていること（飛び級上昇はしない）
;			  かつ、快楽刻印以外が2以上へ上昇する場合は幽閉日数が一定以上であること
;配列の値は順に、0→1へ上昇する条件,1→2へ上昇する条件,...
;本当は#DIM CONSTにしたいが、定数は#DIM REFで参照できないためCONSTなしの変数になっている
;----------------------------------------------------------
;快楽刻印
{
#DIM 快楽刻印判定基礎値_非戦闘 =
600,
1800,
6000,
18000,
60000
}
{
#DIM 快楽刻印防止係数_非戦闘 =
60,
180,
600,
1800,
6000
}
;苦痛刻印
{
#DIM 苦痛刻印判定基礎値_非戦闘 =
500,
1500,
5000,
15000,
50000
}
{
#DIM 苦痛刻印防止係数_非戦闘 =
50,
150,
500,
1500,
5000
}
;屈服刻印
{
#DIM 屈服刻印判定基礎値_非戦闘 =
400,
1200,
4000,
12000,
40000
}
{
#DIM 屈服刻印防止係数_非戦闘 =
40,
120,
400,
1200,
4000
}
;恐怖刻印
{
#DIM 恐怖刻印判定基礎値_非戦闘 =
400,
1200,
4000,
12000,
40000
}
{
#DIM 恐怖刻印防止係数_非戦闘 =
40,
120,
400,
1200,
4000
}
;恥辱刻印
{
#DIM 恥辱刻印判定基礎値_非戦闘 =
400,
1200,
4000,
12000,
40000
}
{
#DIM 恥辱刻印防止係数_非戦闘 =
40,
120,
400,
1200,
4000
}
;幽閉日数しきい値
{
#DIM 幽閉日数しきい値 = 
0,
6,
12,
18,
24
}
