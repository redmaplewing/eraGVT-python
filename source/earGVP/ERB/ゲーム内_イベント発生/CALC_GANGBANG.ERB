;-----------------------------------------------
;●クズ市民レイプイベントによるパラメータ変動の共通処理
@CALC_GANGBANG(シチュエーション,竿の数,NAKADASHI)
#DIM CCOUNT

;"ナンパ" "戦闘後" "脅迫" "監禁"
#DIMS シチュエーション,1
;輪姦経験の増加に影響
#DIM 竿の数,1

;0…中出ししない　1…中出ししようとする(ピル使用可能)　2…中出ししようとする(ピル使用不可能)
;	※クズ市民によるレイプなので、Vに挿入したなら必ず中出しまで行く
#DIM NAKADASHI,1

	;V挿入ブロッカー
	NAKADASHI=(ISMALE() || CHECK_HOLYVIRGIN_F()==1) ? 0 # NAKADASHI



IF NAKADASHI
	IF ABL:Ｖ感覚 == 0
		LOCAL:11 = 10
	ELSEIF ABL:Ｖ感覚 == 1
		LOCAL:11 = 20
	ELSEIF ABL:Ｖ感覚 == 2
		LOCAL:11 = 40
	ELSEIF ABL:Ｖ感覚 == 3
		LOCAL:11 = 100
	ELSEIF ABL:Ｖ感覚 == 4
		LOCAL:11 = 200
	ELSE
		LOCAL:11 = 400
	ENDIF

	;Ｖ経験
	LOCAL:120 = 10 + RAND:30

	IF TALENT:処女 == 1
		TALENT:処女 = -1
		CFLAG:206 = 11
		;恐怖補正
		LOCAL:20 = 500
	ELSE
		;快V補正
		LOCAL:11 *= 3
	ENDIF

	;膣穴が狭すぎた場合は拡張度追加
	IF CFLAG:35 <= 40
		CFLAG:35 += 10
		LOCAL:151 = 2
	ENDIF

ENDIF


IF ABL:Ａ感覚 == 0
	LOCAL:12 = 6
ELSEIF ABL:Ａ感覚 == 1
	LOCAL:12 = 50
ELSEIF ABL:Ａ感覚 == 2
	LOCAL:12 = 200
ELSEIF ABL:Ａ感覚 == 3
	LOCAL:12 = 600
ELSEIF ABL:Ａ感覚 == 4
	LOCAL:12 = 900
ELSE
	LOCAL:12 = 1200
ENDIF
;Ａ経験
LOCAL:121 = 40 - LOCAL:120 + RAND:5 - RAND:5
SIF ISMALE()
	TIMES LOCAL:121 , 1.50
;尻穴が狭すぎた場合は拡張度追加
IF CFLAG:36 <= 40
	CFLAG:36 += 10
	LOCAL:152 = 2
ENDIF

;精液経験
LOCAL:123 = 15 + RAND:16
;フェラ経験
LOCAL:124 = 12 + RAND:5

;習得、屈服、恐怖
LOCAL:16 = 100
LOCAL:18 = 500
LOCAL:21 = 500


IF シチュエーション=="監禁" || シチュエーション=="生オナホ"
	;誘拐監禁カウント＋
	CFLAG:70 += 1
	;誘拐監禁経験＋
	LOCAL:142 = 1
ELSEIF シチュエーション=="ナンパ"
	;ナンパレイプ回数＋
	IF CFLAG:1 > 1 && TALENT:変身時ＴＳ > 0
		CFLAG:321 += 1
	ELSE
		CFLAG:320 += 1
	ENDIF
ELSE
	;クズ市民レイプ回数＋
	CFLAG:286 += 1
ENDIF



;オトコか異常経験が３つ以下なら異常経験＋
SIF ISMALE() || EXP:異常経験 < 3
	LOCAL:150 = 1


;苦痛快楽経験＋
LOCAL:132 = 2 + RAND:3
;輪姦経験＋
SIF 竿の数>1
	LOCAL:113 = 1



;幽閉中パラメータ変動共通処理へ
CALL COMMON_PRISON, LOCAL:10, LOCAL:11, LOCAL:12, LOCAL:13, LOCAL:14, LOCAL:15, LOCAL:16, LOCAL:17, LOCAL:18, LOCAL:19, LOCAL:20, LOCAL:21, 1
;経験数の増加処理
FOR CCOUNT, 100, 200
	CALL COMMON_PRISON_EXP, CCOUNT, LOCAL:CCOUNT
NEXT
PRINTL 
;珠の取得へ
CALL _ABLUP, 1


;1ならピル可能、2は使わせてもらえないor犯された自覚がなく使えないシチュエーション
IF NAKADASHI > 0 && TALENT:処女 < 1
	;アフターピル
	SIF NAKADASHI==1 && シチュエーション != "生オナホ"
		CALL AFTER_PILL, TARGET, 20, 望まない相手
	;妊娠判定
	SIF シチュエーション != "生オナホ"
		CALL NINSIN_HANTEI, LOCAL:123, 100, 望まない相手
ENDIF


IF シチュエーション=="脅迫"
	IF TALENT:淫乱 ||  ABL:欲望 >= 3 || ABL:マゾっ気 >= 3
		CFLAG:99 = 10
		BASE:体力 = (BASE:体力*20)/100
		BASE:気力 = (BASE:気力*20)/100
		BASE:性耐性 = 0
	ELSE
		;２ターン強制休憩フラグ　★重くない？
		CFLAG:15 = 3
		BASE:体力 = 0
		BASE:気力 = 0
		BASE:性耐性 = 0
		CFLAG:99 = 50
	ENDIF
ENDIF

;悪い噂
SIF RAND:100 < 30
	CFLAG:825 += 1

PRINTFORML 
PRINTFORML 