;淫○系の素質があればそれを優先
IF TALENT:ARG:淫壷 > 0 && LOCAL:2 > 5 && CHECK_HOLYVIRGIN_F()==0
	CALL SEX_V, ARG, 0
	SEX_TWICE += 1
ELSEIF TALENT:ARG:淫尻 > 0
	CALL SEX_A, ARG
ENDIF

;追加で自慰が発生した場合に備えて二度目のリセット
VARSET NOWEX

;A感覚が2以上ならアナルセックスできる
SIF ABL:ARG:Ａ感覚 > 1
	LOCAL:0 = 1

IF LOCAL:0 == 0
	IF SEX_TWICE == 1
		CALL SEX_V, ARG, 1
	ELSE
		CALL SEX_V, ARG, 0
	ENDIF
ELSEIF LOCAL:0 == 1
	SIF ISFEMALE(ARG) && CHECK_HOLYVIRGIN_F()==0
		LOCAL:1 = RAND:100
	IF LOCAL:1 >= 50
		IF SEX_TWICE == 1
			CALL SEX_V, ARG, 1
		ELSE
			CALL SEX_V, ARG, 0
		ENDIF
	ELSE
		CALL SEX_A, ARG
	ENDIF
ENDIF
RETURN 1

