;触手夜這い対象者がいるかチェック
@CHECK_SYNBIOSIS_YOBAI_TARGET

#DIM CCOUNT
#DIM FIND

;キャラが一人しかいない場合は判定しない
SIF CHARANUM_ACTIVE() < 2
	RETURN -999

FIND = 0
;夜這い対象者が存在するか
FOR CCOUNT, 0, CHARANUM
	SIF CCOUNT == MASTER
		CONTINUE
	;実行者は除外
	SIF CCOUNT == FLAG:799
		CONTINUE
	;パーティに参加していないキャラは除外
	SIF CFLAG:CCOUNT:999 == 0
		CONTINUE

	;反応できない状態は除外
	SIF TALENT:CCOUNT:繁殖袋 > 0 || TALENT:CCOUNT:四肢欠損 > 0
		CONTINUE

	;実行者の性別は考慮しない
	
	;性別嗜好による選別
	SIF (TALENT:(FLAG:799):男性苦手 > 0 && TALENT:(FLAG:799):両刀 == 0) && ISMALE(CCOUNT)
		CONTINUE
	SIF (TALENT:(FLAG:799):女性苦手 > 0 && TALENT:(FLAG:799):両刀 == 0) && ISFEMALE(CCOUNT)
		CONTINUE
	
	;一人でも対象者がいればチェックを終える
	FIND++
	BREAK
NEXT

SIF FIND > 0
	RETURN 0

;見つからなかった場合
RETURN -999


;---------------------------------------------------------------------
;触手夜這い時のキャラリスト印刷
;TARGET_COUNT:TARGET_LISTの配列数
;TARGET_LIST :夜這い対象のリスト(キャラ番号)
@PRINT_CHARA_LIST(TARGET_COUNT, TARGET_LIST)

#DIM TARGET_COUNT
#DIM REF TARGET_LIST

#DIM LINDEX
#DIM FIND
#DIM REL


;デバッグ
IF FLAG:999 == 1
	SETCOLOR 105,105,105
	PRINTFORML - PRINT_CHARA_LIST - TARGETCOUNT:{TARGET_COUNT}
	
	FOR LINDEX, 0, TARGET_COUNT
		PRINTFORML 対象　%CALLNAME:(TARGET_LIST:LINDEX)%, キャラ番号:{TARGET_LIST:LINDEX}
	NEXT
	
	RESETCOLOR
ENDIF

FOR LINDEX, 0, TARGET_COUNT
	REL = RELATION:(FLAG:799):(TARGET_LIST:LINDEX)

	LOCALS =

	IF !(GETBIT(REL, 親子) || GETBIT(REL, 兄弟姉妹) || GETBIT(REL, 祖父祖母孫) || GETBIT(REL, おじおば) || GETBIT(REL, 甥姪) || GETBIT(REL, いとこ) || GETBIT(REL, 友人) || GETBIT(REL, 片思い) || GETBIT(REL, 恋人) || GETBIT(REL, 婚約者) || GETBIT(REL, 配偶者) || GETBIT(REL, 主人) || GETBIT(REL, 従者) || GETBIT(REL, 奴隷))
		IF GETBIT(REL, 疎遠な) && GETBIT(REL, 親しい)
			LOCALS += "微妙な距離感の知人"
		ELSEIF GETBIT(REL, 親しい)
			LOCALS += "親しい間柄"
		ELSEIF GETBIT(REL, 疎遠な)
			LOCALS += "顔見知り"
		ELSEIF GETBIT(REL, 愛する) && GETBIT(REL, 憎悪する)
			LOCALS += "複雑な関係"
		ELSEIF GETBIT(REL, 愛する)
			LOCALS += "大事な人"
		ELSEIF GETBIT(REL, 憎悪する)
			LOCALS += "仇敵"
		ENDIF
	ELSE
		SIF GETBIT(REL, 生き別れ)
			LOCALS += "生き別れの"
		IF GETBIT(REL, 疎遠な) && GETBIT(REL, 親しい)
			LOCALS += "微妙な距離感の"
		ELSEIF GETBIT(REL, 親しい) && GETBIT(REL, 友人) == 0
			LOCALS += "親しい"
		ELSEIF GETBIT(REL, 疎遠な)
			LOCALS += "疎遠な"
		ENDIF
		IF GETBIT(REL, 愛する) && GETBIT(REL, 憎悪する)
			LOCALS += "愛憎渦巻く"
		ELSEIF GETBIT(REL, 愛する)
			LOCALS += "愛する"
		ELSEIF GETBIT(REL, 憎悪する)
			LOCALS += "憎悪する"
		ENDIF
		IF GETBIT(REL, 親子) || GETBIT(REL, 兄弟姉妹) || GETBIT(REL, 祖父祖母孫) || GETBIT(REL, おじおば) || GETBIT(REL, 甥姪) || GETBIT(REL, いとこ)
			LOCALS += "("
			IF GETBIT(REL, 義理の)
				LOCALS += "義理の"
			ELSE
				LOCALS += "実の"
			ENDIF
		ENDIF
		IF GETBIT(REL, 親子)
			IF TOSHIUE_F(TARGET, (TARGET_LIST:LINDEX)) > 0
				IF ISMALE(TARGET_LIST:LINDEX)
					LOCALS += "息子"
				ELSE
					LOCALS += "娘"
				ENDIF
			ELSE
				IF ISMALE(TARGET_LIST:LINDEX)
					LOCALS += "父親"
				ELSE
					LOCALS += "母親"
				ENDIF
			ENDIF
			SIF GETBIT(REL, 兄弟姉妹) || GETBIT(REL, 祖父祖母孫) || GETBIT(REL, おじおば) || GETBIT(REL, 甥姪) || GETBIT(REL, いとこ)
				LOCALS += "/"
		ENDIF
		IF GETBIT(REL, 兄弟姉妹)
			IF TOSHIUE_F(TARGET, (TARGET_LIST:LINDEX))
				IF ISMALE(TARGET_LIST:LINDEX)
					LOCALS += "弟"
				ELSE
					LOCALS += "妹"
				ENDIF
			ELSE
				IF ISMALE(TARGET_LIST:LINDEX)
					LOCALS += "兄"
				ELSE
					LOCALS += "姉"
				ENDIF
			ENDIF
			SIF GETBIT(REL, 祖父祖母孫) || GETBIT(REL, おじおば) || GETBIT(REL, 甥姪) || GETBIT(REL, いとこ)
				LOCALS += "/"
		ENDIF
		IF GETBIT(REL, 祖父祖母孫)
			IF TOSHIUE_F(TARGET, (TARGET_LIST:LINDEX))
				LOCALS += "孫"
			ELSE
				IF ISMALE(TARGET_LIST:LINDEX)
					LOCALS += "祖父"
				ELSE
					LOCALS += "祖母"
				ENDIF
			ENDIF
			SIF GETBIT(REL, おじおば) || GETBIT(REL, 甥姪) || GETBIT(REL, いとこ)
				LOCALS += "/"
		ENDIF
		IF GETBIT(REL, おじおば)
			IF ISMALE(TARGET_LIST:LINDEX)
				LOCALS += "おじ"
			ELSE
				LOCALS += "おば"
			ENDIF
			SIF GETBIT(REL, いとこ)
				LOCALS += "/"
		ENDIF
		IF GETBIT(REL, 甥姪)
			IF ISMALE(TARGET_LIST:LINDEX)
				LOCALS += "甥"
			ELSE
				LOCALS += "姪"
			ENDIF
			SIF GETBIT(REL, いとこ)
				LOCALS += "/"
		ENDIF
		IF GETBIT(REL, いとこ)
			LOCALS += "いとこ"
		ENDIF
		SIF (GETBIT(REL, 親子) || GETBIT(REL, 兄弟姉妹) || GETBIT(REL, 祖父祖母孫) || GETBIT(REL, おじおば) || GETBIT(REL, 甥姪) || GETBIT(REL, いとこ)) && (GETBIT(REL, 友人) || GETBIT(REL, 片思い) || GETBIT(REL, 恋人) || GETBIT(REL, 婚約者) || GETBIT(REL, 配偶者))
			LOCALS += "かつ"
		IF GETBIT(REL, 友人)
			IF GETBIT(REL, 親しい)
				LOCALS += "親友"
			ELSE
				LOCALS += "友人"
			ENDIF
		ENDIF
		SIF GETBIT(REL, 片思い)
			LOCALS += "片思いの相手"
		SIF GETBIT(REL, 恋人)
			LOCALS += "恋人"
		SIF GETBIT(REL, 婚約者)
			LOCALS += "婚約者"
		IF GETBIT(REL, 配偶者)
			IF ISMALE(TARGET_LIST:LINDEX)
				LOCALS += "夫"
			ELSE
				LOCALS += "妻"
			ENDIF
		ENDIF
		SIF (GETBIT(REL, 親子) || GETBIT(REL, 兄弟姉妹) || GETBIT(REL, 祖父祖母孫) || GETBIT(REL, おじおば) || GETBIT(REL, 甥姪) || GETBIT(REL, いとこ) || GETBIT(REL, 友人) || GETBIT(REL, 片思い) || GETBIT(REL, 恋人) || GETBIT(REL, 婚約者) || GETBIT(REL, 配偶者)) && (GETBIT(REL, 主人) || GETBIT(REL, 従者) || GETBIT(REL, 奴隷))
			LOCALS += "かつ"
		SIF GETBIT(REL, 主人)
			LOCALS += "主人"
		SIF GETBIT(REL, 従者)
			LOCALS += "従者"
		SIF GETBIT(REL, 奴隷)
			LOCALS += "奴隷"
		SIF GETBIT(REL, 親子) || GETBIT(REL, 兄弟姉妹) || GETBIT(REL, 祖父祖母孫) || GETBIT(REL, おじおば) || GETBIT(REL, 甥姪)
			LOCALS += ")"
	ENDIF
	
	;候補を表示
	PRINTFORM [{TARGET_LIST:LINDEX}] 
	IF CHARATALENT_F(TARGET_LIST:LINDEX, 0, "オトコ") > 0
		PRINT (♂)
	ELSEIF CHARATALENT_F(TARGET_LIST:LINDEX, 0, "ふたなり") > 0
		PRINT (双)
	ELSE
		PRINT (♀)
	ENDIF
	PRINTFORM  %CALLNAME:(TARGET_LIST:LINDEX), 24, LEFT%　%LOCALS, 24, LEFT%
	PRINTL 

NEXT
