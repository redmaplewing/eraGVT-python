;---------------------------------------------------------------------
;解放されたキャラの寄生触手が味方を襲う
@PARASITE
#DIM CCOUNT
;寄生×なら判定しない
SIF CONFIG_CHECK_MANIAC_F(3) == 0
	RETURN
FOR CCOUNT, 0, CHARANUM
	FLAG:799 = CCOUNT
	SIF CCOUNT == MASTER
		CONTINUE
	SIF CFLAG:CCOUNT:999 == 0
		CONTINUE

	;寄生されているなら寄生経験が増加
	IF TALENT:(FLAG:799):寄生
		EXP:(FLAG:799):寄生経験 += 1
		
		;寄生されており、共生を得ていないなら寄生触手順応値増加
		SIF TALENT:(FLAG:799):共生 == 0
			CFLAG:(FLAG:799):82 += 1
		
		;寄生触手の暴走判定、軽量化のためなるべく条件を分散して判定
		SIF CFLAG:(FLAG:799):0 != 0
			CONTINUE

		;昼間は暴走しない
		SIF TIME == 0
			CONTINUE
		
		;[共生]取得確認
		IF CFLAG:(FLAG:799):83 > 0
			;一度でも共生取得イベントが発生している場合、次の共生取得イベントまでのスパンを短くする
			LOCAL:3 = 20
		ELSE
			LOCAL:3 = 50
		ENDIF
		IF TALENT:(FLAG:799):共生 == 0 && CFLAG:(FLAG:799):82 >= LOCAL:3 && CFLAG:(FLAG:799):84 == 0
			CALL SYNBIOSIS_GET_EVENT
			
			;共生取得イベントが発生したターンでは暴走・慰み者イベントを発生させない
			CONTINUE
		ENDIF
		
		;確率判定
		LOCAL = MIN(EXP:(FLAG:799):寄生経験 * EXP:(FLAG:799):寄生経験 * 200 / EXP:(FLAG:799):寄生経験, 2500)

		IF RAND:10000 < LOCAL
			
			SIF LOCAL:2 == 0
				DRAWLINE
			LOCAL:2 = 1

			IF TALENT:(FLAG:799):共生 == 1
				;寄生触手の慰み者
				CALL SYNBIOSIS_EVENT
			ELSE
				;寄生触手の暴走
				CALL PARASITE_EVENT
			ENDIF
		ENDIF
		
		;実績
		CALL GET_STATE_EXPUP,TARGET
	ELSE
		CONTINUE
	ENDIF
NEXT

