@MESSAGE_CORRUPT_CHANGE_LOOKS_EYES, ARG
PRINTFORM %PRINT_TRANSCALLNAME(ARG)%の目は
IF TALENT:ARG:変身能力 == 1
	IF CSTR:ARG:34 == CSTR:ARG:35
		CALL SETCOLOR_BY_STR, CSTR:ARG:34
		PRINTFORM %PRINT_EYECOLORNAME(ARG, "右")%の
	ELSE
	;オッドアイ
		CALL SETCOLOR_BY_STR, CSTR:ARG:34
		PRINTFORM %PRINT_EYECOLORNAME(ARG, "右")%
		RESETCOLOR
		PRINTFORM と
		CALL SETCOLOR_BY_STR, CSTR:ARG:35
		PRINTFORM %PRINT_EYECOLORNAME(ARG, "左")%
		RESETCOLOR
		PRINTFORM のオッドアイの
	ENDIF
ELSE
	IF CSTR:ARG:32 == CSTR:ARG:33
		CALL SETCOLOR_BY_STR, CSTR:ARG:32
		PRINTFORM %PRINT_EYECOLORNAME(ARG, "右")%の
	ELSE
	;オッドアイ
		CALL SETCOLOR_BY_STR, CSTR:ARG:32
		PRINTFORM %PRINT_EYECOLORNAME(ARG, "右")%
		RESETCOLOR
		PRINTFORM と
		CALL SETCOLOR_BY_STR, CSTR:ARG:33
		PRINTFORM %PRINT_EYECOLORNAME(ARG, "左")%
		RESETCOLOR
		PRINTFORM のオッドアイの
	ENDIF
ENDIF
PRINTFORM %CSTR:ARG:18%
RESETCOLOR
PRINTFORML に変わった。
PRINTFORML


