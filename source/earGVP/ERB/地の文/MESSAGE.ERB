;--------------------------------------------------
;気絶時の形容を返す式中関数
@PRINT_SWOON
#FUNCTIONS
VARSET LOCALS
IF (TCVARn:12 & 気絶)
	IF TALENT:主観視点 > 0
		SELECTCASE RAND:10
			CASE 9
				LOCALS = 気を失いかけている
			CASE 8
				LOCALS = 寝そべっている
			CASE 7
				LOCALS = 伏せっている
			CASE 6
				LOCALS = 倒れている
			CASE 5
				LOCALS = 気絶しかけている
			CASE 4
				LOCALS = 気を失いかけた
			CASE 3
				LOCALS = 寝そべった
			CASE 2
				LOCALS = 地に伏せた
			CASE 1
				LOCALS = 倒れ込んだ
			CASE 0
				LOCALS = 朦朧とした意識の
		ENDSELECT
	ELSE
		SELECTCASE RAND:10
			CASE 9
				LOCALS = 気を失っている
			CASE 8
				LOCALS = 寝そべっている
			CASE 7
				LOCALS = 伏せっている
			CASE 6
				LOCALS = 倒れている
			CASE 5
				LOCALS = 気絶している
			CASE 4
				LOCALS = 気を失った
			CASE 3
				LOCALS = 寝そべった
			CASE 2
				LOCALS = 地に伏せた
			CASE 1
				LOCALS = 倒れ込んだ
			CASE 0
				LOCALS = 気絶した
		ENDSELECT
	ENDIF
ENDIF
RETURNF LOCALS




;--------------------------------------------------
;キャラクターの外見を加味した年齢帯を返す式中関数
@GET_AGEBAND(ARG)
#FUNCTIONS
#DIM AGE

;プロフィール未設定のキャラは年齢帯なし
LOCALS = なし
SIF CFLAG:ARG:34 == 0
	RETURNF LOCALS

IF CFLAG:ARG:1 > 0
	AGE = MAXBASE:ARG:年齢
ELSE
	AGE = BASE:ARG:年齢
ENDIF

IF AGE < 10
	LOCALS = 幼い
ELSEIF AGE < 16
	LOCALS = 子供
ELSEIF AGE < 25
	LOCALS = 若い
ELSE
	LOCALS = 大人
ENDIF

RETURNF LOCALS




