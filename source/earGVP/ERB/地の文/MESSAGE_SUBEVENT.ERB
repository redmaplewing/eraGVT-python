;----------------------------------------------------------
;触手拘束具を着せられた
@MESSAGE_SUBEVENT_BATTLE_SETTENTACLECLOTH
PRINTL あられもない
IF (CFLAG:1 == 0 && TCVARn:21 <= 0 && TCVARn:25 <= 0) || (CFLAG:1 > 0 && TCVARn:23 <= 0 && TCVARn:25 <= 0)
	PRINT 全裸
ELSE
	PRINT 半裸
ENDIF
PRINTFORML の姿で息を切らす%PRINT_TRANSCALLNAME(TARGET)%・・・
PRINTFORML 撤退の動きをみせた%STR:2500%に気を抜いてしまった次の瞬間！
PRINTFORML %STR:2500%が突如体液の塊を飛ばしてきた！
PRINTFORML 驚いた%PRINT_TRANSCALLNAME(TARGET)%はそれを回避できずに直撃してしまう
PRINTFORMW 
PRINTFORML 粘り気のある体液が肌を舐める感触に顔を歪める%PRINT_TRANSCALLNAME(TARGET)%・・・
IF ISMALE()
	;#region
	PRINTFORML 体液はまるで意志を持つかのように流れ、%PRINT_TRANSCALLNAME(TARGET)%の乳首や股間に集中する
	;#endregion
ELSE 
	PRINTFORML 体液はまるで意志を持つかのように流れ、%PRINT_TRANSCALLNAME(TARGET)%の胸や秘部に集中する
ENDIF
PRINTFORML ざわざわとした感触に%PRINT_TRANSCALLNAME(TARGET)%は思わず喘ぎ声をあげた
PRINTFORMW 
PRINTFORML やがて醜い色に変色した体液はそのまま触手化し、
PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%を常に弄ぶ拘束具へと変貌を遂げたのだった・・・
PRINTL 
;口上
TRYCALLFORM KOJO_ROOT(CFLAG:6, "SUBEVENT_BATTLE_SETTENTACLECLOTH")


;----------------------------------------------------------
;触手拘束具による被姦
@MESSAGE_SUBEVENT_BATTLE_ACTTENTACLECLOTH
FONTBOLD
PRINTFORML %ITEMNAME:400%（愛撫）
FONTREGULAR
PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%は%ITEMNAME:400%から与えられる刺激に身を悶えさせている・・・
PRINTL 
;口上
TRYCALLFORM KOJO_ROOT(CFLAG:6, "SUBEVENT_BATTLE_ACTTENTACLECLOTH")
PRINTW 

;----------------------------------------------------------
;触手服による被姦
@MESSAGE_SUBEVENT_BATTLE_ACTTENTACLESUIT
;テンタクルスーツの名前をLOCALSに代入
IF CFLAG:1 == 0 && CSTR:8 != ""
	LOCALS = %CSTR:8%
ELSEIF CSTR:9 != ""
	LOCALS = %CSTR:9%
ELSE
	LOCALS = %ITEMNAME:199%
ENDIF

FONTBOLD
PRINTFORM %LOCALS%
IF TCVARn:0 == 0
	;PRINT （Ｍ字開脚）
	PRINT （拘束）
ELSEIF TCVARn:41 <= 0
	PRINT （愛撫）
ELSEIF TCVARn:41 >= 1
	PRINT （種付け）
ENDIF
PRINTL 
FONTREGULAR
PRINTFORML %LOCALS%はエネルギー供給を断たれて暴走している！
PRINTW 
IF TCVARn:0 == 0
	PRINTFORML %LOCALS%はまるで相手の凌辱を手助けするかのように
	;PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%の身動きを封じつつ、無理やりＭ字に開脚させた・・・
	IF FIGURE_SPLIT(EQUIP:(CFLAG:1==0 ? 99 # 199), 1) == 0
		PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%の身動きを封じ、抵抗できないようにした・・・
	ELSE
		PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%の身動きを封じつつ、股間部分が露出するように形状を変化させている・・・
	ENDIF
	SELECTCASE TCVARn:2
		CASE 体勢：何もしない,体勢：通常,体勢：なすがまま,体勢：受け入れる
		CASEELSE
			PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%は態勢を崩された！
	ENDSELECT
ELSEIF TCVARn:41 == -1
	PRINTFORML %LOCALS%は再び%PRINT_TRANSCALLNAME(TARGET)%の全身に触手を絡みつかせ、
	PRINTFORML 凌辱を再開した・・・
ELSEIF TCVARn:41 == 0 || ISMALE()
	PRINTFORML 制御を失った%LOCALS%は正体を現し、
	PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%の全身に触手を絡みつかせながら強引に愛撫している。
	SIF ISFEMALE()
		PRINTFORML 激しい責めに股間からはくちゅくちゅと水音がし始めている・・・
ELSEIF TCVARn:41 == 1
	IF CHECK_HOLYVIRGIN_F()==0
		PRINTFORML %LOCALS%はアソコが十分に濡れてきたことを確かめると、
		IF FIGURE_SPLIT(EQUIP:(CFLAG:1==0 ? 99 # 199), 1) == 0
			PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%のヴァギナとアナルに触手の先端をあてがい、
		ELSE
			PRINTL 股間部分の形状を変化させ一際大きな触手を形作った。
			PRINTFORML そしてその先端を%PRINT_TRANSCALLNAME(TARGET)%のヴァギナとアナルにあてがい、
		ENDIF
		PRINTFORML そのまま蛇行させながら膣内に挿入してピストンし始めた・・・
		IF TALENT:処女 > 0
			PRINTW 
			PRINTL 処女喪失
			PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%はあっさりと処女を奪われてしまった・・・
		ENDIF
	ELSE
		PRINTFORML %LOCALS%は%PRINT_TRANSCALLNAME(TARGET)%のアナルに潤滑液をたっぷりと塗り込むと、
		SIF FIGURE_SPLIT(EQUIP:(CFLAG:1==0 ? 99 # 199), 1) != 0
			PRINT 股間部分の形状を変化させ形作った一際大きな
		PRINTL 触手の先端をあてがい、
		PRINTFORML そのまま蛇行させながら菊穴に挿入してピストンし始めた・・・
	ENDIF
ELSEIF TCVARn:41 == 2
	IF TALENT:処女 < 1
		PRINTFORML %LOCALS%は触手で%PRINT_TRANSCALLNAME(TARGET)%の全身を愛撫しながら両穴を犯している。
	ELSE
		PRINTFORML %LOCALS%は触手で%PRINT_TRANSCALLNAME(TARGET)%の全身を愛撫しながら菊穴を犯している。
	ENDIF
	PRINTFORML だんだんピストンが加速し、責めが激しくなっているようだ。
	PRINTFORML このままではマズイかもしれない・・・
ELSEIF TCVARn:41 == 3
	IF TALENT:処女 < 1
		PRINTFORML %LOCALS%は%PRINT_TRANSCALLNAME(TARGET)%の両穴を激しく犯しながらも更にピストンを加速させていく。
		PRINTFORML やがて深くまで突き入れられた触手の根元がムクリと膨らみ、
		PRINTFORML 一気に大量の精液が膣内と菊穴の奥へと注ぎ込まれていった・・・
	ELSE
		PRINTFORML %LOCALS%は%PRINT_TRANSCALLNAME(TARGET)%を激しく犯しながらも更にピストンを加速させていく。
		PRINTFORML やがて深くまで突き入れられた触手の根元がムクリと膨らみ、
		PRINTFORML 一気に大量の精液が菊穴の奥へと注ぎ込まれていった・・・
	ENDIF
ELSEIF RAND:3 == 0 && TALENT:処女 < 1
	PRINTFORML %LOCALS%は射精しながら%PRINT_TRANSCALLNAME(TARGET)%を犯し続けている。
	PRINTFORM アナルをずんと突きあげられて海老反りになると、すぐさま前から膣内を抉られ抑えつけられる。
	PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%は股間から精液を噴き出させながら翻弄されるままだ・・・
ELSEIF RAND:2 == 0 && TALENT:処女 < 1
	PRINTFORML %LOCALS%は射精しながら%PRINT_TRANSCALLNAME(TARGET)%を犯し続けている。
	PRINTFORML 小刻みに動く触手に%ESTRUS_TEXT_F(TARGET,"の")%子宮口をコツコツと叩かれ、
	PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%は膣内射精される感触に理性を塗りつぶされていく・・・
ELSE
	IF  TALENT:処女 < 1
		PRINTFORML %LOCALS%の射精は終わらず、%PRINT_TRANSCALLNAME(TARGET)%の両穴に精液を注ぎながらも
	ELSE
		PRINTFORML %LOCALS%の射精は終わらず、%PRINT_TRANSCALLNAME(TARGET)%の菊穴に精液を注ぎながらも
	ENDIF
	PRINTFORML なおも責めを緩めずにピストンを続け、愛撫を止める様子もない。
	PRINTFORML 立っているのもやっとな%PRINT_TRANSCALLNAME(TARGET)%の股間からは絶えず新鮮な白濁液が流れ落ちている・・・
ENDIF
PRINTL 
;口上
TRYCALLFORM KOJO_ROOT(CFLAG:6, "SUBEVENT_BATTLE_ACTTENTACLESUIT")
PRINTW 

