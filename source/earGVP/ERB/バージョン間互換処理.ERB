	ENDIF
	IF LASTLOAD_VERSION < 373
		FOR CCOUNT, 0, CHARANUM
			SIF CCOUNT == MASTER
				CONTINUE
			;ボス触手が父親の場合、ＩＤのズレを修正
			SIF CFLAG:CCOUNT:230 >= 100
				CFLAG:CCOUNT:230 += 1
			SIF CFLAG:CCOUNT:9 >= 100
				CFLAG:CCOUNT:9 += 1
		NEXT
	ENDIF
	IF LASTLOAD_VERSION < 380
		;オミットされたフラグを初期化
		FLAG:19 = 0
		FLAG:851 = 0
		;コンフィグを初期設定に変更
		FLAG:800 = 0
		FLAG:801 = 1
		FLAG:802 = 31
		FLAG:803 = 7
		FLAG:804 = 7
		FOR CCOUNT, 0, CHARANUM
			SIF CCOUNT == MASTER
				CONTINUE
			;刻印防止を初期化
			MARK:CCOUNT:快楽刻印防止 = 0
			MARK:CCOUNT:苦痛刻印防止 = 0
			MARK:CCOUNT:屈服刻印防止 = 0
			MARK:CCOUNT:恐怖刻印防止 = 0
			MARK:CCOUNT:恥辱刻印防止 = 0
		NEXT
	ENDIF
	IF LASTLOAD_VERSION < 381
		FOR CCOUNT, 0, CHARANUM
			SIF CCOUNT == MASTER
				CONTINUE
			;素質基本値を新仕様に合わせて変更
			SIF GETBIT(BASE:CCOUNT:48, 0)
				BASE:CCOUNT:体格基本値 = -1
			SIF GETBIT(BASE:CCOUNT:48, 1)
				BASE:CCOUNT:体格基本値 = 1
			SIF GETBIT(BASE:CCOUNT:48, 2)
				BASE:CCOUNT:胸サイズ基本値 = -1
			SIF GETBIT(BASE:CCOUNT:48, 3)
				BASE:CCOUNT:胸サイズ基本値 = 1
			SIF GETBIT(BASE:CCOUNT:48, 4)
				BASE:CCOUNT:性別基本値 = 1
			;オミットされたBASEを初期化
			BASE:CCOUNT:42 = 0
			MAXBASE:CCOUNT:42 = 0
			BASE:CCOUNT:48 = 0
			MAXBASE:CCOUNT:48 = 0
		NEXT
	ENDIF
	IF LASTLOAD_VERSION < 382
		;相関関係の全探索
		CALL CHECK_ALL_RELATION
	ENDIF
	IF LASTLOAD_VERSION < 394
		;目つきの追加
		FOR CCOUNT, 0, CHARANUM
			SIF CCOUNT == MASTER
				CONTINUE
			SIF CSTR:CCOUNT:18 == ""
				CSTR:CCOUNT:18 = 普通
		NEXT
	ENDIF

	IF LASTLOAD_VERSION < 398
		;パッチ取り込み都合(扱うフラグを変えた)
		FLAG:855=0
		FLAG:856=0
	ENDIF

	IF LASTLOAD_VERSION < 399
		;装備周りの管理変更
		FOR LOCAL,1, CHARANUM
			FOR LOCAL:1,300, 400
				IF EQUIP:LOCAL:(LOCAL:1) == 0 && EQUIP:LOCAL:(LOCAL:1 - 100) > 0
					EQUIP:LOCAL:(LOCAL:1) = EQUIP:LOCAL:(LOCAL:1 - 100)
				ENDIF
				EQUIP:LOCAL:(LOCAL:1 - 100) = 0
			NEXT
		NEXT
	ENDIF

	IF LASTLOAD_VERSION < 400
		;コンフィグ番号の整理(幽閉・悪堕ち関連の新設)
		LOCAL=FLAG:804
		FLAG:804=0
		SETBIT FLAG:804,0,GETBIT(LOCAL,1)
		SETBIT FLAG:804,1,GETBIT(LOCAL,3)
		SETBIT FLAG:804,2,GETBIT(LOCAL,2)
		SETBIT FLAG:804,3,GETBIT(LOCAL,15)
		SETBIT FLAG:804,4,GETBIT(LOCAL,9)
		SETBIT FLAG:804,5,GETBIT(LOCAL,10)
		SETBIT FLAG:804,6,GETBIT(LOCAL,11)
		SETBIT FLAG:804,7,GETBIT(LOCAL,12)
		SETBIT FLAG:804,8,GETBIT(LOCAL,13)
		SETBIT FLAG:804,9,GETBIT(LOCAL,16)
		FLAG:805=0
		SETBIT FLAG:805,0,GETBIT(LOCAL,0)
		SETBIT FLAG:805,1,GETBIT(LOCAL,4)
		SETBIT FLAG:805,2,GETBIT(LOCAL,5)
		SETBIT FLAG:805,3,GETBIT(LOCAL,6)
		SETBIT FLAG:805,4,GETBIT(LOCAL,7)
		SETBIT FLAG:805,5,GETBIT(LOCAL,8)
		SETBIT FLAG:805,6,GETBIT(LOCAL,14)
		SETBIT FLAG:805,7,GETBIT(LOCAL,17)
	ENDIF
	IF LASTLOAD_VERSION < 401
		LOCAL=FLAG:804
		SETBIT FLAG:804,9,GETBIT(LOCAL,10)
		SETBIT FLAG:804,10,GETBIT(LOCAL,9)
	ENDIF
	IF LASTLOAD_VERSION < 402
		;コマンド分離に伴って変身スタイル固定の廃止
		FOR LOCAL,1, CHARANUM
			CFLAG:LOCAL:12=0
		NEXT
	ENDIF

	IF LASTLOAD_VERSION < 405
		IF LASTLOAD_VERSION<=402
			;確実に修正対象(旧仕様で作られたデータで確定)
			LOCAL=1
		ELSEIF FLAG:0==0 || (FLAG:0!=1 && FLAG:0!=2 && FLAG:0!=4 && FLAG:0!=10 && FLAG:0!=16)
			;確実に修正不要(GAMEOVER＝フラグ修正不要　または　新仕様で作られたデータで確定)
			LOCAL=0
		ELSE
			;厄介な事態になってしまったバージョン
			;自動識別の試行
			LOCAL=-1
			;get mode info from last-load text			
			STRFIND LASTLOAD_TEXT,"NORMAL",0
			IF RESULT>-1
				;old data(need to fix) OR new data
				LOCAL=FLAG:0==1 ? 1 # 0
			ENDIF
			STRFIND LASTLOAD_TEXT,"SOLO",0
			IF RESULT>-1
				LOCAL=FLAG:0==2 ? 1 # 0
			ENDIF
			STRFIND LASTLOAD_TEXT,"HARDCORE",0
			IF RESULT>-1
				LOCAL=FLAG:0==4 ? 1 # 0
			ENDIF
			STRFIND LASTLOAD_TEXT,"SURVIVAL",0
			IF RESULT>-1
				LOCAL=FLAG:0==10 ? 1 # 0
			ENDIF
			STRFIND LASTLOAD_TEXT,"FREEPLAY",0
			IF RESULT>-1
				LOCAL=FLAG:0==10 ? 1 # 0
			ENDIF
			STRFIND LASTLOAD_TEXT,"SANDBOX",0
			IF RESULT>-1
				LOCAL=FLAG:0==10 ? 1 # 0
			ENDIF
			STRFIND LASTLOAD_TEXT,"ENDLESS",0
			IF RESULT>-1
				LOCAL=FLAG:0==10 ? 1 # 0
			ENDIF
			STRFIND LASTLOAD_TEXT,"INSTANT",0
			IF RESULT>-1
				LOCAL=FLAG:0==16 ? 1 # 0
			ENDIF

			;セーブデータ文字列による自動識別に失敗した場合(念のため)
			IF LOCAL==-1
				FONTBOLD
				PRINTL カスタムゲームモード導入パッチによるFLAG:0のデータ互換切れ
				SETCOLOR 255,128,128
				PRINTL !　パッチ手動取り込み、または【社会派版2023/08/29】を境として、
				PRINTL !　セーブデータの内部互換性が失われています。
				PRINTFORML !　最終バーションが0.{LASTLOAD_VERSION}のセーブデータには、修復処理が必要かもしれません。
				FONTREGULAR
				RESETCOLOR
				PRINTL 《旧》
				PRINTL 	FLAG:0 = n	※GAMEOVER=0　NORMAL=1　SOLO=2　HARDCORE=4　ENDLESS系=10 INSTANT=16
				PRINTL 《新》
				PRINTL 	FLAG:0 = モードオプション:n
				PRINTFORML 		0 GAMEOVER	{モードオプション:0}
				PRINTFORML 		1 NORMAL	{モードオプション:1}
				PRINTFORML 		2 SOLO		{モードオプション:2}
				PRINTFORML 		3 HARDCORE	{モードオプション:3}
				PRINTFORML 		4 SURVIVAL	{モードオプション:4}
				PRINTFORML 		5 FREEPLAY	{モードオプション:5}
				PRINTFORML 		6 SANDBOX	{モードオプション:6}
				PRINTFORML 		7 INSTANT	{モードオプション:7}
				PRINTL 		(内部ではビット演算、DIM.ERH参照)
				PRINT 現在のFLAG:0値…
				FONTBOLD
				PRINTFORML {FLAG:0}
				FONTREGULAR
				PRINTFORML
				PRINTL
				PRINTL このセーブデータはパッチ導入以前に作成されたものですか？
				PRINTL [0]はい（修正処理適用）
				PRINTL [1]いいえ
				PRINTL [2]分からない、覚えていない
				INPUT
				IF RESULT==0
					LOCAL=1
					PRINTL では、修正処理を適用します。
				ELSE
					LOCAL=0
					PRINTW では、修正処理を適用しません。
				ENDIF
				PRINTL
				PRINTL もしもゲームの挙動がおかしい場合は、手動でデバッグコマンド
				PRINTL 「@FLAG:0=モードオプション:n」
				PRINTL 　　　　　　　　　　　　　※nは対応する番号
				PRINTW を入力・修正してください。
				PRINTL
			ENDIF
		ENDIF

		;修復処理を実行する場合
		IF LOCAL==1
			SELECTCASE FLAG:0
			CASE 0 TO 2
				FLAG:0 = モードオプション:(FLAG:0)
			;HARDCORE
			CASE 4
				FLAG:0 = モードオプション:(3)
			;無ラスボス
			CASE 10
				;エンドレス系モードを細分化していた旧フラグ(:906)で分岐
				;SURVIVE
				IF FLAG:906 ==0
					FLAG:0 = モードオプション:(4)
				;FREEPLAY
				ELSEIF FLAG:906 ==1
					FLAG:0 = モードオプション:(5)
				;SANDBOX
				ELSEIF FLAG:906 ==2
					FLAG:0 = モードオプション:(6)
				ENDIF
			;INSTANT
			CASE 16
				FLAG:0 = モードオプション:(7)
			ENDSELECT
		ENDIF
		;今後はもう使わなくなった
		FLAG:906 = 0
	ENDIF

	IF LASTLOAD_VERSION < 406
		;共通設定仕様変更
		FOR LOCAL,0,9
			IF SAVESTR:14==transnamegenre:LOCAL
				FLAG:820=LOCAL+1
				BREAK	
			ENDIF
		NEXT
		SAVESTR:14'=""
		;ラスボス触手の数は出現時まで0のままに
		SIF FLAG:100 > 0
			FLAG:101 = 0
	ENDIF

	IF LASTLOAD_VERSION < 408
		;ランダム名に韓国語を追加した分のフラグズレ
		SIF FLAG:822 == 8
			FLAG:822++
	ENDIF


	IF LASTLOAD_VERSION < GAMEBASE_VERSION
		PRINTL 【セーブデータを最新バージョンにアップデートしました】
		LOCALS:0 = {1000 + LASTLOAD_VERSION}
		SUBSTRING LOCALS:0, 1, 3
		LOCALS:0 = {LASTLOAD_VERSION / 1000}.%RESULTS%
		LOCALS:1 = {1000 + GAMEBASE_VERSION}
		SUBSTRING LOCALS:1, 1, 3
		LOCALS:1 = {GAMEBASE_VERSION / 1000}.%RESULTS%
		PRINTFORMW 　ver %LOCALS:0% → %LOCALS:1%
		;０除算バグ用
		SIF LASTLOAD_VERSION < 190
			CALL ENDING
	ENDIF

ENDIF



PRINTL 
