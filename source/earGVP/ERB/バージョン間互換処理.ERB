	IF LASTLOAD_VERSION < 372
		FOR CCOUNT, 0, CHARANUM
			SIF CCOUNT == MASTER
				CONTINUE
			SIF NAME:CCOUNT == "博麗 霊夢" || NAME:CCOUNT == "霧雨 魔理沙" || NAME:CCOUNT == "東風谷 早苗"
