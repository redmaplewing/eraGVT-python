			SIF NAME:CCOUNT == "守崎 美紅" || NAME:CCOUNT == "ソフィー・アンドレア・雪籐" || NAME:CCOUNT == "菱堂 藍胡" || NAME:CCOUNT == "桜坂 ひかり" || NAME:CCOUNT == "茜島 蘭牙"
