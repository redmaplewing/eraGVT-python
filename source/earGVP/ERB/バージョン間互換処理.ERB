			ELSEIF CFLAG:CCOUNT:230 <= -100
				CFLAG:CCOUNT:230 = LOCAL:230 - 99
			ENDIF

			CALL SET_PARTYMEMBER
		NEXT
	ENDIF
	IF LASTLOAD_VERSION < 370
		;制限日数を再計算
		IF FLAG:0 == 4
			FLAG:2 = 13
		ELSEIF FLAG:0 == 2
			FLAG:2 = 12
		ELSEIF FLAG:0 == 10
			FLAG:2 = 9
		;インスタントモード用のものです
		ELSEIF FLAG:0 == 16
			FLAG:2 = 11
