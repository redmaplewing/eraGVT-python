			SIF FLAG:0 != 10
				FLAG:1 = (FLAG:3 * FLAG:2) + (FLAG:4 * 10)
		ENDIF
		;フラグの更新
		FLAG:804 = 0
		CALL RESEARCH_QUOTA
		;性耐性の調整を入れたのでステータスを再計算
		FOR CCOUNT, 0, CHARANUM
			SIF CCOUNT == MASTER
				CONTINUE
			CALL LEVELSTATUS, CCOUNT
