;----------------------------------------------------------
;素質の値範囲定義
;特定の素質をセットで扱う場合に、そのIDを数値配列定数にする
;----------------------------------------------------------
{
#DIM CONST 淫部位素質 =
GETNUM(TALENT,"淫核"),
GETNUM(TALENT,"淫壷"),
GETNUM(TALENT,"淫尻"),
GETNUM(TALENT,"淫乳")
}
{
#DIM CONST 部位結界素質 =
GETNUM(TALENT, "Ｃ結界"),
GETNUM(TALENT, "Ｖ結界"),
GETNUM(TALENT, "Ａ結界"),
GETNUM(TALENT, "Ｂ結界")
}
