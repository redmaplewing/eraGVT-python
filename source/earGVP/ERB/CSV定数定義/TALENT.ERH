#DIM CONST 素質未熟_未熟 = 1
#DIM CONST 素質未熟_不妊 = 2
#DIM CONST 素質未熟_初潮発生済 = -1

#DIM CONST 素質貧乳_貧乳 = 1
#DIM CONST 素質貧乳_絶壁 = 2
{
#DIMS CONST 素質貧乳=
