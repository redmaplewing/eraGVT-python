;==============================================================================
;CFLAG（キャラクター別フラグ）の定数定義ファイル
;==============================================================================
;----------------------------------------------------------
;値が1以外を取る場合の値名定数定義
;必ず　キャラ[フラグ名]_[名称]　の命名形式で定義すること
;また、値名の出力が考えられる場合は値名の#DIMSも定義する
;その場合、0に値名がないなら最初の要素は空にすること
;0始まりでも1始まりでもない（愚かしい）値域の値もあるので、その場合は_値始まりという定義を追加する
;----------------------------------------------------------
;キャラ状態（DIM.ERHより移植）
;memo:命名規則的にキャラ状態_〇〇とすべきだが、統一作業は優先度極低
#DIM CONST 状態_救出直後 = -1
#DIM CONST 状態_無事 = 0
#DIM CONST 状態_幽閉 = 1
#DIM CONST 状態_洗脳 = 2
#DIM CONST 状態_悪堕ち = 3
#DIM CONST 状態_クズ監禁 = 4
#DIM CONST 状態_死亡 = 9
#DIM CONST 状態_出産直前 = 10
#DIM CONST 状態_育児中 = 11
#DIM CONST 状態_引継ぎフラグ = 999

;キャラ一人称（DIM.ERHより移植）
;memo:命名規則的にキャラ一人称_〇〇とすべきだが、統一作業は優先度極低
#DIM CONST 一人称_最大 = 20

;キャラ行動予定（DIM.ERHより移植）
;memo:命名規則的にキャラ行動予定_〇〇とすべきだが、統一作業は優先度極低
#DIM CONST 予定_無し = 0
#DIM CONST 予定_出撃 = 101
#DIM CONST 予定_鍛錬 = 102
#DIM CONST 予定_休憩 = 103
#DIM CONST 予定_活動 = 104
#DIM CONST 予定_防衛 = 105
#DIM CONST 予定_支援 = 106
#DIM CONST 予定_情報 = 107
#DIM CONST 予定_自由 = 108
{
#DIM CONST キャラ行動予定 =
予定_無し,
予定_出撃,
予定_鍛錬,
予定_休憩,
予定_活動,
予定_防衛,
予定_支援,
予定_情報,
予定_自由
}
{
#DIMS CONST キャラ行動予定名称 =
"",
"出撃",
"鍛錬",
"休憩",
"特別活動",
"拠点防衛",
"戦闘支援",
"情報収集",
"自由行動"
}
{
#DIMS CONST キャラ行動予定短縮名 =
"",
"出撃",
"鍛錬",
"休憩",
"活動",
"防衛",
"支援",
"情報",
"自由"
}

;キャラ口上
#DIM CONST キャラ口上_非表示 = -2
#DIM CONST キャラ口上_未教育 = -1
#DIM CONST キャラ口上_女性汎用 = 0
#DIM CONST キャラ口上_オトコ汎用 = 1
#DIM CONST キャラ口上_ロボ風 = 2
#DIM CONST キャラ口上_あなた = 3
#DIM CONST キャラ口上_汎用豹変 = 4

#DIM CONST キャラ口上_値始まり = -2
{
#DIMS CONST キャラ口上 =
"非表示",
"未教育",
"女性汎用",
"オトコ汎用",
"ロボ風",
"あなた",
"汎用豹変"
}


