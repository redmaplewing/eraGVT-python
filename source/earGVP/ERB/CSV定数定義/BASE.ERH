;==============================================================================
;BASE（基礎能力値）の定数定義ファイル
;==============================================================================
;----------------------------------------------------------
;基礎能力値の値範囲定義
;特定の基礎能力値をセットで扱う場合に、そのIDを数値配列定数にする
;----------------------------------------------------------
{
#DIM CONST 基礎部位結界 =
GETNUM(BASE, "Ｃ結界耐久力"),
GETNUM(BASE, "Ｖ結界耐久力"),
GETNUM(BASE, "Ａ結界耐久力"),
GETNUM(BASE, "Ｂ結界耐久力")
}
{
#DIM CONST 基礎能力基礎値 =
GETNUM(BASE, "体力基礎"),
GETNUM(BASE, "気力基礎"),
GETNUM(BASE, "性耐性基礎")
}
