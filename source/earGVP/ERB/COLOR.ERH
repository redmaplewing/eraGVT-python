;==============================================================================
;色定数定義ファイル
;SET(BG)COLOR int の指定値を想定するため、0xRRGGBB形式の16進数記法で
;==============================================================================
#DIM CONST 文字色無効 = 0x696969	;105, 105, 105
#DIM CONST 文字色薄赤 = 0xFFAAAA	;255, 170, 170
#DIM CONST 文字色薄緑 = 0xAAFFAA	;170, 255, 170
#DIM CONST 文字色薄青 = 0xAAAAFF	;170, 170, 255
#DIM CONST 文字色薄黄 = 0xFFFFAA	;255, 255, 170
#DIM CONST 文字色薄桃 = 0xFFAAFF	;255, 170, 255
#DIM CONST 文字色薄水 = 0xAAFFFF	;170, 255, 255
#DIM CONST 文字色黄色 = 0xFFC832	;255, 200,  50
#DIM CONST 文字色水色 = 0x32C3FF	; 50, 200, 255
#DIM CONST 文字色橙色 = 0xFF8000	;255, 128,   0

#DIM CONST 文字色昼 = 0xE6D200	;230, 210,   0
#DIM CONST 文字色夜 = 0x0082FA	;  0, 130, 250
#DIM CONST 文字色時間帯 = 文字色昼, 文字色夜

#DIM CONST 背景色昼 = 0x0A0A00	; 10,  10,   0
#DIM CONST 背景色夜 = 0x000005	;  0,   0,   5
#DIM CONST 背景色時間帯 = 背景色昼, 背景色夜
