;--------------------------------------------------
;行動が制約にかかっているかどうかを返す関数群で使用する定数定義

#DIM CONST 行動制約_すべて = -1
#DIM CONST 行動制約_体力 = 0
#DIM CONST 行動制約_夜魔 = 1
#DIM CONST 行動制約_戦士 = 2
#DIM CONST 行動制約_支援無効 = 3
#DIM CONST 行動制約_妊娠 = 4
#DIM CONST 行動制約_欠損 = 5
#DIM CONST 行動制約_廃人 = 6

{
#DIM CONST 行動制約 = 
行動制約_体力,
行動制約_夜魔,
行動制約_戦士,
行動制約_支援無効,
行動制約_妊娠,
行動制約_欠損,
行動制約_廃人
}
;体力が一定以下だと出来ない
{
#DIM CONST 体力制約行動 =
予定_出撃,
予定_鍛錬,
予定_活動,
予定_防衛,
予定_支援,
予定_情報
}
;妊娠中（と判明している場合）は出来ない
{
#DIM CONST 妊婦制約行動 =
予定_出撃,
予定_防衛
}
;フィート[夜魔の貴族]があるなら昼間は出来ない
{
#DIM CONST 夜魔制約行動 =
予定_出撃,
予定_活動,
予定_防衛,
予定_情報,
予定_自由
}
;四肢欠損しているなら出来ない
{
#DIM CONST 欠損制約行動 =
予定_出撃,
予定_鍛錬,
予定_活動,
予定_防衛,
予定_情報,
予定_自由
}
;フィート[生粋の戦士]があるなら出来ない
{
#DIM CONST 戦士制約行動 =
予定_活動,
予定_支援
}
