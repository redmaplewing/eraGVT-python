;--------------------------------------------------
;特別活動関数群で使う定数・変数定義

;特別活動の名前と通し番号
#DIM CONST 特別活動_アルバイト = 0
#DIM CONST 特別活動_研究 = 1
#DIM CONST 特別活動_雑魚触手退治 = 2
#DIM CONST 特別活動_援助交際 = 3
#DIM CONST 特別活動_AV出演 = 4
#DIM CONST 特別活動_公衆便所 = 5
#DIM CONST 特別活動_アイドル活動 = 6
#DIM CONST 特別活動_枕営業 = 7
#DIM CONST 特別活動_ライブ公演 = 8
{
#DIM CONST 特別活動 =
特別活動_アルバイト,
特別活動_研究,
特別活動_雑魚触手退治,
特別活動_援助交際,
特別活動_AV出演,
特別活動_公衆便所,
特別活動_アイドル活動,
特別活動_枕営業,
特別活動_ライブ公演
}
{
#DIMS CONST 特別活動名称 =
"アルバイト",
"研究",
"雑魚触手退治",
"援助交際",
"AV出演",
"公衆便所",
"アイドル活動",
"枕営業",
"ライブ公演"
}

;各特別活動の結果の名前と通し番号
;成功/失敗/大失敗（絶頂）/大成功	アルバイト・雑魚触手退治・ライブ公演で共用
;AV出演・援助交際も結果計算の分岐はないので今のところ成功一択
#DIM CONST 特別活動結果_成功 = 0
#DIM CONST 特別活動結果_失敗 = 1
#DIM CONST 特別活動結果_絶頂失敗 = 2
#DIM CONST 特別活動結果_大成功 = 3
{
#DIM CONST 特別活動結果 =
特別活動結果_成功,
特別活動結果_失敗,
特別活動結果_絶頂失敗,
特別活動結果_大成功
}

;研究
#DIM CONST 特別活動研究_助手 = 0
#DIM CONST 特別活動研究_搾乳 = 1
#DIM CONST 特別活動研究_子宮 = 2
{
#DIM CONST 特別活動研究 =
特別活動研究_助手,
特別活動研究_搾乳,
特別活動研究_子宮
}

;公衆便所
#DIM CONST 特別活動公衆便所_肉便器 = 0
#DIM CONST 特別活動公衆便所_牝犬 = 1
{
#DIM CONST 特別活動公衆便所 =
特別活動公衆便所_肉便器,
特別活動公衆便所_牝犬
}

;アイドル活動
#DIM CONST アイドル活動_路上ライブ = 0
#DIM CONST アイドル活動_テレビ出演 = 1
#DIM CONST アイドル活動_グラビア撮影 = 2
#DIM CONST アイドル活動_CD収録 = 3
#DIM CONST アイドル活動_営業 = 4
{
#DIM CONST アイドル活動 =
アイドル活動_路上ライブ,
アイドル活動_テレビ出演,
アイドル活動_グラビア撮影,
アイドル活動_CD収録,
アイドル活動_営業
}

;枕営業
#DIM CONST 枕営業_Ｐにフェラ = 0
#DIM CONST 枕営業_Ｐとセックス = 1
#DIM CONST 枕営業_Ｖマニア = 2
#DIM CONST 枕営業_Ａマニア = 3
#DIM CONST 枕営業_輪姦 = 4
{
#DIM CONST 枕営業 =
枕営業_Ｐにフェラ,
枕営業_Ｐとセックス,
枕営業_Ｖマニア,
枕営業_Ａマニア,
枕営業_輪姦
}
;活動結果の最多パターン数を求める
;特活報酬係数格納配列の要素数に使う
{
#DIM CONST 活動結果最大値 = MAX(
VARSIZE("特別活動結果"),
VARSIZE("特別活動公衆便所"),
VARSIZE("アイドル活動"),
VARSIZE("枕営業")
)
}
