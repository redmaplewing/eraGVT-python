;--------------------------------------------------
;各特別活動結果の、パラメータ減少・報酬計算の係数定義
;
;体力係数・気力係数・性耐性係数：それぞれ最大値に対する％（乱数バラつきあり）を減少量とする
;性耐性係数を0とすると減少量は0固定になる
;
;稼ぎ額＝基本稼ぎ係数(ラッキーチャームなら1.25倍)*体力減少量※/稼ぎ除数+レベル*稼ぎレベル係数+稼ぎ加算+乱数
;※援助交際とAV出演は現在体力をベース、AV出演とライブ公演は魅了経験ボーナス付加
;雑魚触手退治失敗・公衆便所（牝犬）・アイドル活動（営業）・枕営業は稼ぎなし（稼ぎ除数=0とする）
;公衆便所（肉便器）の稼ぎ額は特殊計算

;格納配列の添字定義
#DIM CONST 特活報酬_体力係数 = 0
#DIM CONST 特活報酬_気力係数 = 1
#DIM CONST 特活報酬_性耐性係数 = 2
#DIM CONST 特活報酬_稼ぎ除数 = 3
#DIM CONST 特活報酬_稼ぎレベル係数 = 4
#DIM CONST 特活報酬_稼ぎ加算 = 5
{
#DIM CONST 特活報酬添字 =
特活報酬_体力係数,
特活報酬_気力係数,
特活報酬_性耐性係数,
特活報酬_稼ぎ除数,
特活報酬_稼ぎレベル係数,
特活報酬_稼ぎ加算
}

;体力・気力・性耐性減少量の乱数
#DIM CONST 特活報酬_体力乱数 = 7
#DIM CONST 特活報酬_気力乱数 = 4
#DIM CONST 特活報酬_性耐性乱数 = 4

;稼ぎ額の乱数
#DIM CONST 特活報酬_稼ぎ乱数 = 4

;特別活動結果のパラメータ減少・報酬計算係数配列（ERBで値設定するので変数定義）
#DIM 特活報酬, VARSIZE("特別活動"), 活動結果最大値, VARSIZE("特活報酬添字")
#DIM 特活報酬_IS_ALREADY_SET = 0

