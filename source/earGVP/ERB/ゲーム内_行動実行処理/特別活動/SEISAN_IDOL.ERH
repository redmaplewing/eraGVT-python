;--------------------------------------------------
;特別活動のうちアイドル活動の結果計算に関する定数定義

;アイドルレベル条件
;添字がそのままアイドルレベルに相当する（魅了経験がN番目の値未満ならレベルN）
#DIM CONST アイドルレベル条件 =  30, 100, 150,  200,  250,  300,  400,  500, __INT_MAX__

;テレビ出演時の魅了経験に応じた視聴者数係数（参照渡しするので変数定義）
#DIM テレビ出演視聴者係数     =  30,  30,  30,   60,   60,   60,   90,   90,   90
;グラビア撮影時の魅了経験に応じた発行部数係数（参照渡しするので変数定義）
#DIM グラビア発行部数係数     = 200, 200, 200, 1000, 1000, 1000, 2000, 2000, 2000
;CD収録時の魅了経験に応じた販売枚数係数（参照渡しするので変数定義）
#DIM CD販売枚数係数           = 200, 200, 200, 1000, 1000, 1000, 2000, 2000, 2000
;ライブ公演時の魅了経験に応じた観客動員数係数（参照渡しするので変数定義）
#DIM ライブ観客係数           =   4,   4,   4,   11,   22,   22,   38,   54,   72

;プロデビュー決定時の行動
#DIM CONST プロデビュー_無名 = 0
#DIM CONST プロデビュー_有名 = 1
#DIM CONST プロデビュー_路上ライブ = 2
#DIM CONST プロデビュー_売り込み = 3
