;女子の人気投票
;学校のみ
;防衛が低い＝治安悪い＝ゲス確率増
@PASTIME_TOHYO, ARG
#DIMS 順位

PRINTFORML 「人気投票」
;オトコは非対応
IF ISMALE()
	RETURN 0
ENDIF
PRINTW
IF RAND:2 == 0
	PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%は空き教室の黒板に書かれた落書きを見つけた。
	PRINTFORM 黒板には『
ELSE 
	PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%はゴミ箱のかたわらに丸められた紙が落ちているのを見つけ、何気なくその紙屑を広げて見た。
	PRINTFORM 紙には『
ENDIF

;治安低ければ発生しやすい下品めなネタ　1000なら90％　10000なら0％であってる？
IF RAND:100 > FLAG:852 / 100
	SELECTCASE RAND:16
;C感覚
		CASE 0
		PRINT クリいじってそうな
			IF ABL:Ｃ感覚 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:Ｃ感覚 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;V
		CASE 1
		PRINT 締まりが良さそうな
			IF ABL:Ｖ感覚 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:Ｖ感覚 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;A
		CASE 2
		PRINT アナル弱そうな
			IF ABL:Ａ感覚 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:Ａ感覚 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;B
		CASE 3
		PRINT 乳首だけでイキそうな
			IF ABL:Ｂ感覚 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:Ｂ感覚 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;従順
		CASE 4
		PRINT 強引に誘えばヤラセてくれそうな
			IF ABL:従順 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:従順 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;欲
		CASE 5
		PRINT 性欲強そうな
			IF ABL:欲望 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:欲望 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;技巧
		CASE 6
		PRINT 腰使いがヤバそうな
			IF ABL:技巧 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:技巧 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;奉仕
		CASE 7
		PRINT フェラが好きそうな
			IF ABL:奉仕精神 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:奉仕精神 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;露出
		CASE 8
		PRINT パンツ見せてくれそうな
			IF ABL:露出癖 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:露出癖 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;マゾ
		CASE 9
		PRINT マゾっぽい
			IF ABL:マゾっ気 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:マゾっ気 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF

;触手
		CASE 10
		PRINT 触手姦にハマってそうな
			IF ABL:触手中毒 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:触手中毒 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;自慰
		CASE 11
		PRINT 毎日オナってそうな
			IF ABL:自慰中毒 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:自慰中毒 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;精液
		CASE 12
		PRINT ザーメン飲みそうな
			IF ABL:精液中毒 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:精液中毒 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;噴乳

		CASE 13
			PRINT 母乳出やすそうな
			IF ABL:噴乳中毒 > 4
				順位 = ダントツ１位だった
			ELSEIF ABL:噴乳中毒 > 2
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;被姦経験
		CASE 14
			PRINT ヤリマンっぽい
			IF EXP:10 > 100
				順位 = ダントツ１位だった
			ELSEIF EXP:10 > 50
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;交際
		CASE 15
			PRINT 寝取りたい
			IF TALENT:交際相手 > 2
				順位 = ダントツ１位だった
			ELSEIF TALENT:交際相手 > 1
				順位 = トップ５に入っていた
			ELSE
				順位 = １０位以内にランクインしていた	
			ENDIF
;AV出演PRINT ズリネタにしたことがある（未
;円光PRINT 一発ヤリたい（未
		CASEELSE
			PRINT ムッツリスケベな	
				順位 = ダントツ１位だった
		ENDSELECT
;治安が高い時　健全なもの
ELSE
;おっぱい
	IF RAND:3 == 0
		IF TALENT:小柄 > 0
			PRINT ロリ巨乳
		ELSEIF TALENT:長身 > 0
			PRINT 巨乳イケメン
		ELSE
			PRINT おっぱい大きい
		ENDIF
		IF TALENT:巨乳 > 3
			順位 = トップ３だった
		ELSEIF TALENT:巨乳 > 0
			順位 = トップ５に入っていた
		ELSEIF TALENT:貧乳 > 0
			順位 = ランク外だった
		ELSE
			順位 = １０位以内にランクインしていた	
		ENDIF
;魅了経験
	ELSEIF RAND:2 == 0
		PRINT 彼女にしたい
		IF EXP:魅了経験 > 50
			順位 = ダントツ１位だった
		ELSEIF EXP:魅了経験 > 25
			順位 = トップ５に入っていた
		ELSE
			順位 = １０位以内にランクインしていた	
		ENDIF
	ELSE
		PRINT 強そうな
		IF EXP:戦闘経験 > 30
			順位 = ダントツ１位だった
		ELSEIF EXP:戦闘経験 > 15
			順位 = トップ５に入っていた
		ELSE
			順位 = １０位以内にランクインしていた	
		ENDIF
	ENDIF
ENDIF

PRINTFORML 女子ランキング』と書かれている。
PRINTFORML 呆れつつも自分の名前を探した%PRINT_TRANSCALLNAME(TARGET)%は…%順位%。
PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%は嫌悪感に顔をしかめつつも、男たちからどんな目で見られているのかを知り赤面している。