@INSTANT_ARG_DOWN
;未変身状態だと能力低下5回
IF CFLAG:1 == 0
	LOCAL:1 = 5
	PRINTFORMW 敵の纏う瘴気が体に染み込む……
;変身・SP変身状態なら能力低下2回
ELSE
	LOCAL:1 = 2
	PRINTFORMW 敵の纏う瘴気が辺りに撒き散らされている……
ENDIF
$LOOP_I_ARG_DOWN
;攻撃・防御・敏捷・知性のどれか1つを減らす
LOCAL:2 = RAND:5
IF LOCAL:2 == 0
	BASE:TARGET:攻撃 -= 1
ELSEIF LOCAL:2 == 1
	BASE:TARGET:防御 -= 1
ELSEIF LOCAL:2 == 2
	BASE:TARGET:敏捷 -= 1
ELSEIF LOCAL:2 == 3
	BASE:TARGET:知性 -= 1
ELSE
	BASE:TARGET:体力基礎 -=10

ENDIF
;LOCAL:1が0になるまで繰り返す
LOCAL:1 -= 1
IF LOCAL:1 > 0
	GOTO LOOP_I_ARG_DOWN
ENDIF

