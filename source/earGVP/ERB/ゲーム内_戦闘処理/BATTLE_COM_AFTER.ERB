;戦闘コマンド実行後処理
@SOURCE_CHECK

;強拘束(ピストン)中と丸飲み準備中は敗北／時間切れ敗北が遅延される
#DIM ターン内敗北キャンセル,1
ターン内敗北キャンセル=0

;**********************************************************
;プレイヤー行動直後の共通処理
;**********************************************************
;ＳＰ変身終了までは疲労が蓄積しない
IF CFLAG:1 == 2
	TFLAG:99 += 1
;それ以外なら行動の反動で疲労が蓄積する
ELSEIF TFLAG:99 > 0
	CFLAG:99 += TFLAG:99
	RESULTS = {TFLAG:99}
	TOFULL RESULTS
	PRINTFORML %PRINT_CALLNAME(TARGET)%の身体の底に疲労が蓄積した……（＋%RESULTS%）
	PRINTW 
	TFLAG:99 = 0
ENDIF

;**********************************************************
;装備効果の発動
;**********************************************************
;TK-ドローン
SIF CFLAG:TARGET:43 == 506
	CALL TK_DRONE
;宇宙シール
SIF CFLAG:TARGET:43 == 507
	CALL HP_AUTOREGAIN
;使い魔
SIF CFLAG:TARGET:43 == 509
	CALL SERVANT
	
;**********************************************************
;裏ボス形態変化の処理
;**********************************************************
IF ENEMY_TYPE_CHECK_F("LASTBOSS") >= 2
	CALL PERCENT_CAL, FLAG:13, FLAG:12
	IF ENEMY_TYPE_CHECK_F("LASTBOSS") == 2 && RESULT <= 75
		PRINTW …
		PRINTW ……
		PRINTW ………
		PRINTL 
		PRINTW 分厚い甲殻を突き破り、ようやく内部に一撃が到達する……
		PRINTW すると"天使の樹"の蕾が花開き、周囲に妖しげな香りが立ち込める……！！
		PRINTW "天使の樹"は"楽園の花"に変化した……！！
		PRINTL 
		FLAG:21 = 2
	ELSEIF ENEMY_TYPE_CHECK_F("LASTBOSS") == 3 && RESULT <= 37
		PRINTW …
		PRINTW ……
		PRINTW ………
		PRINTL 
		PRINTW 敵が苦しみ悶え、肉の花弁の色が褪せていく……
		PRINTW 肉腫のような花が次々と枯れ落ちていき、敵の"核"が姿を現した……！！
		PRINTW "楽園の花"は"堕落の核"に変化した……！！
		PRINTL 
		FLAG:21 = 3
	ELSEIF ENEMY_TYPE_CHECK_F("LASTBOSS") == 4 && RESULT <= 10
		PRINTW …
		PRINTW ……
		PRINTW ………
		PRINTL 
		PRINTW 張り巡らされた肉の根から栄養が吸い上げられると、
		PRINTW 引き千切られ、朽ち果てた敵の触手がみるみる再生していく……！！
		LOCAL = FLAG:12 * 70 / 100 - FLAG:13
		PRINTFORMW "堕落の核"の体力が{LOCAL}回復した……！！
		PRINTL 
		FLAG:13 += LOCAL
		FLAG:21 = 4
	ELSEIF ENEMY_TYPE_CHECK_F("LASTBOSS") == 5 && FLAG:13 <= 0
		PRINTW …
		PRINTW ……
		PRINTW ………
		PRINTL 
		PRINTW  ピキッ とヒビの入るような音が響き渡り、全てが制止した……
		PRINTW 最後の一撃が水を打ったように異形の柱たちの動きを止め、
		PRINTW 静かに"堕落の核"がボロボロと風化し、地に落ちて砕け散った。
		PRINTL 
		PRINTW 中枢を失った周囲の肉塊が生気を失って石のように固まり、
		PRINTW はじめは遠い地響きと共に、やがて盛大な轟音となってガラガラと崩壊をはじめる……
		PRINTL 
		PRINTW 全てが土煙りに包まれて、何も見えなくなった……
		PRINTL 
		PRINTW …
		PRINTW ……
		PRINTW ………
		PRINTW 地響きが収まったときには、もう何も残ってはいなかった。
		PRINTW 辺りに広がるのは戦いで荒れ果てた廃墟と、虹色の砂となって散らばる触手の残骸のみ。
		PRINTW 探し回っても生存者の気配はなく、
		PRINTFORMW %PRINT_TRANSCALLNAME(TARGET)%は無人の荒野に立ち尽くすしかない。
		PRINTW "天使の樹"に取り込まれた者は、一緒に砂となって消えてしまったのだ。
		PRINTW これでは、いったい何のために戦ったのか――
		PRINTL 
		PRINTW …
		PRINTW ……
		PRINTW ………
		PRINTW ――いや、違う！　崩れ去った瓦礫に隠れるように、少女が倒れている！
		PRINTW 必死に砂を掘り返し、裸のまま気絶している少女を助け出して抱き締めると、
		PRINTW 弱々しくも、しかし確かな鼓動の感触が胸を打った。
		PRINTW 耳を澄ませば周囲からは声を掛け合い、救助活動に勤しむ人々の活気が伝わってくる。
		PRINTW そう、人類を襲った脅威はもはや去ったのだ……
		PRINTL 
		PRINTFORMW 安堵のためか放心してその場に座り込む%PRINT_TRANSCALLNAME(TARGET)%の頬を、
		PRINTW 虹色の風が優しく撫でていった……
		PRINTL 
		FLAG:21 = 0
	ENDIF
ENDIF

;**********************************************************
;戦闘終了処理１　勝利
;**********************************************************
IF FLAG:13 <= 0
	;全てのボス触手のダメージ蓄積値が回復
	IF ENEMY_TYPE_CHECK_F("MOB") == 0 && ENEMY_TYPE_CHECK_F("CITIZEN") == 0
		CALL GET_BOSS_ERB_NUM
		FOR LOCAL,1,RESULT + 1
			FLAG:(300 + LOCAL) -= RAND:(11) + 50
			SIF FLAG:(300 + LOCAL) < 0
				FLAG:(300 + LOCAL) = 0
		NEXT
	ENDIF

	;戦闘結果フラグ：勝利
	TFLAG:98 = 1

	;★現時点でクズ市民戦は勝利分岐に入らない
	;　(拘束から脱出＝タイムアップ時分岐に派生)
	;　クズ市民戦拡張に合わせて要改変

	;ボス触手に勝利
	IF ENEMY_TYPE_CHECK_F("BOSS") == 1 || ENEMY_TYPE_CHECK_F("LASTBOSS") >= 1
	
		;地の文：戦闘勝利
		CALL MESSAGE_BATTLE_END_WIN
	
		;ボス触手
		IF ENEMY_TYPE_CHECK_F("BOSS") == 1
			;索敵ターゲットを倒した場合は索敵をリセット
			SIF FLAG:18 == FLAG:11
				FLAG:18 = 0
			;倒したボスの蓄積ダメージをリセット
			FLAG:(FLAG:11 + 300) = 0
			;エンドレスモードではビットを寝かせずボスの総数だけを増やす
			IF GAME_OPTION_CHECK_F(OPTION_endless) && FLAG:11 > 0
				FLAG:3 += 1
				;同じボスと連続で遭遇しないようにする
				CALL TENTACLE_SURVIVE,"NUM"
				$ENDLESS_TARGET_LOOP
				FLAG:18 = RAND:RESULT
				SIF FLAG:18 == FLAG:11
					GOTO ENDLESS_TARGET_LOOP
			;エンドレスモード以外では倒したボス触手のビットを寝かせる
			ELSEIF FLAG:11 > 0
				CLEARBIT FLAG:100,FLAG:11 - 1
			ENDIF



			;返り血
			TRYCALL SUPART_BLOOD
		;ラスボス（Ｋ）or裏ボス触手撃破時
		ELSEIF ENEMY_TYPE_CHECK_F("LASTBOSS") == 1 && GET_LASTBOSS_PHASE_F() >= 1
			;索敵ターゲットを倒した場合は索敵をリセット
			SIF FLAG:18 == FLAG:11
				FLAG:18 = 0

			;倒したラスボスの蓄積ダメージをリセット
			FLAG:(FLAG:11 + 400) = 0

			;周回後＆HARDCOREでＫ触手を撃破した場合
			IF FLAG:854 > 0 && GAME_OPTION_CHECK_F(OPTION_hardcore) && FLAG:101 == 1
				;裏ボスを登場させる準備
				FLAG:4 += 1
				FLAG:1 += 5
				FLAG:21 = 1
			;裏ボス撃破
			ELSEIF FLAG:101 == 2
				;エンディング
				FLAG:64 = -1
				CALL UNLOCK_ACHIEVEMENT(270,"とびっきりの最強対最強")
			ELSE
				;エンディング
				FLAG:64 = -1
			ENDIF

			;倒したラスボス触手のビットを寝かせる
			SIF FLAG:11 > 0
				CLEARBIT FLAG:101,FLAG:11 - 1

		ENDIF
		
		;ボス撃破時の共通処理
		IF BASE:体力 == MAXBASE:体力 && BASE:気力 == MAXBASE:気力 && TFLAG:0 >= 10
			CALL UNLOCK_ACHIEVEMENT(266,"パーフェクション")
		ENDIF

		CALL AFTER_KILLED_BOSS

		;ボスに洗脳されていたキャラの救出
		LOCAL:1 = 0
		FOR LOCAL, 0, CHARANUM
			SIF LOCAL == MASTER
				CONTINUE
			IF CFLAG:LOCAL:0 == 2 && CFLAG:LOCAL:20 == FLAG:10 && CFLAG:LOCAL:21 == FLAG:11
				CALL UNLOCK_ACHIEVEMENT(273,"わたくしは何を…？")
				IF LOCAL:1 == 0
					;地の文：洗脳中キャラの救出
					CALL MESSAGE_BATTLE_END_RESCUE_SENNOU
				ENDIF
				CFLAG:LOCAL:0 = -1
				CFLAG:LOCAL:20 = 0
				CFLAG:LOCAL:21 = 0
				CFLAG:LOCAL:30 = 0
				CFLAG:LOCAL:31 = 0
				BASE:LOCAL:体力 = 1
				BASE:LOCAL:気力 = 1
				BASE:LOCAL:性耐性 = 1
				BASE:LOCAL:性耐性 = 1
				CFLAG:LOCAL:220 = 0
				LOCAL:2 = TARGET
				TARGET = LOCAL
				;地の文：洗脳中キャラの救出された側
				CALL MESSAGE_OTHER_BATTLE_END_RESCUED_SENNOU
				TARGET = LOCAL:2
				LOCAL:1 = 1
			ENDIF
		NEXT
	
		;捕らわれキャラの救出
		LOCAL:1 = 0
		FOR LOCAL, 0, CHARANUM
			SIF LOCAL == MASTER
				CONTINUE
		
			IF CFLAG:LOCAL:0 == 1 && CFLAG:LOCAL:20 == FLAG:10 && CFLAG:LOCAL:21 == FLAG:11
				CALL UNLOCK_ACHIEVEMENT(271,"いま助けるわ！")
				IF LOCAL:1 == 0
					;地の文：捕らわれキャラの救出
					CALL MESSAGE_BATTLE_END_RESCUE
				ENDIF
				CFLAG:LOCAL:0 = -1
				CFLAG:LOCAL:20 = 0
				CFLAG:LOCAL:21 = 0
				CFLAG:LOCAL:30 = 0
				CFLAG:LOCAL:31 = 0
				BASE:LOCAL:体力 = 1
				BASE:LOCAL:気力 = 1
				BASE:LOCAL:性耐性 = 1
				CFLAG:LOCAL:220 = 0
				LOCAL:2 = TARGET
				TARGET = LOCAL
				;地の文：救出された側
				CALL MESSAGE_OTHER_BATTLE_END_RESCUED
				TARGET = LOCAL:2
				LOCAL:1 = 1
			ENDIF
		NEXT


		;ボス全滅、かつラスボスが存在していない場合
		IF FLAG:100 == 0 && FLAG:101 == 0
			;未出現なら
			IF FLAG:64 != -1
				;ラスボス撃破による裏ボス出現
				IF FLAG:854 > 0 && GAME_OPTION_CHECK_F(OPTION_hardcore) && ENEMY_TYPE_CHECK_F("LASTBOSS") == 2
					FLAG:101 = 2
					CALL MESSAGE_BATTLE_END_LASTBOSSAPPEAR_2
				;ラスボス出現
				ELSEIF ENEMY_TYPE_CHECK_F("LASTBOSS") == 0
					FLAG:101 = 1
					CALL MESSAGE_BATTLE_END_LASTBOSSAPPEAR
				ENDIF
			;出現した上でラスボスを倒したなら
			ELSE
				;地の文：完全殲滅
				CALL MESSAGE_BATTLE_END_PERFECT
				;実績
				IF GAME_OPTION_CHECK_F(OPTION_solo) && TALENT:Ｃ敏感 && TALENT:Ｖ敏感 && TALENT:Ａ敏感 && TALENT:Ｂ敏感
					CALL UNLOCK_ACHIEVEMENT(260,"触手なんかに負けない！")
				ENDIF
				IF GAME_OPTION_CHECK_F(OPTION_solo) && EXP:幽閉経験 >= 1
					CALL UNLOCK_ACHIEVEMENT(261,"不屈の闘志")
				ENDIF
				LOCAL:97 = 0
				LOCAL:98 = 0
				FOR LOCAL:99,0,CHARANUM
					SIF LOCAL:99 == MASTER
						CONTINUE
					SIF CFLAG:(LOCAL:99):231 > 0
						LOCAL:98 ++
					SIF JUEL:(LOCAL:99):修練P > LOCAL:97
						LOCAL:97 = JUEL:(LOCAL:99):修練P
				NEXT
				IF LOCAL:97 >= 1000
					CALL UNLOCK_ACHIEVEMENT(259,"もったいないお化け")
				ENDIF
				IF LOCAL:98 >= 3
					CALL UNLOCK_ACHIEVEMENT(265,"NEXT GENERATION")
				ENDIF
				;エンディングフラグを立てる
				BEGIN TURNEND
			ENDIF
		ENDIF



	;悪堕ちキャラに勝利
	ELSEIF ENEMY_TYPE_CHECK_F("AKUOTI") == 1
		FLAG:110 = 0
	
		;地の文：敵キャラとの戦闘勝利
		CALL MESSAGE_BATTLE_END_WIN_ENEMY
		;地の文：洗脳/悪堕ちキャラが操作キャラに敗北した
		CALL MESSAGE_OTHER_BATTLE_END_WIN_ENEMY

		IF BASE:体力 == MAXBASE:体力 && BASE:気力 == MAXBASE:気力 && TFLAG:0 >= 10
			CALL UNLOCK_ACHIEVEMENT(266,"パーフェクション")
		ENDIF

		;地の文：敵キャラの救出
		CALL MESSAGE_BATTLE_END_RESCUE_ENEMY
		
		;今回倒した敵が洗脳だったか悪堕ちだったか一時保存
		;2＝洗脳　3＝悪堕ち
		LOCAL:3 = CFLAG:(FLAG:111):0

		;悪堕ちキャラが正気に返らないオプション
		IF CONFIG_CHECK_PRISON_F(11) == 1 && LOCAL:3 == 3
			CALL MESSAGE_OTHER_BATTLE_END_AKUOTI_NO_RESCUE
		ELSE
			;悪堕ちor洗脳キャラ本人の救出(復帰)
			CFLAG:(FLAG:111):0 = -1
			CFLAG:(FLAG:111):20 = 0
			CFLAG:(FLAG:111):21 = 0
			CFLAG:(FLAG:111):30 = 0
			CFLAG:(FLAG:111):31 = 0
			BASE:(FLAG:111):体力 = 1
			BASE:(FLAG:111):気力 = 1
			BASE:(FLAG:111):性耐性 = 1
			CALL UNLOCK_ACHIEVEMENT(272,"正気に戻りなさい！")
			;地の文：洗脳/悪堕ち状態で倒された側
			CALL MESSAGE_OTHER_BATTLE_END_RESCUED_ENEMY

			;悪堕ちキャラに洗脳されていたキャラの連鎖救出
			IF LOCAL:3 == 3
				LOCAL:1 = 0
				FOR LOCAL, 0, CHARANUM
					SIF LOCAL == MASTER
						CONTINUE
					
					IF CFLAG:LOCAL:20 == 2 && CFLAG:LOCAL:21 == CFLAG:(FLAG:111):240 && CFLAG:LOCAL:0 == 2
						CALL UNLOCK_ACHIEVEMENT(273,"わたくしは何を…？")
						IF LOCAL:1 == 0
							;地の文：洗脳中キャラの救出
							CALL MESSAGE_BATTLE_END_RESCUE_SENNOU
						ENDIF
						CFLAG:LOCAL:0 = -1
						CFLAG:LOCAL:20 = 0
						CFLAG:LOCAL:21 = 0
						CFLAG:LOCAL:30 = 0
						CFLAG:LOCAL:31 = 0
						CFLAG:LOCAL:100 = 103
						BASE:LOCAL:体力 = 1
						BASE:LOCAL:気力 = 1
						BASE:LOCAL:性耐性 = 1
						CFLAG:LOCAL:220 = 0
						LOCAL:2 = TARGET
						TARGET = LOCAL
						;地の文：洗脳中キャラの救出された側
						CALL MESSAGE_OTHER_BATTLE_END_RESCUED_SENNOU
						TARGET = LOCAL:2
						LOCAL:1 = 1
					ENDIF
				NEXT
			ENDIF
			;悪堕ちキャラに幽閉されていたキャラの連鎖救出
			IF LOCAL:3 == 3
				LOCAL:1 = 0
				FOR LOCAL, 0, CHARANUM
					SIF LOCAL == MASTER
						CONTINUE
					
					IF CFLAG:LOCAL:20 == 2 && CFLAG:LOCAL:21 == CFLAG:(FLAG:111):240 && CFLAG:LOCAL:0 == 1
						CALL UNLOCK_ACHIEVEMENT(271,"いま助けるわ！")
						IF LOCAL:1 == 0
							;地の文：捕らわれキャラの救出
							CALL MESSAGE_BATTLE_END_RESCUE_AKUOTI
						ENDIF
						CFLAG:LOCAL:0 = -1
						CFLAG:LOCAL:20 = 0
						CFLAG:LOCAL:21 = 0
						CFLAG:LOCAL:30 = 0
						CFLAG:LOCAL:31 = 0
						CFLAG:LOCAL:100 = 103
						BASE:LOCAL:体力 = 1
						BASE:LOCAL:気力 = 1
						BASE:LOCAL:性耐性 = 1
						CFLAG:LOCAL:220 = 0
						LOCAL:2 = TARGET
						TARGET = LOCAL
						;地の文：救出された側
						CALL MESSAGE_OTHER_BATTLE_END_RESCUED
						TARGET = LOCAL:2
						LOCAL:1 = 1
					ENDIF
				NEXT
			ENDIF

		ENDIF
	
	;雑魚戦に勝利
	ELSEIF ENEMY_TYPE_CHECK_F("MOB") == 1
		;地の文：戦闘勝利
		CALL MESSAGE_BATTLE_END_WIN

		;探索度上昇
		LOCAL = 8 + RAND:5
		SIF CFLAG:100 != 101
			LOCAL /= 2
		;FEAT効果による探索度アップ
		SIF TALENT:狩人の勘 > 0
			LOCAL += 7
		PRINTFORML 探索度が{LOCAL}上昇した
		CALL RESEARCH_PROGRESS, LOCAL
		PRINTL 


	ENDIF
	
	BEGIN AFTERTRAIN
ENDIF

;戦闘中フラグが折れていればこの先には進まない
SIF FLAG:700 == 0
	RETURN

;前のターンの攻撃箇所を保持
TFLAG:13 = TFLAG:11

;自分の行動によるPALAMの補正値の処理
;--------------------------------------------------------------------------------------
;壊れない衣装用の判定
LOCAL:1 = 0
SIF (CFLAG:1 == 0 && TCVARn:20 == -1) || (CFLAG:1 >= 1 && TCVARn:22 == -1)
	LOCAL:1 |= 2
SIF TCVARn:24 == -1 || (CLOTH_NO_INNER > 0 && LOCAL:1 > 0)
	LOCAL:1 |= 1
SIF CFLAG:(CFLAG:1==0 ? 40 # 41) == 199 && FIGURE_SPLIT(EQUIP:(CFLAG:1==0 ? 99 # 199), 1) == 0
	LOCAL:1 = 0
;運動時にクリトリス/ペニスに快感が走る
;快C
IF ABL:Ｃ感覚 <= 2
	LOCAL = 0
ELSEIF ABL:Ｃ感覚 <= 4
	LOCAL = 4
ELSEIF ABL:Ｃ感覚 == 5
	LOCAL = 8
ELSEIF ABL:Ｃ感覚 == 6
	LOCAL = 12
ELSEIF ABL:Ｃ感覚 == 7
	LOCAL = 20
ELSEIF ABL:Ｃ感覚 >= 8 && ABL:Ｃ感覚 < 12
	LOCAL = (ABL:Ｃ感覚 * 2 / 3) * 15
ELSEIF ABL:Ｃ感覚 >= 10
	LOCAL = (ABL:Ｃ感覚 * 2 / 3) * 30
ENDIF
SIF ISPENIS()
	LOCAL += 20
CALL CLOTH_BATTLE_HOSEI, "ANTICUP"
	LOCAL -= RESULT
SIF RESULT
	LOCAL /= 2
;直前の行動
IF SELECTCOM == 8 || SELECTCOM == 9
	LOCAL += 25
ELSEIF SELECTCOM == 1 || SELECTCOM == 5 || SELECTCOM == 6 || SELECTCOM == 7 || SELECTCOM == 16 || SELECTCOM == 17
	LOCAL += 15
ELSEIF SELECTCOM == 2 || SELECTCOM == 3
	LOCAL += 5
ELSE
	LOCAL /= 8
ENDIF
IF ISPENIS()
	;下着がなく、勃起していない
	IF (CLOTH_CHECK(TARGET) & 1) == 0 && (LOCAL:1 & 1) == 0 && PALAM:欲情 < 2000
		LOCAL /= 2
	;下着があり、勃起していない
	ELSEIF ((CLOTH_CHECK(TARGET) & 1) || (LOCAL:1 & 1)) && PALAM:欲情 < 2000
		LOCAL *= 2
	;フル勃起で丸出し状態だと振動で揺れてつらい
	ELSEIF (CLOTH_CHECK(TARGET) & 1) == 0 && (LOCAL:1 & 1) == 0
		LOCAL *= 8
	;下着がある状態でフル勃起だと擦れてつらい
	ELSE
		LOCAL *= 16
	ENDIF
;下着でクリちゃんが擦れてつらい
ELSEIF (CLOTH_CHECK(TARGET) & 1) || (LOCAL:1 & 1)
	LOCAL *= 6
;下着がなければ擦れない
ELSE
	LOCAL *= 0
ENDIF
SIF TALENT:淫核
	LOCAL = LOCAL * 175 / 100
SIF LOCAL < 100
	LOCAL = 0
COMMON_PALAM:0 += LOCAL

;運動時におっぱいに快感が走る
;快B
IF ABL:Ｂ感覚 <= 2
	LOCAL = 0
ELSEIF ABL:Ｂ感覚 <= 4
	LOCAL = 5
ELSEIF ABL:Ｂ感覚 == 5
	LOCAL = 10
ELSEIF ABL:Ｂ感覚 == 6
	LOCAL = 20
ELSEIF ABL:Ｂ感覚 == 7
	LOCAL = 40
ELSEIF ABL:Ｂ感覚 >= 8 && ABL:Ｂ感覚 < 12
	LOCAL = (ABL:Ｂ感覚 * 2 / 3) * 20
ELSEIF ABL:Ｂ感覚 >= 12
	LOCAL = (ABL:Ｂ感覚 * 2 / 3) * 40
ENDIF
SIF TALENT:母乳体質
	LOCAL += 5
CALL CLOTH_BATTLE_HOSEI, "ANTIBUP"
	LOCAL -= RESULT
SIF RESULT
	LOCAL /= 2
;直前の行動
IF SELECTCOM == 8 || SELECTCOM == 9
	LOCAL += 25
ELSEIF SELECTCOM == 1 || SELECTCOM == 5 || SELECTCOM == 6 || SELECTCOM == 7 || SELECTCOM == 16 || SELECTCOM == 17
	LOCAL += 15
ELSEIF SELECTCOM == 2 || SELECTCOM == 3
	LOCAL += 5
ELSE
	LOCAL /= 8
ENDIF
;ひんぬーは服を着ていると擦れてつらい
;オトコを追加
IF TALENT:貧乳 > 0 || ISMALE()
	IF (CLOTH_CHECK(TARGET) & 2) || (CLOTH_CHECK(TARGET) & 4) || (LOCAL:1 & 2)
		LOCAL *= 8
	ELSE
		LOCAL = 0
	ENDIF
;きょぬーは服がなくなると揺れてつらい。女の子的に揺れはＮＧなんですよぉ＞＜
ELSEIF TALENT:巨乳 > 0
	IF (CLOTH_CHECK(TARGET) & 2) || (CLOTH_CHECK(TARGET) & 4) || (LOCAL:1 & 2)
		LOCAL *= 4
	ELSE
		LOCAL *= 16
	ENDIF
	SIF TALENT:巨乳 > 3
		LOCAL *= 2
	SIF TALENT:巨乳 > 4
		LOCAL *= 2
;きょぬーでなくても服がないと揺れてつらい
ELSE
	IF (CLOTH_CHECK(TARGET) & 2) || (CLOTH_CHECK(TARGET) & 4) || (LOCAL:1 & 2)
		LOCAL *= 3
