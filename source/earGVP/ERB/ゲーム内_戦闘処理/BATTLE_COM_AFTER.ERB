					;初めての幽閉なら異常経験を付ける
					SIF EXP:幽閉経験 == 0
						EXP:異常経験 += 1
					
					EXP:幽閉経験 += 1
				;違ったら犯される
				ELSE
					;サブイベント：悪堕ちキャラに敗北して犯される
					CALL SUBEVENT_BATTLE_RAPED_ENEMY
				ENDIF
			ENDIF
		ENDIF

		;幽閉or死亡時は編成から外れる処理によりキャラ枠が手前に詰まるため、「現在行動中のキャラ」のフラグを１つ戻す
		SIF CFLAG:0 == 1 || CFLAG:0 == 9 || CFLAG:0 == 4
			FLAG:799 -= 1


		BEGIN AFTERTRAIN

	ENDIF
ENDIF

;**********************************************************
;戦闘終了処理３　時間切れ
;**********************************************************
;※強拘束(挿入)中に敗北状態になっていた場合は時間切れ終了にならず、必ずフィニッシュまで見せる
IF BASE:体力 == 0 && BASE:気力 == 0 && BASE:性耐性 == 0 && ターン内敗北キャンセル>0
	;気絶していなければ気絶する
	CALL STATE_CHANGE_KIZETU, 100
	;このターンは時間経過させない
	TFLAG:0 -= 1

;通常時の時間切れ判定
;　通常戦闘…既定ターン経過で終了
;　クズ市民…拘束から脱出していれば即時戦闘終了
ELSEIF (ターン上限!=-1 && TFLAG:0 >= ターン上限) || (FLAG:73 > 0 && TCVARn:0 != 0)
	;救出機能
	TRYCALL KYUSHUTU_TIMEUP_HANTEI
	;地の文：戦闘時間切れ
	IF FLAG:73 > 0
		CALL MESSAGE_BATTLE_END_CITIZEN_TIMEUP
	ELSE
		CALL MESSAGE_BATTLE_END_TIMEUP
	ENDIF
	;地の文：洗脳/悪堕ちキャラが操作キャラと引き分けた
	SIF ENEMY_TYPE_CHECK_F("AKUOTI") == 1
		CALL MESSAGE_OTHER_BATTLE_END_TIMEUP
	
	;サブイベント：触手拘束具の強制装着
	SIF (ENEMY_TYPE_CHECK_F("MOB") == 0 && ENEMY_TYPE_CHECK_F("CITIZEN") == 0)
		CALL SUBEVENT_BATTLE_SETTENTACLECLOTH

	BEGIN AFTERTRAIN
ENDIF

;--------------------------------------------------------------------------------------
;ターン終了時のフラグ初期化
TFLAG:18 = 0

;--------------------------------------------------------------------------------------
;オート振り解きの実行
IF CONFIG_CHECK_BALANCE_F(2) > 0
	CALL AUTO_UNTANGLE
ELSE
	TFLAG:22 = 1
ENDIF

;--------------------------------------------------------------------------------------
;発情による排卵の発生判定
CALL HATUJOU_TO_HAIRAN

;--------------------------------------------------------------------------------------
;素股焦らしによる次ターン行動指定処理
IF SELECTCOM == 103 && TFLAG:17 < 0 && RAND:100 < 95
	IF ENEMY_TYPE_CHECK_F("MOB") == 1 || ENEMY_TYPE_CHECK_F("CITIZEN") == 1
		TRYCALLFORM TENTACLE_MOB_{FLAG:11}_REACTION_REF, 1
	ELSEIF GET_LASTBOSS_PHASE_F() >= 1
		TRYCALLFORM TENTACLE_LASTBOSS_{FLAG:11}_REACTION_REF, 1
	ELSE
		TRYCALLFORM TENTACLE_BOSS_{FLAG:11}_REACTION_REF, 1
	ENDIF
	SIF RESULT >= 0
		TFLAG:17 = RESULT
ENDIF

;--------------------------------------------------------------------------------------
;ターン終了時の状態異常処理
IF TCVARn:12 > 0 && TCVARn:12 != 排卵
	PRINTL 
	FONTBOLD
	PRINTL 状態異常
	FONTREGULAR
ENDIF

;強拘束の持続判定
SIF (TCVARn:12 & 強拘束)
	PRINTFORML × %PRINT_TRANSCALLNAME(TARGET)%は行動を制限されている…
;発情の持続判定
IF (TCVARn:12 & 発情) && (TCVARn:12 & 気絶) == 0
	IF TALENT:主観視点 > 0
		PRINTFORML × %PRINT_TRANSCALLNAME(TARGET)%の体は媚薬の効果で欲情してしまっている…
	ELSE
		PRINTFORML × %PRINT_TRANSCALLNAME(TARGET)%は媚薬の効果で欲情している…
	ENDIF
	FONTBOLD
	IF BASE:性耐性 > 0
		IF MAXBASE:性耐性 >= 300
			LOCAL = RAND:8 + 3
		ELSEIF MAXBASE:性耐性 >= 200
			LOCAL = RAND:6 + 2
		ELSE
			LOCAL = RAND:4 + 1
		ENDIF
		PRINTFORML 　 性耐性が{LOCAL}減少した！
		PRINTL 
		BASE:性耐性 = MAX(BASE:性耐性 - LOCAL, 0)
	ELSE
		IF BASE:体力 > 0
			LOCAL = MAX(BASE:体力 / 40, 40) + RAND:30
			PRINTFORML 　 体力が{LOCAL}減少した！
			BASE:体力 = MAX(BASE:体力 - LOCAL, 0)
		ENDIF
		IF BASE:気力 > 0
			LOCAL = MAX(BASE:気力 / 20, 80) + RAND:60
			PRINTFORML 　 気力が{LOCAL}減少した！
			BASE:気力 = MAX(BASE:気力 - LOCAL, 0)
		ENDIF
	ENDIF
	FONTREGULAR
	PALAM:欲情 += LOCAL * 125
ENDIF
;麻痺の持続判定
IF (TCVARn:12 & 麻痺)
	IF (TCVARn:104 > 0 && RAND:(100 - 20 * (CFLAG:TARGET:43 == 508)) < MAX(25 - CFLAG:99 * 5 + TCVARn:104 * 5, 15)) || TCVARn:104 == -999
		PRINTFORML ○ %PRINT_TRANSCALLNAME(TARGET)%の麻痺が治った！
		PRINTFORML 　 %PRINT_TRANSCALLNAME(TARGET)%は[麻痺]状態から回復した！
		TCVARn:12 -= 麻痺
		TCVARn:104 = 0
	ELSE
		PRINTFORML × %PRINT_TRANSCALLNAME(TARGET)%は身体が麻痺して敏捷性がダウンしている…
		TCVARn:104 += 1
	ENDIF
ENDIF
;べとべとの処理
IF (TCVARn:12 & べとべと)
	PRINTFORML × %PRINT_TRANSCALLNAME(TARGET)%に粘液が纏わり付いて離れない…
	IF CFLAG:1 > 0 && (TCVARn:23 > 0 || TCVARn:25 > 0)
		PRINTFORML 　 %PRINT_TRANSCALLNAME(TARGET)%の衣装が少しずつ溶かされていく！
		LOCAL = RAND:5 + 1
		;衣装へのダメージを反映
		FONTBOLD
		PRINTFORML 　 衣装に{LOCAL}の損傷を受けた！
		FONTREGULAR
		PRINTL 
		CALL CLOTH_BATTLE_DAMAGE, LOCAL, 1
	ELSEIF TCVARn:21 > 0 || TCVARn:25 > 0
		PRINTFORML 　 %PRINT_TRANSCALLNAME(TARGET)%の衣装が少しずつ溶かされていく！
		LOCAL = RAND:5 + 1
		;衣装へのダメージを反映
		FONTBOLD
		PRINTFORML 　 衣装に{LOCAL}の損傷を受けた！
		FONTREGULAR
		PRINTL 
		CALL CLOTH_BATTLE_DAMAGE, LOCAL, 1
	ENDIF
ENDIF
;腰くだけの持続判定
IF (TCVARn:12 & 腰くだけ) && (TCVARn:12 & 気絶) == 0
	IF (TCVARn:106 > 1 && RAND:(100 - 20 * (CFLAG:TARGET:43 == 508)) < 60 + TCVARn:106 * 5) || TCVARn:106 == -999
		PRINTFORML ○ %PRINT_TRANSCALLNAME(TARGET)%の脚の震えが止まった！
		PRINTFORML 　 %PRINT_TRANSCALLNAME(TARGET)%は[腰くだけ]状態から回復した！
		TCVARn:12 -= 腰くだけ
		TCVARn:106 = 0
	ELSE
		PRINTFORML × %PRINT_TRANSCALLNAME(TARGET)%は脚が震えて思うように動けない…
		TCVARn:106 += 1
	ENDIF
ENDIF
;恍惚の持続判定
CALL PERCENT_CAL, BASE:気力, MAXBASE:気力
IF (TCVARn:12 & 恍惚) && (TCVARn:12 & 気絶) == 0
	IF (TCVARn:107 > 1 && RAND:(100 - 20 * (CFLAG:TARGET:43 == 508)) < RESULT / 4 + 35 + TCVARn:107 * 10) || TCVARn:107 == -999
		PRINTFORML ○ %PRINT_TRANSCALLNAME(TARGET)%は気持ちを持ち直した！
		PRINTFORML 　 %PRINT_TRANSCALLNAME(TARGET)%は[恍惚]状態から回復した！
		TCVARn:12 -= 恍惚
		TCVARn:107 = 0
	ELSE
		PRINTFORML × %PRINT_TRANSCALLNAME(TARGET)%は絶頂の余韻で力が入らない…
		TCVARn:107 += 1
	ENDIF
ELSE
	TCVARn:107 = 0
ENDIF
;気絶の持続判定
IF (TCVARn:12 & 気絶)
	IF BASE:体力 == 0 && BASE:気力 == 0 && BASE:性耐性 == 0
		IF TALENT:主観視点 > 0
			PRINTFORML × %PRINT_TRANSCALLNAME(TARGET)%の意識は朦朧としている…
		ELSE
			PRINTFORML × %PRINT_TRANSCALLNAME(TARGET)%の意識が戻る気配はない…
		ENDIF
		TCVARn:101 += 1
	ELSEIF TCVARn:101 > 0 && RAND:(100 - 20 * (CFLAG:TARGET:43 == 508)) < MAX(35 - CFLAG:99 * 3 + TCVARn:101 * 10, 10) || TCVARn:101 == -999
		IF TALENT:主観視点 > 0
			PRINTFORML ○ %PRINT_TRANSCALLNAME(TARGET)%は意識を持ち直した！
			PRINTFORML 　 %PRINT_TRANSCALLNAME(TARGET)%は[朦朧]状態から回復した！	
		ELSE
			PRINTFORML ○ %PRINT_TRANSCALLNAME(TARGET)%は意識を取り戻した！
			PRINTFORML 　 %PRINT_TRANSCALLNAME(TARGET)%は[気絶]状態から回復した！
		ENDIF
		TCVARn:12 -= 気絶
		TCVARn:101 = 0
	ELSE
		IF TALENT:主観視点 > 0
			PRINTFORML × %PRINT_TRANSCALLNAME(TARGET)%の意識は朦朧としている…
		ELSE
			PRINTFORML × %PRINT_TRANSCALLNAME(TARGET)%の意識が戻る気配はない…
		ENDIF
		TCVARn:101 += 1
	ENDIF
ELSE
	TCVARn:101 = 0
ENDIF

;発情の効果で体力、気力、性耐性が尽きたら敗北判定を行う
IF BASE:体力 == 0 && BASE:気力 == 0 && BASE:性耐性 == 0 && FLAG:13 > 0 && (ENEMY_TYPE_CHECK_F("MOB") == 0 && ENEMY_TYPE_CHECK_F("CITIZEN") == 0)
	IF ターン内敗北キャンセル==0
		GOTO BATTLE_LOSE
	ELSE
		;気絶していなければ気絶する
		CALL STATE_CHANGE_KIZETU, 100
	ENDIF
ENDIF

;先制攻撃中なら先制攻撃カウントが進む
IF TFLAG:24 > 0
	TFLAG:24 -= 1
;それ以外なら戦闘時間カウントが進む
ELSE
	TFLAG:0 += 1
ENDIF

