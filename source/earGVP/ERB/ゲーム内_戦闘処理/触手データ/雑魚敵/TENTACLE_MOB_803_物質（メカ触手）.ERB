@SHIELD_COUNT, ARG
#FUNCTIONS
LOCAL = 0
SIF BASE:ARG:Ｂ結界耐久力 > 0 
	LOCAL += 1
SIF BASE:ARG:Ｃ結界耐久力 > 0 
	LOCAL += 1
SIF BASE:ARG:Ｖ結界耐久力 > 0 
	LOCAL += 1
SIF BASE:ARG:Ａ結界耐久力 > 0 
	LOCAL += 1
IF LOCAL == 0
	LOCALS = 0
ELSEIF LOCAL == 1
	LOCALS = 1
ELSEIF LOCAL == 2
	LOCALS = 2
ELSEIF LOCAL == 3
	LOCALS = 3
ELSE
	LOCALS = 4
ENDIF
RETURNF LOCALS

