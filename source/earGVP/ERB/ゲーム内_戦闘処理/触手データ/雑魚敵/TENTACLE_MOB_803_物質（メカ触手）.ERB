@TENTACLE_MOB_803_ATTACK_ROUTINE
;気絶・腰くだけしてる場合、絶対に範囲に含めるように
IF (TCVARn:12 & 気絶) || (TCVARn:12 & 腰くだけ)
	SIF TCVARn:0 == 1
		TFLAG:11 |= 1
	SIF TCVARn:0 == 2
		TFLAG:11 |= 2
	SIF TCVARn:0 == 3
		TFLAG:11 |= 4
ENDIF

;現在体力がRAND最大体力より小さい時
IF FLAG:13 < RAND:(FLAG:12)
	RETURN 4	;距離を取る
ELSEIF RAND:3 == 0
	IF RAND:2 == 0
		RETURN 3	;粘液攻撃
	ELSE
		RETURN 6	;邪悪な波動
	ENDIF
ELSEIF RAND:2 == 0
	RETURN 1	;通常攻撃
ELSE
	RETURN 2	;絡みつく
ENDIF

