			ELSEIF ISMALE()
				TFLAG:10 = 1
				CALL SEX_COM1, FLAG:11, LOCAL
			;聖処女の場合もC攻め強に振り替える
			ELSEIF CHECK_HOLYVIRGIN_F()==1
				TFLAG:10 = 1
				CALL SEX_COM1, FLAG:11, LOCAL
			ELSEIF BASE:Ｖ結界耐久力 > 0 || TFLAG:20 < 0
				TFLAG:10 = 1001
				CALL SEX_SPCOM1
			;気絶中かつ意中の相手が居ない場合
			ELSEIF (TCVARn:12 & 気絶) && TALENT:交際相手 == 0
				TFLAG:10 = 1001
				CALL SEX_SPCOM1
			ELSE
				CALL SEX_SPCOM14
			ENDIF
		ENDIF
	;サブミッションファック
	CASE 1015
		;衣装の耐久度が高ければ衣装破壊を優先する
		IF CLOTH_OUTER_PER_L > 90 || CLOTH_INNER_PER_L > CLOTH_INNER_DEF_L / 2
			TFLAG:10 = 14
			CALL SEX_COM14, FLAG:11, LOCAL
		ELSE
			;男の娘の場合はA攻め強に振り替える
			IF TALENT:男の娘 > 0
				TFLAG:10 = 1
				CALL SEX_COM5, FLAG:11, LOCAL
			;オトコの場合はC攻め強に振り替える
			ELSEIF ISMALE()
				TFLAG:10 = 1
				CALL SEX_COM1, FLAG:11, LOCAL
			;選べない場合は代替
			ELSEIF BASE:Ｖ結界耐久力 > 0 || CONFIG_CHECK_MANIAC_F(14) == 0 || (TCVARn:12 & 気絶) || TFLAG:20 < 0
				TFLAG:10 = 1001
				CALL SEX_SPCOM1
			ELSE
				CALL SEX_SPCOM15
			ENDIF
		ENDIF
	;雑魚敵オリジナルコマンド
	CASE 2000 TO 2999
		SIF ENEMY_TYPE_CHECK_F("MOB") == 1 || ENEMY_TYPE_CHECK_F("CITIZEN") == 1
			TRYCALLFORM SEXCOM_MOB_{FLAG:11}_COM{ARG}, FLAG:11, LOCAL
ENDSELECT
RETURN 1

