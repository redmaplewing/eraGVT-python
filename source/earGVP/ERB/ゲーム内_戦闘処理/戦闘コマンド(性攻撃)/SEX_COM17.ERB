;アナルピストン（Ａ挿入系統からの派生限定行動）

;性コマンド分類
@SEX_TYPE_COM17
RETURN 挿入

@SEX_COM17,ARG = 0,ARG:1 = 0
;EX_COM	追加責め実行部位（ビット）
;	1：Ｃ　2：Ｖ　4：Ａ　8：Ｂ
;追加責め
CALL SEX_COMEX_RANDOM, Ａ, ARG:1
EX_COM = RESULT:0
SH_COM = RESULT:1

INSERT |= アナル
;状態異常：強拘束
SIF (TCVARn:12 & 強拘束) == 0
	CALL STATE_CHANGE_PKOUSOKU, 100

;前貼りが残っている場合はＶ追加攻めフラグを折る
SIF CFLAG:42 == 398 && CLOTH_INNER_PER > 0 && (EX_COM & 膣)
	EX_COM -= 膣
;アナルプレイはＶ挿入しない場合
SIF CONFIG_CHECK_OTHER_F(4) > 0 && (EX_COM & 膣)
	EX_COM -= 膣

;清純派なら１度だけ自動でＶ防御
SIF TALENT:清純派 > 0 && TCVARn:2 != 100 && (EX_COM & 膣)
	CALL AUTO_V_DEFENCE, TARGET

;悪堕ちキャラのペニス位置をセット
SIF ENEMY_TYPE_CHECK_F("AKUOTI") == 1 && (ISPENIS(FLAG:111))
	TFLAG:18 = アナル

;取得パラメータ計算
;ベース値の明示的初期化
REPEAT 12
	LOCAL:COUNT = 0
REND

;油断度の上昇
TFLAG:3 += 5

;射精値 550
CALL TENTACLE_SYASEI_UP, 550

;触手サイズの設定
CALL SET_TENTACLE_SIZE, FLAG:10, FLAG:11, ENEMY_TYPE_CHECK_F("AKUOTI"), FLAG:111, 17

;快A　感覚が低いうちは少なめ
IF CONFIG_CHECK_BALANCE_F(7) == 0
	IF ABL:Ａ感覚 == 0
		LOCAL:2 = 8
	ELSEIF ABL:Ａ感覚 == 1
		LOCAL:2 = 50
	ELSEIF ABL:Ａ感覚 == 2
		LOCAL:2 = 200
	ELSEIF ABL:Ａ感覚 == 3
		LOCAL:2 = 400
	ELSEIF ABL:Ａ感覚 == 4
		LOCAL:2 = 1000
	ELSEIF ABL:Ａ感覚 >= 5
		LOCAL:2 = 2000
	ENDIF
;コンフィグオンで快Ａ増加
ELSEIF CONFIG_CHECK_BALANCE_F(7) > 0
	IF ABL:Ａ感覚 == 0
		LOCAL:2 = 40
	ELSEIF ABL:Ａ感覚 == 1
		LOCAL:2 = 100
	ELSEIF ABL:Ａ感覚 == 2
		LOCAL:2 = 200
	ELSEIF ABL:Ａ感覚 == 3
		LOCAL:2 = 400
	ELSEIF ABL:Ａ感覚 == 4
		LOCAL:2 = 1000
	ELSEIF ABL:Ａ感覚 >= 5
		LOCAL:2 = 2000
	ENDIF
ENDIF
;メイン部位絶頂見込みの予測
CALL PALAM_VABCestimate(LOCAL,2,-1)


IF ENEMY_TYPE_CHECK_F("MOB") == 1 || ENEMY_TYPE_CHECK_F("CITIZEN") == 1
	TRYCALLFORM MESSAGE_MOB_{ARG}_COM17, EX_COM, SH_COM
ELSE
	;地の文：洗脳/悪堕ちキャラが操作キャラにアナルピストンをした
	SIF ENEMY_TYPE_CHECK_F("AKUOTI") == 1
		CALL MESSAGE_OTHER_SEX_COM17
	;地の文:COM17
	CALL MESSAGE_SEX_COM17, EX_COM, SH_COM
ENDIF

;結界による触手本数の変動
CALL SET_TENTACLE_POOL
;服へのダメージ
CALL CLOTH_BATTLE_DAMAGE, 2

;ベース
EXP:Ａ経験 += 1
SIF ENEMY_TYPE_CHECK_F("AKUOTI") == 0 && INCEST_F(TARGET, FLAG:10 * 100 + FLAG:11, 1) > 0
	EXP:近親交配経験 += 1
SIF ENEMY_TYPE_CHECK_F("AKUOTI") == 1 && INCEST_F(TARGET, FLAG:111) > 0
	EXP:近親交配経験 += 1


;恭順
IF ABL:従順 <= 2
	LOCAL:5 = 20
ELSEIF ABL:従順 == 3
	LOCAL:5 = 50
ELSEIF ABL:従順 == 4
	LOCAL:5 = 100
ELSEIF ABL:従順 >= 5
	LOCAL:5 = 200
ENDIF

;習得
IF ABL:奉仕精神 == 0
	LOCAL:6 = 10
ELSEIF ABL:奉仕精神 == 1
	LOCAL:6 = 25
ELSEIF ABL:奉仕精神 == 2
	LOCAL:6 = 50
ELSEIF ABL:奉仕精神 == 3
	LOCAL:6 = 100
ELSEIF ABL:奉仕精神 == 4
	LOCAL:6 = 250
ELSEIF ABL:奉仕精神 >= 5
	LOCAL:6 = 500
ENDIF

;屈服　Ａ感覚に応じて
IF ABL:Ａ感覚 == 0
	LOCAL:8 = 20
ELSEIF ABL:Ａ感覚 == 1
	LOCAL:8 = 40
ELSEIF ABL:Ａ感覚 == 2
	LOCAL:8 = 100
ELSEIF ABL:Ａ感覚 == 3
	LOCAL:8 = 200
ELSEIF ABL:Ａ感覚 == 4
	LOCAL:8 = 400
ELSEIF ABL:Ａ感覚 >= 5
	LOCAL:8 = 900 + ABL:Ａ感覚 * 20
ENDIF

;潤滑が低いと苦痛が入る
IF PALAM:潤滑 < 1000
	LOCAL:10 += 1000
ELSEIF PALAM:潤滑 < 2000
	LOCAL:10 += 200
ENDIF

;A感覚が低いと恐怖が入る
IF ABL:Ａ感覚 == 0
	LOCAL:11 = 200
ELSEIF ABL:Ａ感覚 == 1
	LOCAL:11 = 100
ELSEIF ABL:Ａ感覚 == 2
	LOCAL:11 = 50
ELSEIF ABL:Ａ感覚 == 3
	LOCAL:11 = 20
ELSE
ENDIF

;追加責め実行
IF EX_COM
	CALL SEX_COMEX, Ａ, 1, EX_COM | SH_COM
	REPEAT 12
		LOCAL:COUNT += RESULT:COUNT
	REND
ENDIF

;大量射精可能ならフィニッシュに移行
IF FLAG:15 >= FLAG:14 * 2
	TFLAG:17 = 18
;Ｖ追加責めが立っていれば両穴ピストンに移行
ELSEIF (EX_COM & Ｖ) && FLAG:15 >= FLAG:14 && BASE:Ｖ結界耐久力 == 0 && TCVARn:2 != 体勢：Ｖ防御 && (ENEMY_TYPE_CHECK_F("MOB") == 0 && ENEMY_TYPE_CHECK_F("CITIZEN") == 0) && ISFEMALE()
	TFLAG:17 = 19
;それ以外ならアナルピストン続行
ELSE
	TFLAG:17 = 17
ENDIF
;触手の行動を記録
TFLAG:20 = 17

;習得基本値
LOCAL:6 += 200

;欲情基本値
LOCAL:7 += 100

;屈服基本値
LOCAL:8 += 400

;恥情基本値
LOCAL:9 += 200

;苦痛基本値
LOCAL:10 += 100

;恐怖基本値
LOCAL:11 += 50

;体力消費基本値
LOCAL:12 += 1

;計算へ
CALL PALAM_CAL, LOCAL:0, LOCAL:1, LOCAL:2, LOCAL:3, LOCAL:4, LOCAL:5, LOCAL:6, LOCAL:7, LOCAL:8, LOCAL:9, LOCAL:10, LOCAL:11, LOCAL:12
