;A攻め強

;性コマンド分類
@SEX_TYPE_COM5
RETURN 挿入

@SEX_COM5,ARG = 0,ARG:1 = 0
;EX_COM	追加責め実行部位（ビット）
;	1：Ｃ　2：Ｖ　4：Ａ　8：Ｂ
;追加責め
CALL SEX_COMEX_RANDOM, Ａ, ARG:1
EX_COM = RESULT:0
SH_COM = RESULT:1

;前貼りが残っている場合はＶ追加攻めフラグを折る
SIF CFLAG:42 == 398 && CLOTH_INNER_PER > 0 && (EX_COM & 膣)
	EX_COM -= 膣
;アナルプレイはＶ挿入しない場合
SIF CONFIG_CHECK_OTHER_F(4) > 0 && (EX_COM & 膣)
	EX_COM -= 膣

;清純派なら１度だけ自動でＶ防御
SIF TALENT:清純派 > 0 && TCVARn:2 != 100 && (EX_COM & 膣)
	CALL AUTO_V_DEFENCE, TARGET

;射精部位フラグ:アナルを立てる
IF BASE:Ａ結界耐久力 <= 0
	TFLAG:4 = TFLAG:4 | アナル
	INSERT = INSERT | アナル
ENDIF
;Ｖ追加攻めがあるなら膣射精フラグを立てる
IF (EX_COM & 膣) && TCVARn:2 != 体勢：Ｖ防御 && BASE:Ｖ結界耐久力 <= 0
	TFLAG:4 = TFLAG:4 | 膣
	INSERT = INSERT | 膣
ENDIF
;Ｖ追加攻めがあり、挿入防御中ならワレメ射精フラグを立てる
SIF (EX_COM & 膣) && TCVARn:2 == 体勢：Ｖ防御 && BASE:Ｖ結界耐久力 <= 0
	TFLAG:4 = TFLAG:4 | ワレメ

;悪堕ちキャラのペニス位置をセット
SIF ENEMY_TYPE_CHECK_F("AKUOTI") == 1 && (ISPENIS(FLAG:111))
	TFLAG:18 = アナル

;取得パラメータ計算
;ベース値の明示的初期化
REPEAT 12
	LOCAL:COUNT = 0
REND

;油断度の上昇
TFLAG:3 += 50

;射精値 300
CALL TENTACLE_SYASEI_UP, 300

;触手サイズの設定
CALL SET_TENTACLE_SIZE, FLAG:10, FLAG:11, ENEMY_TYPE_CHECK_F("AKUOTI"), FLAG:111, 5

;快A　感覚が低いうちは少なめ
IF CONFIG_CHECK_BALANCE_F(7) == 0
	IF ABL:Ａ感覚 == 0
		LOCAL:2 = 80
	ELSEIF ABL:Ａ感覚 == 1
		LOCAL:2 = 500
	ELSEIF ABL:Ａ感覚 == 2
		LOCAL:2 = 2000
	ELSEIF ABL:Ａ感覚 == 3
		LOCAL:2 = 4000
	ELSEIF ABL:Ａ感覚 == 4
		LOCAL:2 = 10000
	ELSEIF ABL:Ａ感覚 >= 5
		LOCAL:2 = 20000
	ENDIF
;コンフィグオンで快Ａ増加
ELSEIF CONFIG_CHECK_BALANCE_F(7) > 0
	IF ABL:Ａ感覚 == 0
		LOCAL:2 = 400
	ELSEIF ABL:Ａ感覚 == 1
		LOCAL:2 = 1000
	ELSEIF ABL:Ａ感覚 == 2
		LOCAL:2 = 2000
	ELSEIF ABL:Ａ感覚 == 3
		LOCAL:2 = 4000
	ELSEIF ABL:Ａ感覚 == 4
		LOCAL:2 = 10000
	ELSEIF ABL:Ａ感覚 >= 5
		LOCAL:2 = 20000
	ENDIF
ENDIF
;メイン部位絶頂見込みの予測
CALL PALAM_VABCestimate(LOCAL,2,-1)



IF ENEMY_TYPE_CHECK_F("MOB") == 1 || ENEMY_TYPE_CHECK_F("CITIZEN") == 1
	TRYCALLFORM MESSAGE_MOB_{ARG}_COM5, EX_COM, SH_COM
	;処女なら苦痛が大量に入る
	IF TALENT:処女 > 0 && (EX_COM & 2) && TCVARn:2 != 体勢：Ｖ防御 && BASE:Ｖ結界耐久力 <= 0
		LOCAL:10 = 10000
		TALENT:処女 = -1
		CFLAG:206 = 2
		TCVARn:1 = 1
	ELSE
		LOCAL:10 = 0
	ENDIF
ELSE
	;処女なら苦痛が大量に入る
	IF TALENT:処女 > 0 && (EX_COM & 2) && TCVARn:2 != 体勢：Ｖ防御 && BASE:Ｖ結界耐久力 <= 0
		LOCAL:10 = 10000
		CALL LOSTVIRGIN
	ELSE
		LOCAL:10 = 0
	ENDIF
	;地の文：洗脳/悪堕ちキャラが操作キャラにA攻め強をした
	SIF ENEMY_TYPE_CHECK_F("AKUOTI") == 1
		CALL MESSAGE_OTHER_SEX_COM5
	;地の文：COM5
	CALL MESSAGE_SEX_COM5, EX_COM, SH_COM
ENDIF

;結界による触手本数の変動
CALL SET_TENTACLE_POOL
;服へのダメージ
CALL CLOTH_BATTLE_DAMAGE, 8

;ベース
IF EX_COM & Ａ
	EXP:Ａ経験 += 2
	SIF INCEST_F(TARGET, FLAG:10 * 100 + FLAG:11, 1) > 0
		EXP:近親交配経験 += 1
	SIF ENEMY_TYPE_CHECK_F("AKUOTI") == 1 && INCEST_F(TARGET, FLAG:111) > 0
		EXP:近親交配経験 += 1
ENDIF



;恭順
IF ABL:従順 <= 2
	LOCAL:5 = 200
ELSEIF ABL:従順 == 3
	LOCAL:5 = 500
ELSEIF ABL:従順 == 4
	LOCAL:5 = 1000
ELSEIF ABL:従順 >= 5
	LOCAL:5 = 2000
ENDIF

;習得
IF ABL:奉仕精神 == 0
	LOCAL:6 = 20
ELSEIF ABL:奉仕精神 == 1
	LOCAL:6 = 50
ELSEIF ABL:奉仕精神 == 2
	LOCAL:6 = 100
ELSEIF ABL:奉仕精神 == 3
	LOCAL:6 = 200
ELSEIF ABL:奉仕精神 == 4
	LOCAL:6 = 500
ELSEIF ABL:奉仕精神 >= 5
	LOCAL:6 = 1000
ENDIF

;屈服　Ａ感覚に応じて
IF ABL:Ａ感覚 == 0
	LOCAL:8 = 200
ELSEIF ABL:Ａ感覚 == 1
	LOCAL:8 = 400
ELSEIF ABL:Ａ感覚 == 2
	LOCAL:8 = 1000
ELSEIF ABL:Ａ感覚 == 3
	LOCAL:8 = 2000
ELSEIF ABL:Ａ感覚 == 4
	LOCAL:8 = 4000
ELSEIF ABL:Ａ感覚 >= 5
	LOCAL:8 = 9000 + ABL:Ａ感覚 * 200
ENDIF

;潤滑が低いと苦痛が入る
IF ABL:Ａ感覚 < 3
	IF PALAM:潤滑 < 100
		LOCAL:10 += 10000
	ELSEIF PALAM:潤滑 < 10000
		LOCAL:10 += 1000
	ELSE
		LOCAL:10 += 100
	ENDIF
ELSE
	IF PALAM:潤滑 < 100
		LOCAL:10 += 1000
	ELSEIF PALAM:潤滑 < 10000
		LOCAL:10 += 100
	ELSE
		LOCAL:10 += 10
	ENDIF
ENDIF
SIF BASE:Ａ結界耐久力 > 0
	LOCAL:10 = 0

;感覚が低いと恐怖が入る
IF ABL:Ａ感覚 == 0
	LOCAL:11 = 2000
ELSEIF ABL:Ａ感覚 == 1
	LOCAL:11 = 1000
ELSEIF ABL:Ａ感覚 == 2
	LOCAL:11 = 500
ELSEIF ABL:Ａ感覚 == 3
	LOCAL:11 = 200
ELSE
ENDIF
SIF BASE:Ａ結界耐久力 > 0
	LOCAL:11 = 0

;追加責め実行
IF EX_COM
	CALL SEX_COMEX, Ａ, 1, EX_COM | SH_COM
	REPEAT 12
		LOCAL:COUNT += RESULT:COUNT
	REND
ENDIF

;性耐性が残り50%以上なら派生しにくい
IF PERCENT_CAL_F(BASE:性耐性, MAXBASE:性耐性) >= 50 && RAND:2 == 0
;ＶＡ挿入成功＆射精ゲージ不足なら両穴ピストン＋強拘束状態
ELSEIF (EX_COM & Ｖ) && (EX_COM & Ａ) && FLAG:15 < FLAG:14 && BASE:Ｖ結界耐久力 == 0 && BASE:Ａ結界耐久力 == 0 && TCVARn:2 != 体勢：Ｖ防御 && (ENEMY_TYPE_CHECK_F("MOB") == 0 && ENEMY_TYPE_CHECK_F("CITIZEN") == 0) && ISFEMALE()
	TFLAG:17 = 19
	;状態異常：強拘束
	CALL STATE_CHANGE_PKOUSOKU, 100
;Ａ挿入成功＆射精ゲージ不足ならアナルピストン＋強拘束状態
ELSEIF (EX_COM & Ａ) && FLAG:15 < FLAG:14 && BASE:Ａ結界耐久力 == 0 && (ENEMY_TYPE_CHECK_F("MOB") == 0 && ENEMY_TYPE_CHECK_F("CITIZEN") == 0) && ISHOLE() == 1
	TFLAG:17 = 17
	;状態異常：強拘束
	CALL STATE_CHANGE_PKOUSOKU, 100
ELSE
	;行動予約なし
	TFLAG:17 = -1
ENDIF
;触手の行動を記録
TFLAG:20 = 5

;習得基本値
LOCAL:6 += 2000

;欲情基本値
LOCAL:7 += 0

;屈服基本値
LOCAL:8 += 4000

;恥情基本値
LOCAL:9 += 800

;苦痛基本値
LOCAL:10 += 200

;恐怖基本値
LOCAL:11 += 500

;体力消費基本値
LOCAL:12 += 200

;計算へ
CALL PALAM_CAL, LOCAL:0, LOCAL:1, LOCAL:2, LOCAL:3, LOCAL:4, LOCAL:5, LOCAL:6, LOCAL:7, LOCAL:8, LOCAL:9, LOCAL:10, LOCAL:11, LOCAL:12
