;電流

;性コマンド分類
@SEX_TYPE_COM1004
RETURN 通常

@SEX_SPCOM4
;取得パラメータ計算
;ベース値の明示的初期化
REPEAT 12
	LOCAL:COUNT = 0
REND

;油断度の上昇
TFLAG:3 += 100

;射精値 10
CALL TENTACLE_SYASEI_UP, 10

;触手サイズの設定
CALL SET_TENTACLE_SIZE, FLAG:10, FLAG:11, ENEMY_TYPE_CHECK_F("AKUOTI"), FLAG:111, 1004

;メイン部位絶頂見込みの予測
CALL PALAM_VABCestimate(LOCAL,-1)

;地の文：洗脳/悪堕ちキャラが操作キャラに電流をした
SIF ENEMY_TYPE_CHECK_F("AKUOTI") == 1
	CALL MESSAGE_OTHER_SEX_SPCOM4
	
;地の文:SPCOM4
CALL MESSAGE_SEX_SPCOM4

;結界による触手本数の変動
CALL SET_TENTACLE_POOL
;服へのダメージ
CALL CLOTH_BATTLE_DAMAGE, 20

;ベース
;屈服　マゾっ気で変化
IF ABL:マゾっ気 == 0
	LOCAL:8 = 500
ELSEIF ABL:マゾっ気 == 1
	LOCAL:8 = 1000
ELSEIF ABL:マゾっ気 == 2
	LOCAL:8 = 2000
ELSEIF ABL:マゾっ気 == 3
	LOCAL:8 = 5000
ELSEIF ABL:マゾっ気 == 4
	LOCAL:8 = 10000
ELSEIF ABL:マゾっ気 >= 5
	LOCAL:8 = 20000
ENDIF

;恐怖　従順とマゾっ気で大まかに
IF ABL:従順 < 4
	IF ABL:マゾっ気 < 4
		LOCAL:11 = 10000
	ELSE
		LOCAL:11 = 1000
	ENDIF
ELSE
	IF ABL:マゾっ気 < 4
		LOCAL:11 = 1000
	ELSE
		LOCAL:11 = 100
	ENDIF
ENDIF

;行動予約なし
TFLAG:17 = -1
;触手の行動を記録
TFLAG:20 = 1004

;習得基本値
LOCAL:6 += 0

;欲情基本値
LOCAL:7 += 0

;屈服基本値
LOCAL:8 += 5000

;恥情基本値
LOCAL:9 += 0

;苦痛基本値
LOCAL:10 += 20000

;恐怖基本値
LOCAL:11 += 2000

;体力消費基本値
LOCAL:12 += 100

;計算へ
CALL PALAM_CAL, LOCAL:0, LOCAL:1, LOCAL:2, LOCAL:3, LOCAL:4, LOCAL:5, LOCAL:6, LOCAL:7, LOCAL:8, LOCAL:9, LOCAL:10, LOCAL:11, LOCAL:12
