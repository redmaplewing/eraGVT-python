;==============================================================================
;パラメータの上昇処理
; 引数	なし。代わりにUPとLOSEBASEを参照し、終了時に初期化する
; 定数
;	二次計算PALAM	快部位の計算と絶頂処理後、個別に計算する物の前にまとめて計算するPALAMの一覧
; 変数
;	POSSIBLE_ECSTACY	絶頂する可能性があるかどうか（快部位の加算結果が絶頂しきい値を超えたなら1以上になる）
;	ECS_FLAG	絶頂抑制判定の結果フラグ( > 2000で絶頂懇願, > 1000で絶頂禁止, > 0で絶頂抑制, <= 0で絶頂可能)
;memo:この変数仕様はセンスが悪い。余裕がある時に作り直す
;	ECS_NUM		絶頂回数合計
;	BEFORE_PALAM_CVAB	快部位の加算前パラメータ（絶頂判定で先に加算してしまうので、その前に保管する）
;	PCOUNT		パラメータ参照ループ時のループカウンタ
@PALAM_UP
#DIM DYNAMIC POSSIBLE_ECSTACY
#DIM DYNAMIC ECS_FLAG
#DIM DYNAMIC ECS_NUM
#DIM BEFORE_PALAM_CVAB, 4
#DIM PCOUNT
{
#DIM CONST 二次計算PALAM =
GETNUM(PALAM, "習得"),
GETNUM(PALAM, "屈服"),
GETNUM(PALAM, "苦痛"),
GETNUM(PALAM, "恐怖")
}

;--------------------------------------------------
;快部位（ＣＶＡＢ）の絶頂処理

;様々な要素を加味して部位それぞれに補正をかける
FOR PCOUNT, 0, VARSIZE("快部位PALAM")

	;上昇値補正処理
	CALL PALAM_HOSEI, PCOUNT, UP:(快部位PALAM:PCOUNT)
	UP:(快部位PALAM:PCOUNT) = RESULT

	;PALAM補正をARGに加算する
	;memo:これは将来的にCOMMON_PALAMの呼び出し元すべてを (1)UP補正に置き換える(2)UPに加算する のいずれかで対応する
	;memo:(2)の方がシンプルだが、ここの上の各種補正がかかるようになるのでバランスが変わる
	UP:(快部位PALAM:PCOUNT) += COMMON_PALAM:(快部位PALAM:PCOUNT)

	;上昇値を加算した結果が絶頂のしきい値を超えるなら、絶頂可否判定のために補正付き計算結果を記録する
	SIF PALAM:PCOUNT + UP:(快部位PALAM:PCOUNT) > 快部位絶頂しきい値:0
		POSSIBLE_ECSTACY += PALAM:PCOUNT + UP:(快部位PALAM:PCOUNT) * (ABL:(快部位感覚:PCOUNT)) / 15 * (TALENT:(淫部位素質:PCOUNT) + 5) / 5

NEXT

;絶頂抑制判定
ECS_FLAG = FUNC_PALAM_CALC_ENDURE_ECSTACY(POSSIBLE_ECSTACY)

;快部位の絶頂チェック
ECS_NUM = 0
FOR PCOUNT, 0, VARSIZE("快部位PALAM")
	IF UP:PCOUNT > 0
		LOCAL:3 = UP:(快部位PALAM:PCOUNT)
		;部位結界チェック
		;戦闘中かつ拘束時でなければ結界は動作しない
		IF BASE:(基礎部位結界:PCOUNT) > 0 && FLAG:700 && TCVARn:0 == 0 && TFLAG:10 != 1006

			;デバッグ表示
			IF FLAG:999
				STRLENFORM {MAXBASE:(基礎部位結界:PCOUNT)}
				SETCOLOR 96, 96, 96
				PRINTFORML /* debug */ %BASENAME:(基礎部位結界:PCOUNT)%：{BASE:(基礎部位結界:PCOUNT), RESULT} - {LOCAL:3, RESULT}　= {BASE:(基礎部位結界:PCOUNT) - LOCAL:3, RESULT}
				RESETCOLOR
			ENDIF
			BASE:(基礎部位結界:PCOUNT) -= LOCAL:3
			LOCAL:3 = 0
			;戦闘中なら部位結界の状態を出力する
			SIF FLAG:700
				CALL MESSAGE_SHIELD_STATE, PCOUNT
		ENDIF
		;上昇量表示用に現在のPALAMを保存する
		BEFORE_PALAM_CVAB:PCOUNT = PALAM:(快部位PALAM:PCOUNT)
		;快部位のPALAMに結界を考慮した上昇量を加算する
		PALAM:(快部位PALAM:PCOUNT) += LOCAL:3

		;絶頂回数判定を行い、戻り値を代入する
		CALL PALAM_CALC_ECSTASY, PCOUNT, PCOUNT, ECS_FLAG
		NOWEX:(PCOUNT) = RESULT

		;絶頂しているなら、減衰計算用変数をリセット
		SIF NOWEX:(PCOUNT) > 0
			MAX_PALAM:(PCOUNT) = 0
	ENDIF

	;絶頂による屈服の増加
	ECS_NUM += NOWEX:PCOUNT
NEXT

;触手による拡張チェック
CALL PALAM_CALC_GAPING

;ＣＶＡＢのPALAM補正値は利用が終わったのでクリアする
FOR PCOUNT, 0, VARSIZE("快部位PALAM")
	COMMON_PALAM:(PCOUNT) = 0
NEXT

;動画撮影フラグの処理
IF FLAG:71 > 0 || GETBATTLESITUATION("常時撮影")
	;膣内射精されたところを見られた
	SIF (STAIN:3 & 4)
		SETBIT TFLAG:21,4
	;アナルに射精されたところを見られた
	SIF (STAIN:4 & 4)
		SETBIT TFLAG:21,5
	;精液ぶっかけされたところを見られた
	SIF (STAIN:0 & 4) || (STAIN:1 & 4) || (STAIN:2 & 4)
		SETBIT TFLAG:21,6
	;絶頂したところを見られた
	SIF NOWEX:Ｃ絶頂 + NOWEX:Ｖ絶頂 + NOWEX:Ａ絶頂 + NOWEX:Ｂ絶頂
		SETBIT TFLAG:21,8
ENDIF

;--------------------------------------------------
;習得・屈服・苦痛・恐怖の増加処理
;（潤滑・欲情・恥情・恭順は後で個別に計算）

;絶頂回数による屈服上昇値のボーナス
SIF ECS_NUM > 0
	UP:屈服 += MIN(ECS_NUM * 5000, 20000)

FOR PCOUNT, 0, VARSIZE("二次計算PALAM")

	;上昇値補正処理
	CALL PALAM_HOSEI, PCOUNT, UP:(二次計算PALAM:PCOUNT)
	UP:(二次計算PALAM:PCOUNT) = RESULT

	;PALAM補正をARGに加算する
	UP:(二次計算PALAM:PCOUNT) += COMMON_PALAM:(二次計算PALAM:PCOUNT)
	COMMON_PALAM:(二次計算PALAM:PCOUNT) = 0

NEXT

;奉仕を選択した場合の習得上昇値ボーナス
SIF TCVARn:2 == 体勢：奉仕する
	UP:習得 += 150 + 15 * (ABL:従順 + ABL:奉仕精神 * 2)


;----------------------------------------------------------
;射精、噴乳の処理

;触手の射精チェック
IF FLAG:700 == 1
	CALL TENTACLE_SYASEI_CHECK
	SIF (TCVARn:12 & 排卵) && (TFLAG:4 & 膣)
		RESULT:1 *= 4
	UP:潤滑 += RESULT:0
	UP:屈服 += RESULT:1
	UP:恭順 += RESULT:2
	UP:欲情 += RESULT:3
ENDIF

;キャラの射精チェック
CALL PALAM_CALC_EJAC

;キャラの噴乳チェック
CALL PALAM_CALC_MILK_SQIRT
PRINTL 

;----------------------------------------------------------
;恥情の取得

;衣服の損傷LVによる恥情の獲得
CALL PALAM_TIJOU_CLOTH_DAMAGE
UP:恥情 += RESULT

;快Ｃ,快Ｖ,快Ａ,快Ｂの上昇値,絶頂の状態で計算する
CALL PALAM_TIJOU, UP:快Ｃ, UP:快Ｖ, UP:快Ａ, UP:快Ｂ
UP:恥情 += RESULT

;上昇値補正処理
CALL PALAM_HOSEI, GETNUM(PALAM, "恥情"), UP:恥情
UP:恥情 = RESULT

;----------------------------------------------------------
;欲情の主計算

;快Ｃ,快Ｖ,快Ａ,快Ｂ,恥情の上昇値,苦痛の上昇値(マゾっ気あり),絶頂の状態で計算する
CALL PALAM_YOKUJOU, UP:快Ｃ, UP:快Ｖ, UP:快Ａ, UP:快Ｂ, UP:恥情, UP:苦痛
UP:欲情 += RESULT

;上昇値補正処理
CALL PALAM_HOSEI, GETNUM(PALAM, "欲情"), UP:欲情
UP:欲情 = RESULT

;----------------------------------------------------------
;潤滑の主計算

;欲情の上昇値で計算する
CALL PALAM_JUNKATU, UP:欲情
UP:潤滑 += RESULT

;上昇値補正処理
CALL PALAM_HOSEI, GETNUM(PALAM, "潤滑"), UP:潤滑
UP:潤滑 = RESULT

;----------------------------------------------------------
;恭順の主計算

;快C,快V,快A,快Bの上昇値,絶頂の状態で計算する
CALL PALAM_KYOUJUN, UP:快Ｃ, UP:快Ｖ, UP:快Ａ, UP:快Ｂ
UP:恭順 += RESULT

;触手中毒と触手の虜による恭順上昇値のボーナス
SIF ABL:触手中毒 > 0
	UP:恭順 += MIN(ECS_NUM * 1500 * ABL:触手中毒, 30000)
SIF TALENT:触手の虜 > 0
	UP:恭順 += MIN(ECS_NUM * 1500, 6000)

;上昇値補正処理
CALL PALAM_HOSEI, GETNUM(PALAM, "恭順"), UP:恭順
UP:恭順 = RESULT

;----------------------------------------------------------
;気絶中は屈服、恥情、苦痛、恐怖の上昇が抑えられる
IF (TCVARn:12 & 気絶)
	TIMES UP:屈服, 0.25
	TIMES UP:恥情, 0.25
	TIMES UP:苦痛, 0.25
	TIMES UP:恐怖, 0.25
;恍惚の場合は恭順、習得、欲情、屈服が上昇しやすい
ELSEIF (TCVARn:12 & 恍惚)
	TIMES UP:恭順, 1.25
	TIMES UP:習得, 1.25
	TIMES UP:欲情, 1.25
	TIMES UP:屈服, 1.25
ENDIF

;絶頂回数と珠の取得
LOCAL = 0
REPEAT 感覚数
	SIF NOWEX:COUNT > 0
		LOCAL += 1
REND
EXP:絶頂経験 += NOWEX:Ｃ絶頂 * LOCAL
JUEL:快Ｃ += 1000 * NOWEX:Ｃ絶頂 * LOCAL
EXP:絶頂経験 += NOWEX:Ｖ絶頂 * LOCAL
JUEL:快Ｖ += 1000 * NOWEX:Ｖ絶頂 * LOCAL
EXP:絶頂経験 += NOWEX:Ａ絶頂 * LOCAL
JUEL:快Ａ += 1000 * NOWEX:Ａ絶頂 * LOCAL
EXP:絶頂経験 += NOWEX:Ｂ絶頂 * LOCAL
JUEL:快Ｂ += 1000 * NOWEX:Ｂ絶頂 * LOCAL

;絶頂回数に応じて油断度を上昇
TFLAG:3 += 50 * LOCAL

;経験の加算
;露出快楽経験：恥情と欲情が一定以上
SIF UP:恥情 > 2000 && UP:欲情 > 2000
	EXP:露出快楽経験 += 1

;奉仕快楽経験：奉仕体制か奉仕コマンドで欲情が一定以上
SIF UP:欲情 > 2000 && (TCVARn:2 == 体勢：奉仕する || SELECTCOM >= 100 && SELECTCOM < 200)
	EXP:奉仕快楽経験 += 1

;苦痛快楽経験：苦痛と欲情が一定以上
SIF UP:苦痛 > 2000 && UP:欲情 > 2000
	EXP:苦痛快楽経験 += 1

;多重絶頂＆単絶頂
CALL MESSAGE_SEX_ECSTASY, NOWEX:Ｃ絶頂, NOWEX:Ｖ絶頂, NOWEX:Ａ絶頂, NOWEX:Ｂ絶頂

;絶頂禁止
IF ECS_FLAG > 1000
	CALL MESSAGE_SEX_ECSTASY_PROHIBITION

	;絶頂懇願
	SIF ECS_FLAG > 2000
		CALL MESSAGE_SEX_ECSTASY_ENTREATY

;絶頂抑制
ELSEIF ECS_FLAG > 0 && FLAG:700
	CALL MESSAGE_SEX_ECSTASY_INHIBITION, ECS_FLAG
ENDIF

;絶頂による状態異常
SIF ECS_NUM && FLAG:700 > 0
	CALL STATE_CHANGE_EX, ECS_NUM

;電流による状態異常
SIF TFLAG:20 == 1004
	CALL STATE_CHANGE_DENGEKI

;媚薬効果のある行動を受けた場合
SIF TFLAG:20 == 6 || TFLAG:20 == 1000 || TFLAG:20 == 1001
	CALL STATE_CHANGE_HATUJOU, 100

;強制気絶の行動
IF (TFLAG:20 == 1012 || TFLAG:20 == 1015) && (TCVARn:12 & 気絶) == 0
	CALL STATE_CHANGE_KIZETU, 100
;特定コマンドを受けると目が覚める
ELSEIF (TFLAG:20 == 8 || TFLAG:20 == 9 || TFLAG:20 == 12 || TFLAG:20 == 1009 || TFLAG:20 == 1010 || TFLAG:20 == 1013) && (TCVARn:12 & 気絶) && (BASE:体力 > 0 || BASE:気力 > 0 || BASE:性耐性 > 0)
	TCVARn:101 = -999
ENDIF

;パラメータ上昇量への性格補正
CALL PALAM_CALC_PERSONALITY_ADJUST

;----------------------------------------------------------
;パラメータ上昇結果の画面表示
IF SUMARRAY(UP) && CONFIG_CHECK_SCREEN_F(1) > 0
	WAIT
	CALL SHORTLINE
	CALL PALAM_UP_DISPLAY_CALCULATION, BEFORE_PALAM_CVAB, ECS_FLAG
	CALL SHORTLINE
	PRINTL 
ENDIF

;快部位以外取得パラメータを上昇する
FOR PCOUNT, 0, VARSIZE("部位以外調教PALAM")
	IF UP:(部位以外調教PALAM:PCOUNT) > 0
		PALAM:(部位以外調教PALAM:PCOUNT) += MIN(UP:(部位以外調教PALAM:PCOUNT),PALAM上限)
		;CALL PALAM_LIMIT, LOCAL:0 + PALAM始点 - 感覚数, ARG:(LOCAL:0)
	ENDIF
NEXT

;体力、気力、性耐性の減算
;体力は苦痛から、気力は屈服と恐怖と恥情から、性耐性は恭順と欲情からそれぞれ減算値を求める
IF FLAG:700 == 1 && (TCVARn:0 == 0 || (TCVARn:41 != 0 && CFLAG:(CFLAG:1==0 ? 40 # 41) == 199))
	CALL PALAM_TAIRYOKUDOWN, UP:苦痛, LOSEBASE:体力
	CALL PALAM_KIRYOKUDOWN, UP:屈服, UP:恐怖, UP:恥情
	CALL PALAM_SEITAISEIDOWN, UP:恭順, UP:欲情
	PRINTL 
	IF UP:苦痛 + LOSEBASE:体力 + UP:屈服 + UP:恐怖 + UP:欲情
		;被弾するたびに、防御基礎値に応じてＥＸゲージが上昇する
		SIF CFLAG:1 != 2
			TCVARn:6 += LIMIT(SQRT(MAX(BASE:防御 - 100,0)), 0, 20) + 5
	ENDIF
ENDIF

;刻印の取得(※クズ市民戦での取得は判定を厳しく見る)
;快楽刻印　一定量の欲情
CALL GOT_SEX_MARK_CHECK, GETNUM(MARK,"快楽刻印"), UP:欲情, 快楽刻印判定基礎値, MARK:快楽刻印防止, 快楽刻印防止係数, 快楽刻印クズ市民補正

;苦痛刻印　一定量の苦痛
CALL GOT_SEX_MARK_CHECK, GETNUM(MARK,"苦痛刻印"), UP:苦痛, 苦痛刻印判定基礎値, MARK:苦痛刻印防止, 苦痛刻印防止係数, 苦痛刻印クズ市民補正

;屈服刻印　一定量の屈服
CALL GOT_SEX_MARK_CHECK, GETNUM(MARK,"屈服刻印"), UP:屈服, 屈服刻印判定基礎値, MARK:屈服刻印防止, 屈服刻印防止係数, 屈服刻印クズ市民補正

;恐怖刻印　一定量の恐怖
CALL GOT_SEX_MARK_CHECK, GETNUM(MARK,"恐怖刻印"), UP:恐怖, 恐怖刻印判定基礎値, MARK:恐怖刻印防止, 恐怖刻印防止係数, 恐怖刻印クズ市民補正

;恥辱刻印　一定量の恥情
CALL GOT_SEX_MARK_CHECK, GETNUM(MARK,"恥辱刻印"), UP:恥情, 恥辱刻印判定基礎値, MARK:恥辱刻印防止, 恥辱刻印防止係数, 恥辱刻印クズ市民補正

;理性強度低下による口上分岐
CALL MESSAGE_BRANCH_MESSAGE_FAITH_DOWN

;実績
CALL GET_STATE_EXPUP,TARGET

;搾精用ＨＰチェック
SIF FLAG:13 <= 0 && FLAG:700 == 1
	JUMP SOURCE_CHECK

;敵（と観衆）の反応
CALL PALAM_UP_ENEMY_REACTION

;変身中かつ処女でないなら、変身時非処女を付与
SIF CFLAG:1 > 0 && TALENT:処女 == -1 && ISFEMALE() && TALENT:変身時非処女 == 0
	TALENT:変身時非処女 = 1

;最後に、UPとLOSEBASEをクリアする
VARSET UP
VARSET LOSEBASE

;==============================================================================
;以下、関数内で呼ばれるサブ関数
;==============================================================================

;--------------------------------------------------
;パラメータ上昇値の補正処理
; 引数
;	PALAMID	補正対象のPALAMのID
;	UPVALUE	上昇値の実値（UP:PALAMIDの値を想定）
@PALAM_HOSEI, PALAMID, UPVALUE
#DIM PALAMID
#DIM UPVALUE
IF UPVALUE > 0

	;感覚LV6以上補正（快部位のみ）
	IF MATCH(快部位PALAM, PALAMID)
		CALL PALAM_OVERFEEL, TARGET, PALAMID
		UPVALUE *= RESULT / 100
	ENDIF

	;体勢に関する補正
	CALL PALAM_HOSEI_POSE, UPVALUE
	UPVALUE = RESULT

	;観衆の有無による補正（恥情のみ）
	IF PALAMID == GETNUM(PALAM, "恥情")
		IF FLAG:71 || GETBATTLESITUATION("常時撮影")
			UPVALUE = UPVALUE * (360 + FLAG:71 * 40 + FLAG:70 * 20) / 100
		ELSEIF FLAG:70
			UPVALUE = UPVALUE * (180 + FLAG:70 * 20) / 100
		ENDIF
	ENDIF

	;性耐性に関する補正（潤滑以外すべて）
	IF PALAMID != GETNUM(PALAM, "潤滑")
		CALL PALAM_HOSEI_SEITAISEI, UPVALUE
		UPVALUE = RESULT
	ENDIF

	;素質に関する補正
	CALL PALAM_HOSEI_TALENT, PALAMID, UPVALUE
	UPVALUE = RESULT

	;性格に関する補正
	CALL PALAM_HOSEI_SEIKAKU, PALAMID, UPVALUE
	UPVALUE = RESULT

	;触手に関する補正
	CALL PALAM_HOSEI_TENTACLE, PALAMID, UPVALUE
	UPVALUE = RESULT

	;触手中毒に関する補正（屈服・欲情・恭順のみ）
	IF PALAMID == GETNUM(PALAM, "屈服") || PALAMID == GETNUM(PALAM, "欲情") || PALAMID == GETNUM(PALAM, "恭順")
		CALL PALAM_HOSEI_POISONING_TENTACLE, UPVALUE
		UPVALUE = RESULT
	ENDIF

	;ランダム性付与
	CALL PALAM_HOSEI_RANDOM, UPVALUE
	UPVALUE = RESULT

	;下限値の設定
	SIF UPVALUE <= 0
		UPVALUE = 1
ENDIF

RETURN UPVALUE

;--------------------------------------------------
;性耐性に関する補正
;性耐性の残りが少なくなってくると取得値が大きくなってくる
@PALAM_HOSEI_SEITAISEI, ARG
LOCAL = 0
IF BASE:性耐性 > 0
	CALL PERCENT_CAL, BASE:性耐性, MAXBASE:性耐性
	LOCAL = RESULT
ENDIF

IF LOCAL > 80
ELSEIF LOCAL > 60
	TIMES ARG, 1.10
ELSEIF LOCAL > 40
	TIMES ARG, 1.20
ELSEIF LOCAL > 20
	TIMES ARG, 1.35
ELSEIF	LOCAL > 10
	TIMES ARG, 1.50
ELSE
	TIMES ARG, 1.70
ENDIF

RETURN ARG

;--------------------------------------------------
;素質に関する補正
@PALAM_HOSEI_TALENT, ARG:0, ARG:1
SELECTCASE ARG:0
	;敏感、鈍感など
	CASE 0
	;快C
		IF TALENT:Ｃ敏感 > 0
			TIMES ARG:1, 1.25
		ELSEIF TALENT:Ｃ鈍感 > 0
			TIMES ARG:1, 0.75
		ENDIF
		SIF TALENT:淫核 > 0
			TIMES ARG:1, 1.50
	CASE 1
	;快V
		IF TALENT:Ｖ敏感 > 0
			TIMES ARG:1, 1.25
		ELSEIF TALENT:Ｖ鈍感 > 0
			TIMES ARG:1, 0.75
		ENDIF
		SIF TALENT:淫壷 > 0
			TIMES ARG:1, 1.50
	CASE 2
	;快A
		IF TALENT:Ａ敏感 > 0
			TIMES ARG:1, 1.25
		ELSEIF TALENT:Ａ鈍感 > 0
			TIMES ARG:1, 0.75
		ENDIF
		SIF TALENT:淫尻 > 0
			TIMES ARG:1, 1.50
	CASE 3
	;快B
		IF TALENT:Ｂ敏感 > 0
			TIMES ARG:1, 1.25
		ELSEIF TALENT:Ｂ鈍感 > 0
			TIMES ARG:1, 0.75
		ENDIF
		IF TALENT:貧乳 == 2
			TIMES ARG:1, 0.75
		ELSEIF TALENT:貧乳 == 1
			TIMES ARG:1, 0.80
		ELSEIF TALENT:巨乳 == 5
			TIMES ARG:1, 1.40
		ELSEIF TALENT:巨乳 == 4
			TIMES ARG:1, 1.35
		ELSEIF TALENT:巨乳 == 3
			TIMES ARG:1, 1.30
		ELSEIF TALENT:巨乳 == 2
			TIMES ARG:1, 1.25
		ELSEIF TALENT:巨乳 == 1
			TIMES ARG:1, 1.20
		ENDIF
		SIF TALENT:淫乳 > 0
			TIMES ARG:1, 1.50
	CASE 10
	;潤滑
		IF TALENT:濡れやすい > 0
			TIMES ARG:1, 2.00
		ELSEIF TALENT:濡れにくい > 0
			TIMES ARG:1, 0.50
