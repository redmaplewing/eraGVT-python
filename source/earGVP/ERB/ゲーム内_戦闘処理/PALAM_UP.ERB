	IF CFLAG:201 == 0
		CFLAG:201 = 1
		EXP:異常経験 += 1
		PRINTFORML 異常経験＋1
	ENDIF
	;噴乳経験を加算して表示
	EXP:噴乳経験 += SQIRT_NUM
	PRINTFORML 噴乳経験＋{SQIRT_NUM}
	PRINTL 
ENDIF

;噴乳値上昇量を表示したが噴乳しなかった場合、空行1行開ける
SIF UP:快Ｂ && SQIRT_NUM == 0 && CONFIG_CHECK_SCREEN_F(1) > 0
