;--------------------------------------------------
;絶頂耐久、絶頂禁止、絶頂懇願の判定
; 引数
;	BASE_PALAM	絶頂可能性のある快部位PALAMの補正付き合計値（耐久計算の元手）
; 変数
;	ENDURE_FACTOR	絶頂耐久の計算値
;	BEGGING_FACTOR	絶頂懇願の計算値
; 戻り値：基本的にENDURE_FACTORを返す
;	> 2000で絶頂懇願
;	> 1000で絶頂禁止
;	> 0で絶頂抑制
;	<= 0で絶頂可能
@FUNC_PALAM_CALC_ENDURE_ECSTACY, BASE_PALAM
#FUNCTION
#DIM BASE_PALAM
#DIM ENDURE_FACTOR
#DIM BEGGING_FACTOR

;そもそもどの部位も全然絶頂に至ってないなら負数を返す
SIF BASE_PALAM <= 0
	RETURNF -1

;計算開始
;補正付きPALAMに欲望Lvと触手中毒Lvによる補正を掛ける
ENDURE_FACTOR = BASE_PALAM * (ABL:欲望 + 5) / 10
ENDURE_FACTOR = ENDURE_FACTOR * (ABL:触手中毒 + 5) / 10
;戦闘中なら触手の射精状態と精液中毒Lvによる補正を掛ける
SIF FLAG:700
	ENDURE_FACTOR = ENDURE_FACTOR * (ABL:精液中毒 * (FLAG:15 / FLAG:14) + 10) / 15
;現在の恭順・欲情・屈服による補正を掛ける
ENDURE_FACTOR = ENDURE_FACTOR * (PALAMLV_F(PALAM:恭順) + 25) / 30
ENDURE_FACTOR = ENDURE_FACTOR * (PALAMLV_F(PALAM:欲情) + 20) / 25
ENDURE_FACTOR = ENDURE_FACTOR * (PALAMLV_F(PALAM:屈服) + 25) / 30
;性耐性と気力によって割り引く
ENDURE_FACTOR /= SQRT(LIMIT(BASE:性耐性 * 4, 1, 250) * LIMIT(BASE:気力 / 4, 1, 2500)) / 2 + 10
;ここまでの計算値を32～240の値域に揃える
ENDURE_FACTOR = LIMIT(ENDURE_FACTOR, 32, 240)

;耐える選択中なら絶頂しにくくなる
SIF TCVARn:2 == 体勢：耐える
	TIMES ENDURE_FACTOR, 0.65
;なすがまま選択中なら絶頂しやすくなる
SIF TCVARn:2 == 体勢：なすがまま
	TIMES ENDURE_FACTOR, 1.25
;射精ゲージが限界なら絶頂しやすくなる
IF BASE:射精 >= MAXBASE:射精 * 2
	TIMES ENDURE_FACTOR, 1.5
ELSEIF BASE:射精 >= MAXBASE:射精
	TIMES ENDURE_FACTOR, 1.25
ENDIF
;受け入れる、または気絶中なら抑制できない
SIF TCVARn:2 == 体勢：受け入れる || (TCVARn:12 & 気絶)
	ENDURE_FACTOR = 256

;デバッグ用：確率表示
IF FLAG:999 == 1
	SETCOLOR 96, 96, 96
	PRINTFORML /* debug */ 絶頂確率{ENDURE_FACTOR, 3} / 256
	RESETCOLOR
ENDIF

;絶頂抑制状態を求め、絶頂を抑制された場合は欲情上昇値を増やす
;（元々の条件式がバグっていてドキュメントも見つからないので推定）
IF TCVARn:40 > 0
	;焦らし嬲り中なら絶頂禁止とし、欲情上昇値に大幅ボーナスを掛ける
	UP:欲情 = UP:欲情 * 3 / 2
	ENDURE_FACTOR += 1000
ELSE
	;焦らし嬲り中でなければ、確率で絶頂可能かを求める
	IF ENDURE_FACTOR > RAND:256
		ENDURE_FACTOR = 0
	ELSE
		;絶頂抑制なら欲情上昇値に微ボーナス
		UP:欲情 = UP:欲情 * 6 / 5
	ENDIF
ENDIF

;絶頂禁止状態なら、絶頂懇願判定を行う
IF ENDURE_FACTOR >= 1000
	;恭順・屈服の上昇値を倍にする
	;（元々の条件式がバグっていてドキュメントも見つからないので推定）
	UP:恭順 *= 2
	UP:屈服 *= 2

	;絶頂懇願の判定値を計算する
	BEGGING_FACTOR = BASE_PALAM / 800 * (ABL:従順 * 3 + ABL:欲望 * 4 + ABL:触手中毒 * 3 + 10) / 10
	BEGGING_FACTOR = BEGGING_FACTOR * (PALAMLV_F(PALAM:恭順) + 25) / 30
	BEGGING_FACTOR = BEGGING_FACTOR * (PALAMLV_F(PALAM:欲情) + 20) / 25
	BEGGING_FACTOR = BEGGING_FACTOR * (PALAMLV_F(PALAM:屈服) + 25) / 30
	BEGGING_FACTOR = BEGGING_FACTOR * (TALENT:触手の虜 + 1)
	BEGGING_FACTOR = LIMIT(BEGGING_FACTOR, 32, 240)

	;デバッグ用：確率表示
	IF FLAG:999 == 1
		SETCOLOR 96, 96, 96
		PRINTFORML /* debug */ 懇願確率{BEGGING_FACTOR, 3} / 256
		RESETCOLOR
	ENDIF

	;確率で絶頂懇願するかを求める
	SIF BEGGING_FACTOR > RAND:256
		ENDURE_FACTOR += 1000
ENDIF

;戦闘中でも絶頂禁止状態でもなければ耐えない
SIF ENDURE_FACTOR > 0 && ENDURE_FACTOR < 1000 && FLAG:700 == 0
	ENDURE_FACTOR = 0

;計算結果を返す
RETURNF ENDURE_FACTOR

