;--------------------------------------------------
;快部位の絶頂チェック
; 引数
;	PALAM_ID	PALAMの添字
;	NOWEX_ID	NOWEXの添字
;	IS_FORBID_EX	絶頂禁止状態かどうか
; 変数
;	PCOUNT	ループカウンタ
@PALAM_CALC_ECSTASY, PALAM_ID, NOWEX_ID, IS_FORBID_EX
#DIM PALAM_ID
#DIM NOWEX_ID
#DIM IS_FORBID_EX
#DIM PCOUNT

;絶頂禁止状態なら処理を打ち切る
SIF IS_FORBID_EX > 0
	RETURN 0

;絶頂のしきい値を高い順から見ていく
FOR PCOUNT, VARSIZE("快部位絶頂しきい値") - 1, -1, -1
	;しきい値を超えたなら
	IF PALAM:(PALAM_ID) >= 快部位絶頂しきい値:PCOUNT

		;PALAMを最低しきい値分減らす
		PALAM:(PALAM_ID) -= 快部位絶頂しきい値:0

		;減らしてもなお最低しきい値超え（＝強絶頂以上）なら、最低しきい値-1に設定してギリギリ絶頂しないように
		SIF PALAM:(PALAM_ID) >= 快部位絶頂しきい値:0
			PALAM:(PALAM_ID) = 快部位絶頂しきい値:0 - 1

		;今見ていたしきい値が何番目かが、そのまま絶頂の強さなので戻り値とする（0始まりなので+1）
		RETURN PCOUNT + 1
	ENDIF
NEXT

;----------------------------------------------------------
;キャラの射精チェック
; 変数
;	EJAC_VALUE	射精加算量の計算結果
;	EJAC_NUM	射精回数の計算結果
@PALAM_CALC_EJAC
#DIM EJAC_VALUE
#DIM EJAC_NUM

;ふたなりでも成熟したオトコでもないなら、射精はできない
SIF (TALENT:ふたなり == 0 && (ISFEMALE() || TALENT:未熟 == 1))
	RETURN 0

;快Ｃ上昇値があるなら、Ｃ絶頂回数の補正を付けて射精値に加算する
IF UP:快Ｃ
	EJAC_VALUE =  UP:快Ｃ + 500 * (NOWEX:Ｃ絶頂 + 1)
	;「戦闘中に調教ステータスの上昇を表示する」なら、射精値上昇量を表示
	IF CONFIG_CHECK_SCREEN_F(1) > 0
		FONTBOLD
		PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%の射精値＋{EJAC_VALUE}
		FONTREGULAR
	ENDIF
	BASE:射精 +=EJAC_VALUE
ENDIF

;大量射精したか
IF BASE:射精 >= MAXBASE:射精 * 2 && NOWEX:Ｃ絶頂 > 0
	EJAC_NUM = 2
	BASE:射精 = 0
	UP:欲情 += 10000
	UP:屈服 += 8000
	UP:恥情 += 8000
	LOSEBASE:体力 += 600
;（通常の）射精したか
ELSEIF BASE:射精 >= MAXBASE:射精 && NOWEX:Ｃ絶頂 > 0
	EJAC_NUM = 1
	BASE:射精 = MAX(BASE:射精 - MAXBASE:射精, 0)
	UP:欲情 += 5000
	UP:屈服 += 4000
	UP:恥情 += 4000
	LOSEBASE:体力+= 300
ELSE
	EJAC_NUM = 0
ENDIF

;射精したなら
IF EJAC_NUM
	;地の文；キャラが（大量）射精した
	CALLFORM MESSAGE_SEX_CHARA_SYASEI\@ EJAC_NUM == 2 ?_HI#\@
	;地の文：洗脳/悪堕ちキャラが操作キャラの（大量）射精を見た
	SIF ENEMY_TYPE_CHECK_F("AKUOTI") == 1
		CALLFORM MESSAGE_OTHER_SEX_CHARA_SYASEI\@ EJAC_NUM == 2 ?_HI#\@
	;現在の性別か元の性別のどちらかがオトコでなく、その状態での射精が初であれば異常経験獲得
	IF CFLAG:200 == 0 && (ISFEMALE() || CHARATALENT_F(TARGET,0,"オトコ") == 0)
		CFLAG:200 = 1
		EXP:異常経験 += 1
		PRINTFORML 異常経験＋1
	ENDIF
	;射精経験を加算して表示
	EXP:射精経験 += EJAC_NUM
	PRINTFORML 射精経験＋{EJAC_NUM}
	PRINTL 
ENDIF

;射精値上昇量を表示したが射精しなかった場合、空行1行開ける
SIF UP:快Ｃ && EJAC_NUM == 0 && CONFIG_CHECK_SCREEN_F(1) > 0
	PRINTL 

;----------------------------------------------------------
;キャラの噴乳チェック
; 変数
;	SQIRT_VALUE	噴乳加算量の計算結果
;	SQIRT_NUM	噴乳回数の計算結果
@PALAM_CALC_MILK_SQIRT
#DIM SQIRT_VALUE
#DIM SQIRT_NUM

;母乳体質でないなら、噴乳はできない
SIF TALENT:母乳体質 != 1
	RETURN 0

;快Ｂ上昇値があるなら、Ｂ絶頂回数の補正を付けて噴乳値に加算する
IF UP:快Ｂ
	SQIRT_VALUE = (UP:快Ｂ / 4 + 500 * (NOWEX:Ｂ絶頂 + 1))
	;「戦闘中に調教ステータスの上昇を表示する」なら、噴乳値上昇量を表示
	IF  CONFIG_CHECK_SCREEN_F(1) > 0
		FONTBOLD
		PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%の噴乳値＋{SQIRT_VALUE}
		FONTREGULAR
	ENDIF
	BASE:噴乳 += SQIRT_VALUE
ENDIF

;大量噴乳したか
IF BASE:噴乳 >= MAXBASE:噴乳 * 2 && NOWEX:Ｂ絶頂 > 0
	SQIRT_NUM = 2
	BASE:噴乳 = MAXBASE:噴乳 - 1
	UP:恭順 += 2000
	UP:欲情 += 2000
	UP:恥情 += 2000
;（通常の）噴乳したか
ELSEIF BASE:噴乳 >= MAXBASE:噴乳 && NOWEX:Ｂ絶頂 > 0
	SQIRT_NUM = 1
	BASE:噴乳 = BASE:噴乳 - MAXBASE:噴乳
	UP:恭順 += 1000
	UP:欲情 += 1000
	UP:恥情 += 1000
ELSE
	SQIRT_NUM = 0
ENDIF

;噴乳したなら
IF SQIRT_NUM
	;地の文；キャラが（大量）噴乳した
	CALLFORM MESSAGE_SEX_CHARA_HUNNYU\@ SQIRT_NUM == 2 ?_HI#\@
	;地の文：洗脳/悪堕ちキャラが操作キャラの（大量）噴乳を見た
	SIF ENEMY_TYPE_CHECK_F("AKUOTI") == 1
		CALLFORM MESSAGE_OTHER_SEX_CHARA_HUNNYU\@ SQIRT_NUM == 2 ?_HI#\@
