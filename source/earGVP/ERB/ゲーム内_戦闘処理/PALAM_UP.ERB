;--------------------------------------------------
;パラメータ上昇結果の表示
; 引数
;	BEFORE_PALAM_CVAB	快部位の加算前パラメータ（絶頂判定で加算する前に保管した値）
;	ECS_FLAG	絶頂したか、絶頂を抑制されているか（正の値なら絶頂抑制中）
; 変数
;	DISP_PALAM	計算前のパラメータとして表示する値
;	PADDING_P	パラメータの表示幅
;	PADDING_U	上昇値の表示幅
;	LCOUNT		ループカウンタ
@PALAM_UP_DISPLAY_CALCULATION, BEFORE_PALAM_CVAB, ECS_FLAG
#DIM REF BEFORE_PALAM_CVAB
#DIM ECS_FLAG
#DIM DISP_PALAM
#DIM PADDING_P
#DIM PADDING_U
#DIM LCOUNT

;PALAM部分とUP部分の表示桁数を合わせるために出力幅を先に求める
;最低値は4文字分
PADDING_U = 4
PADDING_P = 4
FOR LCOUNT, 0, VARSIZE("調教PALAM")
	;快部位のPALAMは絶頂判定の際に加算済みなので、保存していた加算前の値を持ってくる
	IF MATCH(快部位PALAM, LCOUNT)
		DISP_PALAM = BEFORE_PALAM_CVAB:LCOUNT
	;それ以外のPALAMはまだ加算前なのでそのまま
	ELSE
		DISP_PALAM = PALAM:LCOUNT
	ENDIF
	STRLENFORM {UP:(調教PALAM:LCOUNT)}
	SIF RESULT > PADDING_U
		PADDING_U = RESULT
	STRLENFORM {DISP_PALAM + UP:(調教PALAM:LCOUNT)}
	SIF RESULT > PADDING_P
		PADDING_P = RESULT
NEXT

;各パラメータと上昇値の表示処理
FOR LCOUNT, 0, VARSIZE("調教PALAM")
	;パラメータ上昇があるものだけ表示する
	IF UP:(調教PALAM:LCOUNT) > 0
		;快部位のPALAM
		IF MATCH(快部位PALAM, LCOUNT)
			DISP_PALAM = BEFORE_PALAM_CVAB:LCOUNT
		;それ以外のPALAM
		ELSE
			DISP_PALAM = PALAM:(調教PALAM:LCOUNT)
		ENDIF
		;表示の左側（パラメータ名：現在値 + 上昇値）はどのPALAMでも一緒
		PRINTFORM %PALAMNAME:(調教PALAM:LCOUNT)%：{DISP_PALAM, PADDING_P} + {UP:(調教PALAM:LCOUNT), PADDING_U} 
		
		;快部位の場合
		IF MATCH(快部位PALAM, LCOUNT)
			;絶頂した場合は絶頂判定内の減算を再現して表示し、絶頂ランクを追加表示する
			IF NOWEX:LCOUNT > 0 && ECS_FLAG < 1
				PRINTFORML - {(NOWEX:LCOUNT > 1 ? DISP_PALAM + UP:(調教PALAM:LCOUNT) - 快部位絶頂しきい値:0 + 1 # 快部位絶頂しきい値:0), PADDING_P} = {PALAM:LCOUNT, PADDING_P}　%ECSTASY_RANK(NOWEX:LCOUNT)%絶頂
			;絶頂していないなら普通に計算後の値を表示し、結界が有効なら結界名を追加表示する
			ELSE
				PRINTFORML = {PALAM:(調教PALAM:LCOUNT), PADDING_P}\@BASE:(基礎部位結界:LCOUNT) > 0 && FLAG:700 ? 　（%TALENTNAME:(部位結界素質:LCOUNT)%） # \@
			ENDIF
		;快部位以外のパラメータの場合
		ELSE
			;上限突破してしまう場合は、上限値になるよう減算して「限界」と追加表示する
			IF DISP_PALAM + UP:(調教PALAM:LCOUNT) > PALAM上限
				PRINTFORML - {DISP_PALAM + UP:(調教PALAM:LCOUNT) - PALAM上限, PADDING_P} = {PALAM上限}　限界
			;そうでない場合は普通に加算結果を表示
			ELSE
				PRINTFORML = {DISP_PALAM + UP:(調教PALAM:LCOUNT), PADDING_P}
			ENDIF
		ENDIF
	ENDIF
NEXT

