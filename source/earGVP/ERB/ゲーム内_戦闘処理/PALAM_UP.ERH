;==============================================================================
;パラメータ上昇処理の条件判定定数定義ファイル
;しきい値は必ず昇順に値を埋めること
;==============================================================================
;----------------------------------------------------------
;絶頂関連のしきい値
;----------------------------------------------------------
;快部位（ＣＶＡＢ）絶頂のしきい値
;最初の項目が絶頂したかどうかの判定値でもある
{
#DIM CONST 快部位絶頂しきい値 =
10000,
20000,
50000,
75000,
100000,
150000,
250000,
400000,
600000,
1000000
}
;----------------------------------------------------------
;MARK（刻印）の上昇しきい値定義
;上昇判定	: UP >= 刻印判定基礎値 + MARK:対象刻印防止 * 刻印防止係数 + クズ市民補正(クズ市民戦のみ)
;			  かつ、戦闘中か幽閉中で、意識があり、2以上へ上昇する場合は1低い刻印を得ていること（飛び級上昇はしない）
;配列の値は順に、0→1へ上昇する条件,1→2へ上昇する条件,...
;本当は#DIM CONSTにしたいが、定数は#DIM REFで参照できないためCONSTなしの変数になっている
;----------------------------------------------------------
;快楽刻印
{
#DIM 快楽刻印判定基礎値 =
12000,
24000,
48000,
96000,
192000
}
{
#DIM 快楽刻印防止係数 =
300,
600,
1200,
2400,
4800
}
{
#DIM 快楽刻印クズ市民補正 =
5000,
10000,
20000,
40000,
80000
}
;苦痛刻印
{
#DIM 苦痛刻印判定基礎値 =
10000,
20000,
40000,
80000,
160000
}
{
#DIM 苦痛刻印防止係数 =
250,
500,
1000,
2000,
4000
}
{
#DIM 苦痛刻印クズ市民補正 =
4000,
8000,
16000,
32000,
64000
}
;屈服刻印
{
#DIM 屈服刻印判定基礎値 =
8000,
16000,
32000,
64000,
128000
}
{
#DIM 屈服刻印防止係数 =
200,
400,
800,
1600,
3200
}
{
#DIM 屈服刻印クズ市民補正 =
3000,
6000,
12000,
24000,
48000
}
;恐怖刻印
{
#DIM 恐怖刻印判定基礎値 =
8000,
16000,
32000,
64000,
128000
}
{
#DIM 恐怖刻印防止係数 =
200,
400,
800,
1600,
3200
}
{
#DIM 恐怖刻印クズ市民補正 =
1500,
3000,
6000,
12000,
24000
}
