	CALL ADDRANDCHOOSE, 619
ENDIF
;母性的/小悪魔/目立ちたがり/上品/泣き虫/潔癖症
IF RAND:6 == 0
	CALL ADDRANDCHOOSE, 620
ELSEIF RAND:5 == 0
	CALL ADDRANDCHOOSE, 621
ELSEIF RAND:4 == 0
	CALL ADDRANDCHOOSE, 622
ELSEIF RAND:3 == 0
	CALL ADDRANDCHOOSE, 623
ELSEIF RAND:2 == 0
	CALL ADDRANDCHOOSE, 624
ELSE
	CALL ADDRANDCHOOSE, 625
ENDIF
$LOOP
SELECT = RANDCHOOSE_F()
TALENT:ARG:SELECT = 1
;候補から選ばれた素質を除外
CALL CLEARSPECIFICCHOOSE, SELECT

HAVE_TALENT = 0
FOR LOCAL, 600, 700
	SIF TALENT:ARG:LOCAL > 0
		HAVE_TALENT ++
NEXT
SIF HAVE_TALENT < ARG:1
	GOTO LOOP

;------------------------------------------------------------------------------------------------------------------
;年齢の初期値を設定
;------------------------------------------------------------------------------------------------------------------
@CHARA_MAKE_AGE_SETTING, ARG
#DIM AGE
#DIM REAL_AGE
#DIM SET_AGE, 3

;年齢の基本値はランダムで決定
BASE:ARG:年齢 = RAND:11 + 10
BASE:ARG:実年齢 = BASE:ARG:年齢
;変身すると大人びるパターン
IF TALENT:ARG:変身能力 > 0 && MAXBASE:ARG:年齢 <= 18 && RAND:4 == 0
	MAXBASE:ARG:年齢 = BASE:ARG:年齢 + RAND:6
;変身しても外見年齢に影響しないパターン
ELSEIF TALENT:ARG:変身能力 > 0
	MAXBASE:ARG:年齢 = BASE:ARG:年齢
ENDIF

IF CALLNAME:ARG == "汎用キャラ"
	
ENDIF

;ここからは素質による年齢範囲の自動設定
AGE = BASE:ARG:年齢
;小学生なら年齢幅6~12
IF TALENT:ARG:学生 == 1
	AGE = RAND:7 + 6
;中学生なら年齢幅12~16
ELSEIF TALENT:ARG:学生 == 2
	AGE = RAND:5 + 12
;高校生なら年齢幅15~19
ELSEIF TALENT:ARG:学生 == 3
	AGE = RAND:5 + 15
;大学生なら年齢幅18~25
ELSEIF TALENT:ARG:学生 == 4
	AGE = RAND:6 + 18
	;SIF AGE >= 22 && RAND:10 == 0
	;	AGE = AGE + RAND:5
ENDIF

;人妻か未亡人なら年齢16歳以上
IF TALENT:ARG:交際相手 >= 4 && AGE < 25
	;高校生持ちの場合
	IF TALENT:ARG:学生 == 3
		AGE = 16 + RAND:3
	ELSEIF TALENT:ARG:学生 == 4
		AGE = 19 + RAND:4
	ELSE
		AGE = TALENT:ARG:交際相手 * 5 + RAND:11
	ENDIF
ENDIF

;実年齢の処理
REAL_AGE = AGE

;ロボっ子なら実年齢0~5
SIF TALENT:ARG:ロボっ子 > 0
	REAL_AGE = RAND:6
;妖精族なら老齢に
SIF TALENT:ARG:妖精族 > 0
	REAL_AGE += RAND:100
;不老長寿持ちなら老齢に
SIF TALENT:ARG:不老長寿 > 0
	REAL_AGE += RAND:500
;天使、魔族、ヴァンパイアなら50%で老齢に、5%で超老齢に
SIF (TALENT:ARG:天使 > 0 || TALENT:ARG:魔族 > 0 || TALENT:ARG:ヴァンパイア > 0) && RAND:2 == 0
	REAL_AGE += RAND:1000
SIF (TALENT:ARG:天使 > 0 || TALENT:ARG:魔族 > 0 || TALENT:ARG:ヴァンパイア > 0) && RAND:10 == 0
	REAL_AGE += RAND:10000

BASE:ARG:年齢 = AGE
MAXBASE:ARG:年齢 = AGE
BASE:ARG:実年齢 = REAL_AGE

;年齢指定有り
IF CSTR:ARG:204 != ""
	IF CSTR:ARG:204 == "0"
		BASE:ARG:実年齢 = 0
	ELSEIF TOINT(CSTR:ARG:204) > 0
		BASE:ARG:実年齢 = TOINT(CSTR:ARG:204)
	ELSE
		BASE:ARG:実年齢 = RANDOM_AGE_F(CSTR:ARG:204)
	ENDIF
ENDIF
IF CSTR:ARG:205 != ""
	IF CSTR:ARG:205 == "0"
		BASE:ARG:年齢 = 0
	ELSEIF TOINT(CSTR:ARG:205) > 0
		BASE:ARG:年齢 = TOINT(CSTR:ARG:205)
	ELSE
		BASE:ARG:年齢 = RANDOM_AGE_F(CSTR:ARG:205)
	ENDIF
ENDIF
IF CSTR:ARG:206 != ""
	IF CSTR:ARG:206 == "0"
		MAXBASE:ARG:年齢 = 0
	ELSEIF TOINT(CSTR:ARG:206) > 0
		MAXBASE:ARG:年齢 = TOINT(CSTR:ARG:206)
	ELSE
		MAXBASE:ARG:年齢 = RANDOM_AGE_F(CSTR:ARG:206)
	ENDIF
ENDIF

SIF CSTR:ARG:204 == "年齢に合わせる"
	BASE:ARG:実年齢 = BASE:ARG:年齢
SIF CSTR:ARG:205 == "実年齢に合わせる"
	BASE:ARG:年齢 = BASE:ARG:実年齢
SIF CSTR:ARG:206 == "年齢に合わせる"
	MAXBASE:ARG:年齢 = BASE:ARG:年齢
SIF CSTR:ARG:206 == "実年齢に合わせる"
	MAXBASE:ARG:年齢 = BASE:ARG:実年齢


;年齢指定で負の数が指定された場合はランダム範囲から値を返す
@RANDOM_AGE_F(ARGS)
#FUNCTION
;赤子　範囲0~3
IF ARGS == "赤子"
	LOCAL = RAND:4
;幼い　範囲3~5
ELSEIF ARGS == "幼児" || ARGS == "幼稚園児"
	LOCAL = RAND:3 + 3
;児童　範囲4~9
ELSEIF ARGS == "児童" || ARGS == "幼女"
	LOCAL = RAND:6 + 4
;子供　範囲7~15
ELSEIF ARGS == "子供" || ARGS == "少女" || ARGS == "少年"
	LOCAL = RAND:9 + 7
;ティーン　範囲13~19
ELSEIF ARGS == "ティーン"
	LOCAL = RAND:7 + 13
;若者　範囲15~25
ELSEIF ARGS == "若者"
	LOCAL = RAND:11 + 15
;大人　範囲20~30
ELSEIF ARGS == "大人" || ARGS == "青年"
	LOCAL = RAND:11 + 20
;妙齢　範囲25~35
ELSEIF ARGS == "妙齢"
	LOCAL = RAND:11 + 25
;中年　範囲30~45
ELSEIF ARGS == "中年"
	LOCAL = RAND:16 + 30
;壮年　範囲35~60
ELSEIF ARGS == "壮年"
	LOCAL = RAND:26 + 35
;小学生　範囲5~12
ELSEIF ARGS == "小学生"
	LOCAL = RAND:8 + 5
;中学生　範囲13~15
ELSEIF ARGS == "中学生"
	LOCAL = RAND:4 + 13
;高校生　範囲16~18
ELSEIF ARGS == "高校生"
	LOCAL = RAND:3 + 16
;大学生　範囲19~22
ELSEIF ARGS == "大学生"
	LOCAL = RAND:4 + 19
ELSE
	;エラー表示の代わり
	LOCAL = -99
ENDIF
RETURNF LOCAL


;ARG番目のキャラにARG:1種族のフィートをランダムで設定
@SET_FEAT_DEFAULT, ARG, ARG:1
#DIM RACE
#DIM FEAT_NUM
RACE = ARG:1
;枠の数を決定
IF RAND:8 == 0
	FEAT_NUM = 1
ELSEIF RAND:4 == 0
	FEAT_NUM = 2
ELSE
	FEAT_NUM = 3
ENDIF
SIF TALENTNAME:(ARG:1) == "ヴァンパイア"
	FEAT_NUM -= 1

;７５％の確率でプリセットから選択
IF RAND:4 != 0
	IF TALENTNAME:RACE == "人間"
		;固有フィートのみＡ
		IF RAND:4 == 0
			TALENT:ARG:平凡 = 1
			FEAT_NUM -= 1
		;固有フィートのみＢ
		ELSEIF RAND:3 == 0
			TALENT:ARG:巻き込まれ体質 = 1
			FEAT_NUM -= 1
		;秘められし力
		ELSEIF RAND:2 == 0
			TALENT:ARG:秘められし力 = 1
			TALENT:ARG:不屈 = 1
			FEAT_NUM -= 2
		;祝福、不屈セット
		ELSE
			TALENT:ARG:祝福 = 1
			TALENT:ARG:不屈 = 1
			FEAT_NUM -= 2
		ENDIF
		;フィートが多すぎると扱いにくくなるので確率で減らす
		SIF RAND:2 == 0
			FEAT_NUM -= 1
	ELSEIF TALENTNAME:RACE == "異能力者"
		;固有フィートのみ
		IF RAND:4 == 0
			TALENT:ARG:攻勢構築 = 1
			FEAT_NUM -= 1
		;秘められし力
		ELSEIF RAND:3 == 0
			TALENT:ARG:秘められし力 = 1
			TALENT:ARG:心眼 = 1
			FEAT_NUM -= 2
		;孤高のハンター型
		ELSEIF RAND:2 == 0
			TALENT:ARG:生粋の戦士 = 1
			TALENT:ARG:狩人の勘 = 1
			FEAT_NUM -= 2
		;直撃率重視
		ELSE
			TALENT:ARG:攻勢構築 = 1
			TALENT:ARG:心眼 = 1
			FEAT_NUM -= 2
		ENDIF
	ELSEIF TALENTNAME:RACE == "魔法使い"
		;固有フィートのみ
		IF RAND:5 == 0
			TALENT:ARG:魔力貯蔵 = 1
			FEAT_NUM -= 1
		;不老長寿のみ
		ELSEIF RAND:4 == 0
			TALENT:ARG:不老長寿 = 1
			FEAT_NUM -= 1
		;後方支援型
		ELSEIF RAND:3 == 0
			TALENT:ARG:ラッキーチャーム = 1
			TALENT:ARG:叡智の冠 = 1
			FEAT_NUM -= 2
		;高火力型
		ELSEIF RAND:2 == 0
			TALENT:ARG:魔力貯蔵 = 1
			TALENT:ARG:フルバースト = 1
			FEAT_NUM -= 2
		;空中戦型
		ELSE
			TALENT:ARG:空中浮遊 = 1
			TALENT:ARG:不老長寿 = 1
			FEAT_NUM -= 2
		ENDIF
	ELSEIF TALENTNAME:RACE == "ロボっ子"
		;固有フィートのみ
		IF RAND:2 == 0
			TALENT:ARG:超反応 = 1
			FEAT_NUM -= 1
		;スタミナ軸
		ELSEIF RAND:2 == 0
			TALENT:ARG:スタミナ = 1
			IF RAND:3 == 0
				TALENT:ARG:剛腕 = 1
			ELSEIF RAND:3 == 0
				TALENT:ARG:空中浮遊 = 1
			ELSEIF RAND:2 == 0
				TALENT:ARG:ホットスタート = 1
			ELSE
				TALENT:ARG:フルバースト = 1
			ENDIF
			FEAT_NUM -= 2
		;速攻火力型
		ELSE
			TALENT:ARG:ホットスタート = 1
			TALENT:ARG:フルバースト = 1
			FEAT_NUM -= 2
		ENDIF
		;フィートが多すぎると扱いにくくなるので確率で減らす
		SIF RAND:3 == 0
			FEAT_NUM -= 1
	ELSEIF TALENTNAME:RACE == "天使"
		;固有フィートのみ
		IF RAND:4 != 0
			TALENT:ARG:神器の担い手 = 1
			FEAT_NUM -= 1
		;後方支援型
		ELSEIF RAND:3 == 0
			TALENT:ARG:祝福 = 1
			TALENT:ARG:叡智の冠 = 1
			FEAT_NUM -= 2
		;空中戦型
		ELSEIF RAND:2 == 0
			TALENT:ARG:有翼 = 1
			TALENT:ARG:空中浮遊 = 1
			FEAT_NUM -= 2
		;自由枠
		ELSE
			FEAT_NUM = 3
		ENDIF
	ELSEIF TALENTNAME:RACE == "魔族"
		;固有フィートのみ
		IF RAND:4 != 0
			TALENT:ARG:闘争本能 = 1
			FEAT_NUM -= 1
		;タンク型
		ELSEIF RAND:3 == 0
			TALENT:ARG:闘争本能 = 1
			TALENT:ARG:不屈 = 1
			FEAT_NUM -= 2
		;孤高のハンター型
		ELSEIF RAND:2 == 0
			TALENT:ARG:生粋の戦士 = 1
			TALENT:ARG:狩人の勘 = 1
			FEAT_NUM -= 2
		;自由枠
		ELSE
			FEAT_NUM = 3
		ENDIF
	ELSEIF TALENTNAME:RACE == "鬼"
		;固有フィートのみ
		IF RAND:4 != 0
			TALENT:ARG:溢れる生命力 = 1
			FEAT_NUM -= 1
		;タンク型
		ELSEIF RAND:3 == 0
			TALENT:ARG:不屈 = 1
			TALENT:ARG:スタミナ = 1
			FEAT_NUM -= 2
		;純粋パワー型
		ELSEIF RAND:2 == 0
			TALENT:ARG:生粋の戦士 = 1
			TALENT:ARG:剛腕 = 1
			FEAT_NUM -= 1
		;不老長寿のみ
		ELSE
			TALENT:ARG:不老長寿 = 1
			FEAT_NUM -= 1
		ENDIF
	ELSEIF TALENTNAME:RACE == "妖精族"
		;固有フィートのみ
		IF RAND:4 != 0
			TALENT:ARG:精霊交信 = 1
			FEAT_NUM -= 1
		;フェアリー型
		ELSEIF RAND:2 == 0
			TALENT:ARG:小さな体躯 = 1
			IF RAND:2 == 0
				TALENT:ARG:人外の美貌 = 1
			ELSE
				TALENT:ARG:エアマスター = 1
			ENDIF
			FEAT_NUM -= 2
		;エルフ型
		ELSE
			TALENT:ARG:叡智の冠 = 1
			IF RAND:2 == 0
				TALENT:ARG:人外の美貌 = 1
			ELSE
				TALENT:ARG:不老長寿 = 1
			ENDIF
			FEAT_NUM -= 2
		ENDIF
	ELSEIF TALENTNAME:RACE == "ケモミミ族"
		;固有フィートのみ
		IF RAND:4 != 0
			TALENT:ARG:獣性の証 = 1
			FEAT_NUM -= 1
		;空中戦型
		ELSEIF RAND:3 == 0
			TALENT:ARG:小さな体躯 = 1
			TALENT:ARG:エアマスター = 1
			FEAT_NUM -= 2
		;クリティカル型
		ELSEIF RAND:2 == 0
			TALENT:ARG:獣性の証 = 1
			TALENT:ARG:心眼 = 1
			FEAT_NUM -= 2
		;スタミナのみ
		ELSE
			TALENT:ARG:スタミナ = 1
			FEAT_NUM -= 1
		ENDIF
	ELSEIF TALENTNAME:RACE == "ヴァンパイア"
		;パワー型
		IF RAND:4 == 0
			TALENT:ARG:剛腕 = 1
			TALENT:ARG:有翼 = 1
			FEAT_NUM -= 2
		;籠絡型
		ELSEIF RAND:3 == 0
			TALENT:ARG:人外の美貌 = 1
			TALENT:ARG:背徳の烙印 = 1
			FEAT_NUM -= 2
		;自由枠
		ELSE
			FEAT_NUM = 2
		ENDIF
	ELSEIF TALENTNAME:RACE == "ポリニアン"
		;固有フィートのみ
		IF RAND:2 == 0
			TALENT:ARG:超反応 = 1
			FEAT_NUM -= 1
		;スタミナ軸
		ELSEIF RAND:2 == 0
			TALENT:ARG:スタミナ = 1
			IF RAND:3 == 0
				TALENT:ARG:剛腕 = 1
			ELSEIF RAND:3 == 0
				TALENT:ARG:空中浮遊 = 1
			ELSEIF RAND:2 == 0
				TALENT:ARG:ホットスタート = 1
			ELSE
				TALENT:ARG:フルバースト = 1
			ENDIF
			FEAT_NUM -= 2
		;速攻火力型
		ELSE
			TALENT:ARG:ホットスタート = 1
			TALENT:ARG:フルバースト = 1
			FEAT_NUM -= 2
		ENDIF
		;フィートが多すぎると扱いにくくなるので確率で減らす
		SIF RAND:3 == 0
			FEAT_NUM -= 1
	ENDIF
ENDIF
;枠が余っていればランダム設定
IF FEAT_NUM > 0
	CALL CLEARRANDCHOOSE
	FOR LOCAL, 1100, 1300
		;取得可能なフィートを候補に加える、ただし取得済みのものは除外する
		SIF FEAT_ABLE_F(RACE, LOCAL) > 0 && TALENT:ARG:LOCAL == 0
			CALL ADDRANDCHOOSE, LOCAL
	NEXT
	FOR LOCAL, 0, CHOICECOUNT_F()
		LOCAL:1 = RANDCHOOSE_F()
		TALENT:ARG:(LOCAL:1) = 1
		CALL CLEARSPECIFICCHOOSE(LOCAL:1)
	NEXT
ENDIF
;プロフィールに反映
CALL SET_PROFILE, ARG

RETURN 0


