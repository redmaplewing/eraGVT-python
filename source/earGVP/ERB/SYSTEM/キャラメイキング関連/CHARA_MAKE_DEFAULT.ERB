
;------------------------------------------------------------------------------------------------------------------
;キャラメイク画面を開いた時点で設定される個別キャラの要素
;------------------------------------------------------------------------------------------------------------------
@CHARA_MAKE_INITIALIZE(SELECT=0)
#DIM SELECT

	;種族とフィートがランダムなら自動設定
	CALL SYUZOKU_CHECK,"GET_SYUZOKU_VALUE",SELECT
	IF RESULT == 0
		;種族の自動設定
		IF FLAG:823 > 0
			IF FLAG:823 == 1
				TALENT:SELECT:人間 = 1
			ELSEIF FLAG:823 == 2
				TALENT:SELECT:異能力者 = 1
			ELSEIF FLAG:823 == 3
				TALENT:SELECT:魔法使い = 1
			ELSEIF FLAG:823 == 4
				TALENT:SELECT:ロボっ子 = 1
			ELSEIF FLAG:823 == 5
				TALENT:SELECT:天使 = 1
			ELSEIF FLAG:823 == 6
				TALENT:SELECT:魔族 = 1
			ELSEIF FLAG:823 == 7
				TALENT:SELECT:鬼 = 1
			ELSEIF FLAG:823 == 8
				TALENT:SELECT:妖精族 = 1
			ELSEIF FLAG:823 == 9
				TALENT:SELECT:ケモミミ族 = 1
			ELSEIF FLAG:823 == 10
				TALENT:SELECT:ヴァンパイア = 1
				TALENT:SELECT:夜魔の貴族 = 1
			ELSEIF FLAG:823 == 11
				TALENT:SELECT:ポリニアン = 1
			ENDIF
		ELSE
			LOCAL = RAND:24
			LOCAL += 201
			IF LOCAL == 201
				TALENT:SELECT:人間 = 1
			ELSEIF LOCAL == 202
				TALENT:SELECT:異能力者 = 1
			ELSEIF LOCAL == 203
				TALENT:SELECT:魔法使い = 1
			ELSEIF LOCAL == 204
				TALENT:SELECT:ロボっ子 = 1
			ELSEIF LOCAL == 205
				TALENT:SELECT:天使 = 1
			ELSEIF LOCAL == 206
				TALENT:SELECT:魔族 = 1
			ELSEIF LOCAL == 207
				TALENT:SELECT:鬼 = 1
			ELSEIF LOCAL == 208
				TALENT:SELECT:妖精族 = 1
			ELSEIF LOCAL == 209
				TALENT:SELECT:ケモミミ族 = 1
			ELSEIF LOCAL == 210 && RAND:2 == 0
				TALENT:SELECT:ヴァンパイア = 1
				TALENT:SELECT:夜魔の貴族 = 1
			ELSEIF LOCAL == 211
				TALENT:SELECT:ポリニアン = 1
			;人間が出やすいように
			ELSE
				TALENT:SELECT:人間 = 1
			ENDIF
		ENDIF
		;フィートの自動設定
		CALL SYUZOKU_CHECK,"GET_SYUZOKU_VALUE",SELECT
		SIF FLAG:824 == 1
			CALL SET_FEAT_DEFAULT, SELECT, RESULT
	ENDIF

	;性格がランダムなら決定
	IF SEIKAKU_CHECK_F(SELECT) == 0
		local:1=1
		WHILE local:1<=100
			LOCAL = RAND:18
			LOCAL += 10
			IF LOCAL == 10
				TALENT:SELECT:臆病 = 1
			ELSEIF LOCAL == 11
				TALENT:SELECT:恥ずかしがり屋 = 1
			ELSEIF LOCAL == 12
				TALENT:SELECT:勝気 = 1
			ELSEIF LOCAL == 13
				TALENT:SELECT:元気っ子 = 1
			ELSEIF LOCAL == 14
				TALENT:SELECT:おっとり = 1
			ELSEIF LOCAL == 15
				TALENT:SELECT:面倒くさがり = 1
			ELSEIF LOCAL == 16
				TALENT:SELECT:真面目 = 1
			ELSEIF LOCAL == 17
				TALENT:SELECT:楽天家 = 1
			ELSEIF LOCAL == 18
				TALENT:SELECT:悲観的 = 1
			ELSEIF LOCAL == 19
				TALENT:SELECT:素直 = 1
			ELSEIF LOCAL == 20
				TALENT:SELECT:ツンデレ = 1
			ELSEIF LOCAL == 21
				TALENT:SELECT:ヤンデレ = 1
			ELSEIF LOCAL == 22
				TALENT:SELECT:無口 = 1
			ELSEIF LOCAL == 23
				TALENT:SELECT:おしゃべり = 1
			ELSEIF LOCAL == 24
				TALENT:SELECT:古風 = 1
			ELSEIF LOCAL == 25
				TALENT:SELECT:かるい性格 = 1
			ELSEIF LOCAL == 26
				TALENT:SELECT:意地っ張り = 1
			ELSEIF LOCAL == 27
				TALENT:SELECT:乱暴者 = 1
			ENDIF
			;他キャラとの被りは避けようとする
			FOR local:2,1,SELECT
				IF SEIKAKU_CHECK_F(local:2) == SEIKAKU_CHECK_F(SELECT)
					local:1++
					CONTINUE
				ENDIF
			NEXT

			;口上無くてもいい場合
			IF FLAG:825 == 0
				BREAK
			ELSE
				;口上あり限定の場合
				TRYCCALLFORM KOJO_0_COLOR_{LOCAL}
					;口上あった
					RESETCOLOR
					BREAK
				CATCH
					;口上なかった(ガチャ続行)
					local:1++
				ENDCATCH
			ENDIF
		WEND

		;体力などのBASE値の計算
		CALL SEIKAKU_CHECK,"GET_TALENT_VALUE",SELECT
		LOCAL = RESULT
		LOCAL:1 = 0
		LOCAL:2 = 0
		FOR LOCAL:3, 0, 7
			LOCAL:1 = LOCAL:3
			SIF LOCAL:3 > 2
				LOCAL:1 = LOCAL:3 + 7
			LOCAL:2 = BASE:SELECT:(LOCAL:1)
			;性格補正
			BASE:SELECT:(LOCAL:1) = SEIKAKU_HOSEI_F(LOCAL, LOCAL:1, LOCAL:2)
			MAXBASE:SELECT:(LOCAL:1) = BASE:SELECT:(LOCAL:1)
		NEXT
		;性格による一人称の設定
		;「私」以外に設定してある場合は変更しない
		IF CFLAG:SELECT:8
		ELSEIF TALENT:SELECT:古風
			CFLAG:SELECT:8 = 20
		ELSEIF TALENT:SELECT:かるい性格
			CFLAG:SELECT:8 = 11
		ELSE
			CFLAG:SELECT:8 = 0
		ENDIF
	ENDIF
	;身体データの生成
	CALL CHARA_MAKE_BASE_PROFILE(SELECT)

	;共通設定からの変身名ロード　※汎用キャラ以外への反映
	IF CALLNAME:SELECT != "汎用キャラ" && TALENT:SELECT:変身能力 == 1
		IF CSTR:SELECT:0 == ""
			;共通上の句
			LOCALS=%SAVESTR:11%
			;下の句ジャンル
			LOCALS:1=%CALLNAME:SELECT%
			LOCAL:10=0
			$NAMEFROMGENRE
			IF FLAG:820>0
				CALL RANDOMNAMING_FROMGENRE(FLAG:820)
				LOCALS:1=%RESULTS%
			ENDIF
			IF LOCALS+LOCALS:1!=""
				CSTR:SELECT:0 = %LOCALS%%LOCALS:1%
				;ジャンル指定からの生成なら他キャラとの丸被りは避けようとする
				IF FLAG:820>0
					FOR LOCAL, 1, CHARANUM
						SIF LOCAL==SELECT
							CONTINUE
						IF CSTR:SELECT:0==CSTR:LOCAL:0 && LOCAL:10<10
							LOCAL:10++
							GOTO NAMEFROMGENRE
						ENDIF
					NEXT
				ENDIF
				CFLAG:SELECT:2 = 1
				IF CSTR:SELECT:3==""
					CALL SEIKAKU_CHECK, "GET_TALENT_VALUE", SELECT
					CSTR:SELECT:3=%SAVESTR:10%%CSTR:SELECT:0%%FIRSTSETTING_CHANGINGCALL_DETAIL(SELECT,RESULT)%
					CFLAG:SELECT:5 = 1
				ENDIF

			ENDIF
		ENDIF
		IF CSTR:SELECT:1 == "" && CSTR:SELECT:0 != ""
			CSTR:SELECT:1 = %CSTR:SELECT:0%
			CFLAG:SELECT:3 = 1
		ENDIF
		IF CSTR:SELECT:2 == "" && SAVESTR:12 != ""
			CSTR:SELECT:2 = %SAVESTR:12%
			CFLAG:SELECT:4 = 1
		ENDIF
	ENDIF




;------------------------------------------------------------------------------------------------------------------
;キャラメイク完了後に全キャラ共通で行う初期処理 ＋ 未設定項目を補う処理
;------------------------------------------------------------------------------------------------------------------
;ARG 個別設定する場合
@CHARA_MAKE_FINALIZE, ARG = 0
#DIM SELECT

;キャラの素性をランダムに生成
FOR SELECT,1,CHARANUM

	;キャラ指定がある場合、他をスキップする
	SIF ARG != 0 && SELECT != ARG
		CONTINUE

	;未初期化項目(汎用キャラ状態)の要素について補完
	CALL CHARA_MAKE_INITIALIZE(SELECT)


	;CSVの記述ミス回避
	SIF MAXBASE:SELECT:射精 < 1
		MAXBASE:SELECT:射精 = 10000
	SIF MAXBASE:SELECT:噴乳 < 1
		MAXBASE:SELECT:噴乳 = 10000

	;番号登録
	SIF CFLAG:SELECT:240 == 0
		CFLAG:SELECT:240 = SELECT

	;未使用のボーナス値を反映
	IF JUEL:SELECT:修練P >= 10
		FOR LOCAL,0,JUEL:SELECT:修練P / 10
			CFLAG:SELECT:(50 + RAND:7) += 1
			JUEL:SELECT:修練P -= 10
		NEXT
	ENDIF

	;ジャンプ性能
	IF TALENT:SELECT:変身能力 == -1
		MAXBASE:SELECT:空中ダッシュ = LIMIT(CSVBASE_F(NO:SELECT,22), 0, 8)
	ELSE
		MAXBASE:SELECT:空中ダッシュ = LIMIT(CSVBASE_F(NO:SELECT,22), 0, 8)
	ENDIF

	SIF TALENT:SELECT:空中得意
		MAXBASE:SELECT:空中ダッシュ = MIN(MAXBASE:SELECT:空中ダッシュ + TALENT:SELECT:空中得意, 8)
	SIF TALENT:SELECT:空中苦手
		MAXBASE:SELECT:空中ダッシュ = MAX(MAXBASE:SELECT:空中ダッシュ - TALENT:SELECT:空中苦手, 0)

	;素質基本値の保存
	;通常性別
	IF CHARATALENT_F(SELECT, 0, "オトコ") > 0
		IF CHARATALENT_F(SELECT, 0, "男の娘") > 0
			BASE:SELECT:性別基本値 = 3
		ELSE
			BASE:SELECT:性別基本値 = 1
		ENDIF
	ELSEIF CHARATALENT_F(SELECT, 0, "ふたなり") > 0
		BASE:SELECT:性別基本値 = 2
	ELSE
		BASE:SELECT:性別基本値 = 0
	ENDIF
	;通常体格
	IF CHARATALENT_F(SELECT, 0, "小柄") > 0
		BASE:SELECT:体格基本値 = -1
	ELSEIF CHARATALENT_F(SELECT, 0, "長身") > 0
		BASE:SELECT:体格基本値 = 1
	ELSE
		BASE:SELECT:体格基本値 = 0
	ENDIF
	;通常胸サイズ
	IF CHARATALENT_F(SELECT, 0, "絶壁") > 0
		BASE:SELECT:胸サイズ基本値 = -2
	ELSEIF CHARATALENT_F(SELECT, 0, "貧乳") > 0
		BASE:SELECT:胸サイズ基本値 = -1
	ELSEIF CHARATALENT_F(SELECT, 0, "奇乳") > 0
		BASE:SELECT:胸サイズ基本値 = 5
	ELSEIF CHARATALENT_F(SELECT, 0, "魔乳") > 0
		BASE:SELECT:胸サイズ基本値 = 4
	ELSEIF CHARATALENT_F(SELECT, 0, "超乳") > 0
		BASE:SELECT:胸サイズ基本値 = 3
	ELSEIF CHARATALENT_F(SELECT, 0, "爆乳") > 0
		BASE:SELECT:胸サイズ基本値 = 2
	ELSEIF CHARATALENT_F(SELECT, 0, "巨乳") > 0
		BASE:SELECT:胸サイズ基本値 = 1
	ELSE
		BASE:SELECT:胸サイズ基本値 = 0
	ENDIF
	;通常外見
	IF CHARATALENT_F(SELECT, 0, "安産型") > 0
		BASE:SELECT:外見基本値 = 1
	ELSEIF CHARATALENT_F(SELECT, 0, "むちむち") > 0
		BASE:SELECT:外見基本値 = 2
	ELSEIF CHARATALENT_F(SELECT, 0, "イカ腹") > 0
		BASE:SELECT:外見基本値 = 3
	ELSEIF CHARATALENT_F(SELECT, 0, "スレンダー") > 0
		BASE:SELECT:外見基本値 = 4
	ELSEIF CHARATALENT_F(SELECT, 0, "巨尻") > 0
		BASE:SELECT:外見基本値 = 5
	ELSEIF CHARATALENT_F(SELECT, 0, "爆尻") > 0
		BASE:SELECT:外見基本値 = 6
	ELSE
		BASE:SELECT:外見基本値 = 0
	ENDIF
	;変身時性別
	IF CHARATALENT_F(SELECT, 1, "オトコ") > 0
		IF CHARATALENT_F(SELECT, 1, "男の娘") > 0
			MAXBASE:SELECT:性別基本値 = 3
		ELSE
			MAXBASE:SELECT:性別基本値 = 1
		ENDIF
	ELSEIF CHARATALENT_F(SELECT, 1, "ふたなり") > 0
		MAXBASE:SELECT:性別基本値 = 2
	ELSE
		MAXBASE:SELECT:性別基本値 = 0
	ENDIF
	;変身時体格
	MAXBASE:SELECT:体格基本値 = TALENT:SELECT:変身時体格変動
	;変身時胸サイズ
	MAXBASE:SELECT:胸サイズ基本値 = TALENT:SELECT:変身時胸サイズ変動
	;変身時外見
	IF CHARATALENT_F(SELECT, 1, "安産型") > 0
		MAXBASE:SELECT:外見基本値 = 1
	ELSEIF CHARATALENT_F(SELECT, 1, "むちむち") > 0
		MAXBASE:SELECT:外見基本値 = 2
	ELSEIF CHARATALENT_F(SELECT, 1, "イカ腹") > 0
		MAXBASE:SELECT:外見基本値 = 3
	ELSEIF CHARATALENT_F(SELECT, 1, "スレンダー") > 0
		MAXBASE:SELECT:外見基本値 = 4
	ELSEIF CHARATALENT_F(SELECT, 1, "巨尻") > 0
		MAXBASE:SELECT:外見基本値 = 5
	ELSEIF CHARATALENT_F(SELECT, 1, "爆尻") > 0
		MAXBASE:SELECT:外見基本値 = 6
	ELSE
		MAXBASE:SELECT:外見基本値 = 0
	ENDIF




	;キャラのボーナス値を実ステータスに反映
	BASE:SELECT:体力 += CFLAG:SELECT:50 * 10
	BASE:SELECT:気力 += CFLAG:SELECT:51 * 10
	BASE:SELECT:性耐性 += CFLAG:SELECT:52

	BASE:SELECT:攻撃 += CFLAG:SELECT:53
	BASE:SELECT:防御 += CFLAG:SELECT:54
	BASE:SELECT:敏捷 += CFLAG:SELECT:55
	BASE:SELECT:知性 += CFLAG:SELECT:56

	FOR LOCAL:3, 0, 7
		LOCAL:1 = LOCAL:3
		SIF LOCAL:3 > 2
			LOCAL:1 = LOCAL:3 + 7
		MAXBASE:SELECT:(LOCAL:1) = BASE:SELECT:(LOCAL:1)
	NEXT

	;レベル１未満のキャラは初期レベルを１に
	SIF ABL:SELECT:レベル < 1
		ABL:SELECT:レベル = 1

	;キャラのステータスをレベル1の物に補正する
	BASE:SELECT:体力基礎 = BASE:SELECT:体力
	BASE:SELECT:気力基礎 = BASE:SELECT:気力
	BASE:SELECT:性耐性基礎 = BASE:SELECT:性耐性
	CALL LEVELSTATUS, SELECT

	BASE:SELECT:体力 = MAXBASE:SELECT:体力
	BASE:SELECT:気力 = MAXBASE:SELECT:気力
	BASE:SELECT:性耐性 = MAXBASE:SELECT:性耐性

	;衣装が未設定なら私服、-1(装備なし指定)なら0にしておく
	SIF CFLAG:SELECT:40 == 0
		CFLAG:SELECT:40 = 100
	SIF CFLAG:SELECT:40 == -1
		CFLAG:SELECT:40 = 0
	;変身能力があるとき、衣装が未設定ならオリジナルスーツ
	SIF TALENT:SELECT:変身能力 == 1 && CFLAG:SELECT:41 == 0
		CFLAG:SELECT:41 = 200
	;無しと指定されていたら無し
	SIF CFLAG:SELECT:41 == -1
		CFLAG:SELECT:41 = 0
	;衣装が未設定なら普通の下着、ただしアウターが(変身能力があれば変身後アウターも)インナー兼用なら追加しない
	IF CFLAG:SELECT:42 == 0
		LOCAL = 0
		CALL CLOTH_NO_INNER, SELECT
		SIF RESULT
			LOCAL += 1
		IF TALENT:SELECT:変身能力 == 1
			CFLAG:SELECT:1 = 1
			CALL CLOTH_NO_INNER, SELECT
			SIF RESULT
				LOCAL += 1
			CFLAG:SELECT:1 = 0
		ENDIF
		SIF LOCAL == 0
			CFLAG:SELECT:42 = 300
	ENDIF
	SIF CFLAG:SELECT:42 == -1
		CFLAG:SELECT:42 = 0
	;間違えて設定した場合に備えてCFLAG:43も0に
	SIF CFLAG:SELECT:43 == -1
		CFLAG:SELECT:43 = 0

	;変身前とSP変身後の能力
	SIF CFLAG:SELECT:10 == 0
		CFLAG:SELECT:10 = 25
	SIF CFLAG:SELECT:11 == 0
		CFLAG:SELECT:11 = 110


	;圧縮武器データの解凍
	SIF CSTR:SELECT:15 != ""
		CALL DECODE_WEAPON_DATA, SELECT, 1
	SIF CSTR:SELECT:16 != ""
		CALL DECODE_WEAPON_DATA, SELECT, 2
	SIF CSTR:SELECT:17 != ""
		CALL DECODE_WEAPON_DATA, SELECT, 3
	;圧縮武器データのクリア
	CSTR:SELECT:15 =
	CSTR:SELECT:16 =
	CSTR:SELECT:17 =

	;コネクションの反映
	SIF TALENT:SELECT:噂好きの友人
		CFLAG:SELECT:120 = 1
	SIF TALENT:SELECT:警察関係者 == 1 && CFLAG:SELECT:121 < 2
		CFLAG:SELECT:121 = 1
	SIF TALENT:SELECT:警察関係者 == 2
		CFLAG:SELECT:121 = 2
	IF TALENT:SELECT:情報屋 == 1 && CFLAG:SELECT:122 == 0
		CFLAG:SELECT:122 = 1
		CFLAG:SELECT:122 |= 2
		;小太りの男
		IF RAND:7 == 0
			SETBIT CFLAG:SELECT:122, 2
		;上品な男
		ELSEIF RAND:6 == 0
			SETBIT CFLAG:SELECT:122, 3
		;探偵風の男
		ELSEIF RAND:5 == 0
			SETBIT CFLAG:SELECT:122, 4
		;ゲス野郎
		ELSEIF RAND:4 == 0
			SETBIT CFLAG:SELECT:122, 2
			SETBIT CFLAG:SELECT:122, 3
		;シティハンター的なあいつ
		ELSEIF RAND:3 == 0
			SETBIT CFLAG:SELECT:122, 2
			SETBIT CFLAG:SELECT:122, 4
		;老人
		ELSEIF RAND:2 == 0
			SETBIT CFLAG:SELECT:122, 3
			SETBIT CFLAG:SELECT:122, 4
		ENDIF
	ENDIF
	IF TALENT:SELECT:裕福な実家 == 1 || CFLAG:SELECT:123 > 0
		CFLAG:SELECT:123 = 1
		MONEY += 2500
	ENDIF




	;最初から非処女ならＶ経験が入る
	IF EXP:SELECT:Ｖ経験 > 0
	ELSEIF TALENT:SELECT:処女 < 1 && ISFEMALE(SELECT)
		EXP:SELECT:Ｖ経験 = 1+RAND:4
	ELSE
		EXP:SELECT:Ｖ経験 = 0
	ENDIF


NEXT



@CHARA_MAKE_BASE_PROFILE(SELECT)
#DIM SELECT,1
	;●csvキャラor設定画面を１度でも開いたキャラの場合
	IF CALLNAME:SELECT != "汎用キャラ"
		;詳細プロフィール未設定の場合
		IF CFLAG:SELECT:34 == 0 && NO:SELECT == 0
			;年齢やスリーサイズ等設定
			CALL GENERATE_BODYLINE, SELECT
			CALL CHARA_MAKE_AGE_SETTING, SELECT
			CALL CHARA_SIZE_DEFAULT, SELECT
		ENDIF
		;ここから下の処理を飛ばす ------------------------------------------------------------------------------------------------------------------------
		RETURN
	;●未初期化キャラの場合
	ELSE
		;女性なら処女の清純派持ちにする
		IF ISFEMALE(SELECT)
			TALENT:SELECT:処女 = 1
			TALENT:SELECT:清純派 = 1
		ENDIF
		;とりあえず年齢の設定
		CALL GENERATE_BODYLINE, SELECT
		CALL CHARA_MAKE_AGE_SETTING, SELECT
			;年齢設定に基づき素質決定
			CALL CHARA_MAKE_STATUS_TALENT, SELECT
			CALL CHARA_MAKE_STATUS_TALENT_FLAVOR, SELECT
		;スリーサイズ等設定
		CALL CHARA_SIZE_DEFAULT, SELECT

			;●初期化完了していないキャラ枠の場合、この場でキャラメイク相当のデータをランダム生成する

		;髪型の自動設定
		CSTR:SELECT:12 = %STR:(30000 + RAND:9)%
		CSTR:SELECT:13 = %STR:(30100 + RAND:15)%
		CSTR:SELECT:14 = %CSTR:SELECT:13%
		SIF RAND:2 == 0
			CSTR:SELECT:14 = %STR:(30100 + RAND:15)%
		;変身能力の設定
		;種族：人間には必ず変身を設定
		;その他の種族については保留
		SIF TALENT:SELECT:人間 == 1
			TALENT:SELECT:変身能力 = 1

	ENDIF


	;このタイミングで変身能力が設定された場合に備えてもう一度衣装の設定
	;衣装が未設定ならオリジナルスーツ
	SIF TALENT:SELECT:変身能力 == 1 && CFLAG:SELECT:41 == 0
		CFLAG:SELECT:41 = 200



	;キャラ名のランダム生成
	;キャラメイキングの関数の処理と同じ
	LOCAL:0 = 0
	LOCAL:1 = 0
	;デフォルトでは３/４の確率で日本語苗字
	IF FLAG:821==1 || (FLAG:821==0 && RAND:4 != 0)
		;苗字
		LOCAL:0 = RAND:500 + 3000
		WHILE STR:(LOCAL:0) == ""
			LOCAL:0 = RAND:500 + 3000
		WEND
		LOCALS:0 = %STR:(LOCAL:0)%
		;名前
		LOCALS:1'=""
		WHILE LOCALS:1 == ""
			SELECTCASE FLAG:822
			;Japanese
			CASE 1
				LOCAL:1 = RAND:500 + 12000
			;English
			CASE 2
				LOCAL:1 = RAND:1000 + 12500
			;French
			CASE 3
				LOCAL:1 = RAND:500 + 13500
			;German
			CASE 4
				LOCAL:1 = RAND:1000 + 14000
			;Italy
			CASE 5
				LOCAL:1 = RAND:500 + 15000
			;Russian
			CASE 6
				LOCAL:1 = RAND:500 + 15500
			;Chinese
			CASE 7
				LOCAL:1 = RAND:1000 + 16500
			;Japanese(no-gender)
			CASE 8
				LOCAL:1 = RAND:500 + 18000
			;no setting=>Japanese
			; *Random heroines who have JP family-name also have JP first name.
			;  自動生成で言語を混ぜるとエロゲとして変な響きの名前になってしまいやすいため。
			CASEELSE
				LOCAL:1 = RAND:500 + 12000
			ENDSELECT
			LOCALS:1'=STR:(LOCAL:1)

			;中国語は単漢字組み合わせ(二文字目)の可能性がある
			IF FLAG:822 == 7 && RAND:2
				LOCAL:1 = RAND:1000 + 16500
				WHILE STR:(LOCAL:1) == ""
					LOCAL:1 = RAND:1000 + 16500
				WEND
				LOCALS:1+=STR:(LOCAL:1)
			ENDIF

		WEND


		;日本語名の場合、日本人風の外見
		IF RAND:8 == 0
