					SIF TALENT:ARG:未熟 != 1
						EXP:ARG:射精経験 += 1
				ENDIF
			ELSE
				IF OPTION:0 == 0 && OPTION:2 == 2
					EXP:ARG:フェラ経験 += 1
				ELSEIF OPTION:3 == 2 && EXP:ARG:Ｖ経験 == 0
					EXP:ARG:Ｖ経験 += 2
					IF RAND:6 != 0
						SIF TALENT:ARG:未熟 != 1 && TALENT:ARG:ふたなり > 0
							EXP:ARG:射精経験 += 1
						SIF TALENT:ARG:母乳体質 > 0 && RAND:2 == 0
