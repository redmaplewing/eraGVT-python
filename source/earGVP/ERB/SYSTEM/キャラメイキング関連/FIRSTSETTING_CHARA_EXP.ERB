	SIF TALENT:ARG:保守的 > 0
		LOCAL = LOCAL * 2 / 3
	SIF TALENT:ARG:好奇心 > 0
		LOCAL = LOCAL * 3 / 2
	SIF TALENT:ARG:清純派
		LOCAL = LOCAL / 2
	SIF TALENT:ARG:清純派 && TALENT:ARG:交際相手 == 3
		LOCAL = LOCAL * 2 / 3
	SIF TALENT:ARG:学生 == 1
		LOCAL = LOCAL / 2
	SIF TALENT:ARG:学生 == 2
		LOCAL = LOCAL * 2 / 3
