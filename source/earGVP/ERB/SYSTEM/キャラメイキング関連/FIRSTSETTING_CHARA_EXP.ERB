		SIF OPTION:2 == 1 && RAND:2 == 0
			LOCAL += 1
	;経験回数がやや少ない
	ELSEIF OPTION:0 == 2 && RAND:2 == 0
		LOCAL = 2 + RAND:6
		;売春経験が「あり」なら
		SIF OPTION:2 == 1 && RAND:3 != 0
			LOCAL += 2
	;経験回数が多い
	ELSEIF OPTION:0 == 3
		LOCAL = 4 + RAND:12
		;売春経験が「あり」なら
		SIF OPTION:2 == 1 && RAND:4 != 0
			LOCAL += 4
	;経験回数がかなり多い
	ELSEIF OPTION:0 == 4
		LOCAL = 8 + RAND:24
		SIF RAND:10 == 0
