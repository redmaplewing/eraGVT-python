		LOCAL = 0
		IF TALENT:ARG:交際相手 == 0 && OPTION:2 == 0
			IF OPTION:1 == 2 && RAND:4 == 0
				LOCAL = 1
			ELSEIF OPTION:1 == 1 && RAND:8 == 0
				LOCAL = 1
			ELSEIF OPTION:1 == 0 && RAND:12 == 0
				LOCAL = 1
			ENDIF
