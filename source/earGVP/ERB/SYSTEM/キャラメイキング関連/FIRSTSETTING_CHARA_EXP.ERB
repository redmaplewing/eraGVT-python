	IF OPTION:0 != 0
		;交際相手
		;彼氏
		SIF TALENT:ARG:交際相手 == 2
			LOCAL += RAND:3
		;婚約者
		SIF TALENT:ARG:交際相手 == 3
			LOCAL += RAND:6
		;人妻
		SIF TALENT:ARG:交際相手 == 4 || TALENT:ARG:交際相手 == 5
			LOCAL += RAND:12
