					EXP:ARG:Ｖ経験 += 1
					IF RAND:4 != 0
						SIF TALENT:ARG:未熟 != 1 && TALENT:ARG:ふたなり > 0
							EXP:ARG:射精経験 += 1
						SIF TALENT:ARG:母乳体質 > 0 && RAND:2 == 0
							EXP:ARG:噴乳経験 += 1
					ENDIF					
				ELSEIF RAND:10 == 0
					EXP:ARG:異常経験 += 1
					IF RAND:3 == 0 && TALENT:ARG:処女 == 0
						EXP:ARG:Ｖ拡張経験 += 1
					ELSEIF RAND:2 == 0
						EXP:ARG:Ａ拡張経験 += 1
					ELSE
