;================================================================
;ステータス表示画面の1ページ目（基本ステータス）の表示処理
; 引数
;	ARG	対象のキャラ番号
@SHOW_STATUS_CHARA_SELECT_PAGE1 , ARG
PRINTL 　　　　　　　　　　　　　　　　　基本ステータス情報　　　　　　　　　　　　　　PAGE(1/5)

;1番目のブロック
;左側に氏名・呼び名・一人称・性別・種族・性格を出力
;（2ページ目以降と出力は同じだが右側があるので共通関数を使えない）
;右側に各種設定変更ボタンを表示
;（ボタン表示があるので関数に分けないほうがいいと判断した）
DRAWLINE

;1行目：左側に氏名を出力、右側に主観モード変更ボタンを表示
PRINTFORM 氏名　：%NAME:ARG, 28, LEFT%
PRINTPLAIN 　
PRINTFORM [10]主観モードの変更：\@TALENT:ARG:主観視点 > 0 ? 使用する # 使用しない \@
PRINTL 

;2行目：左側に呼び名を出力、右側に呼び名の変更ボタンを表示
PRINTFORM 呼び名：%CALLNAME:ARG, 28, LEFT%
PRINTPLAIN 　
;戦闘中は変更不可
SIF FLAG:700 > 0
	SETCOLOR 105,105,105
PRINT [11]呼び名の変更
RESETCOLOR
PRINTL 

;3行目：左側に一人称を出力、右側に一人称変更ボタンを表示
PRINTFORM 一人称：%SELF_CALL(0, 0, ARG), 28, LEFT%
PRINTPLAIN 　
;戦闘中は変更不可
SIF FLAG:700 > 0
	SETCOLOR 105,105,105
PRINT [12]一人称の変更
RESETCOLOR
PRINTL 

;4行目：左側に性別を出力、右側に口上設定変更ボタンを表示
;memo:この作りはよくない。口上設定の種類名を返す式中関数を作り、それを呼び出すだけにするべき
PRINTFORM 性別　：%\@ISMALE(ARG) ? 男 # 女\@, 28, LEFT%
PRINTPLAIN 　
IF CFLAG:ARG:6 == -2
	PRINT [0] 口上設定（現在：非表示）　　　　
ELSEIF CFLAG:ARG:6 == -1
	PRINT [0] 口上設定（未教育）　　　　　　　
ELSEIF CFLAG:ARG:6 == 0
	PRINT [0] 口上設定（現在：女性汎用）　　　
ELSEIF CFLAG:ARG:6 == 1
	PRINT [0] 口上設定（現在：オトコ汎用）　　
ELSEIF CFLAG:ARG:6 == 2
	PRINT [0] 口上設定（現在：ロボ風）　　　　
ELSEIF CFLAG:ARG:6 == 3
	PRINT [0] 口上設定（現在：あなた）　　　　
ELSEIF CFLAG:ARG:6 == 4
	PRINT [0] 口上設定（現在：汎用豹変）　　　
ELSEIF NO:ARG != 0
	PRINT [0] 口上設定（現在：専用）　　　　　
ELSE
	SETCOLOR 105,105,105
	PRINTPLAIN [0]口上設定（現在：汎用）　　　　　
	RESETCOLOR
ENDIF
PRINTL 

;5行目：左側に種族を出力
CALL SHOW_STATUS_CHARA_SYUZOKU, ARG
PRINTL 
;6行目：左側に性格を出力
CALL SHOW_STATUS_CHARA_SEIKAKU, ARG
PRINTL 

;2番目のブロック
;変身能力がない場合このブロックは表示されない
;変身能力がある場合、変身後名と変身時掛け声を出力し、設定変更ボタンを表示
IF TALENT:ARG:変身能力 == 素質変身能力_あり
	CALL SHORTLINE
	PRINTFORM 【変身能力あり】
	PRINTPLAIN 　　　　　　　　　　　
	;戦闘中は変更不可
	SIF FLAG:700 > 0
		SETCOLOR 105,105,105
	PRINT [13]変身後名/掛け声の設定
	RESETCOLOR
	PRINTL 
	;変身後名が設定済みなら表示する
	IF CFLAG:ARG:2
		PRINTFORM 　変身後名　　：%CSTR:ARG:0%
		;さらに変身後の呼び名が設定済みで正式名と違うなら、括弧付けで表示
		SIF CFLAG:ARG:3 && CSTR:ARG:0 != CSTR:ARG:1
			PRINTFORM （%CSTR:ARG:1%）
		PRINTL 
	ENDIF
	;変身時掛け声が設定済みなら表示する
	SIF CFLAG:ARG:4
		PRINTFORML 　変身時かけ声：%CSTR:(ARG:0):2%
;非戦闘員の場合も、非戦闘員の表示だけする
ELSEIF TALENT;ARG:変身能力 == 素質変身能力_非戦闘員
	CALL SHORTLINE
	PRINTFORML 【非戦闘員】
ENDIF

;3番目のブロック
;現在のレベルや戦闘ステータスを出力
CALL SHORTLINE
CALL SHOW_STATUS_CHARA_BATTLESTATS, ARG

;4番目のブロック
;ステータス基礎値と戦技Lvを出力
CALL SHORTLINE
CALL SHOW_STATUS_CHARA_BASESTATS, ARG
CALL SHOW_STATUS_CHARA_SENGI, ARG

;5番目のブロック
;部位結界を出力（なければブロック自体表示されない）
IF TALENT:ARG:Ｃ結界 + TALENT:ARG:Ｖ結界 + TALENT:ARG:Ａ結界 + TALENT:ARG:Ｂ結界 + TALENT:ARG:避妊結界
	PRINTL 
	CALL SHORTLINE
	CALL SHOW_STATUS_CHARA_SHIELDS, ARG
ENDIF

;6番目のブロック
;淫紋の状態を出力（なければブロック自体表示されない）
IF CFLAG:ARG:32 > 0
	PRINTL 
	CALL SHORTLINE
	CALL SHOW_STATUS_CHARA_TATTOO, ARG
ENDIF
PRINTL 

;7番目のブロック
;服の状態を出力
CALL SHORTLINE
CALL SHOW_STATUS_CHARA_CLOTH, ARG
DRAWLINE
PRINTL

;================================================================
;ステータス表示の1ページ目（基本ステータス）の画面固有コマンド処理
; 引数
;	ARG				対象のキャラ番号
;	INPUT_CMD 		入力されたコマンド番号
; 戻り値
;	1:関数内でコマンド処理ができた
;	0:関数内に対応するコマンドがなかった
@CMD_STATUS_CHARA_SELECT_PAGE1, ARG, INPUT_CMD
#DIM LCOUNT
#DIM INPUT_CMD

SELECTCASE INPUT_CMD
	;口上設定
	CASE  0
		IF CFLAG:ARG:6 == 0
			CFLAG:ARG:6 = 1
		ELSEIF CFLAG:ARG:6 == 1
			CFLAG:ARG:6 = 2
		ELSEIF CFLAG:ARG:6 == 2
			CFLAG:ARG:6 = 3
			TALENT:ARG:主観視点 = 1
		ELSEIF CFLAG:ARG:6 == 3
			CFLAG:ARG:6 = 4
			TALENT:ARG:主観視点 = 0
		ELSEIF CFLAG:ARG:6 == 4
			CFLAG:ARG:6 = -2
		ELSEIF CFLAG:ARG:6 == NO:ARG
			CFLAG:ARG:6 = 0
		ELSE
			CFLAG:ARG:6 = NO:ARG
		ENDIF
	;主観モードの変更
	CASE 10
		IF TALENT:ARG:主観視点 == 1
			PRINTL 現在『主観モード』を使用中です
			PRINTL [0]変更しない
			PRINTL [1]主観モードを終了する
			INPUT
			IF RESULT == 1
				TALENT:ARG:主観視点 = 0
				PRINTW 地の文を変更しました
			ENDIF
		ELSE
			PRINTL ※地の文をより主観的な描写に変更します
			PRINTL 　この設定は個別に適用されます
			PRINTL [0]使用しない
			PRINTL [1]使用する
			INPUT
			IF RESULT == 1
				TALENT:ARG:主観視点 = 1
				PRINTW 地の文を変更しました
			ENDIF
		ENDIF
	;呼び名・一人称・変身後名等の設定（非戦闘中限定）
	CASE 11,12,13
		;戦闘中なら処理不可
		SIF FLAG:700
			RETURN 0
		;キャラの呼び名の設定
		IF INPUT_CMD == 11
			CALL FIRSTSETTING_CHARA_CALLNAME, ARG
		;キャラの一人称の設定
		ELSEIF INPUT_CMD == 12
			CALL FIRSTSETTING_CHARA_SELFCALL, ARG
		;キャラの変身後名・呼び名・かけ声・名乗り口上の設定
		ELSE
			;変身能力ありでなければ処理不可
			SIF TALENT:ARG:変身能力 != 素質変身能力_あり
				RETURN 0
			LCOUNT = LINECOUNT
			$LOOP_12
			PRINTFORML 変更する項目を選択してください
			CALL SHORTLINE
			PRINTFORML [0]　変身後名・・・・・・\@(CFLAG:ARG:2 == 1) ?・『%CSTR:ARG:0%』#・ なし\@
			PRINTFORML [1]　変身後呼び名・・・・\@(CFLAG:ARG:3 == 1) ?・『%CSTR:ARG:1%』#・ なし\@
			PRINTFORML [2]　変身時かけ声・・・・\@(CFLAG:ARG:4 == 1) ?・『%CSTR:ARG:2%』#・ なし\@
			PRINTFORML [3]　変身後名乗り口上・・\@(CFLAG:ARG:5 == 1) ?・『%CSTR:ARG:3%』#・ なし\@
			PRINTL 
			PRINTFORML [99] 戻る
			$INPUT_LOOP_12
			INPUT
			IF RESULT == 0
				;キャラの変身後名前の設定
				CALL FIRSTSETTING_CHARA_TRANSAFTERNAME, ARG
			ELSEIF RESULT == 1
				;キャラの変身後呼び名の設定
				IF CFLAG:ARG:2 == 1
					;キャラの変身後呼び名フラグを立てる
					CFLAG:ARG:3 = 1
					CALL FIRSTSETTING_CHARA_TRANSAFTERCALLNAME, ARG
				ENDIF
			ELSEIF RESULT == 2
				;キャラの変身時のかけ声の設定
				CALL FIRSTSETTING_CHARA_TRANSCALL, ARG
			ELSEIF RESULT == 3
				;キャラの名乗り口上の設定
				CALL FIRSTSETTING_CHARA_NANORI, ARG
			ELSEIF RESULT == 99
				RETURN 1
			ELSE
				GOTO INPUT_LOOP_12
			ENDIF
			CLEARLINE LINECOUNT - LCOUNT
			GOTO LOOP_12
		ENDIF
	;対応するコマンド処理なし
	CASEELSE
		RETURN 0
ENDSELECT
RETURN 1

;================================================================
;	以降、画面表示の各部分を担当する関数群
;================================================================
;--------------------------------------------------
;種族表示
; 引数
;	ARG	対象のキャラ番号
