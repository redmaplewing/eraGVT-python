;*******************************************************************************************************
;悪落ち時に容姿を変更する
;陥落経験が多いほど、復帰時に容姿が戻る確率が下がる。
;CSTR:50〜に悪堕ち後の容姿を登録し、元の容姿と入れ替える。
;変身キャラは変身後の容姿を変更する。

;肌色の変更は陥落経験が一定以上で発生。
;全ての変更が定着すると素質【完堕ち】を追加。目つきが戻らなくなる。

;変身後名は自称感があるので、悪堕ち中のみ変更する。

;進捗はCFLAG80にビットで保持。
;0=初回登録済み 1=肌色登録済み 2=悪堕ち中（CFLAG:0の復帰後に容姿復帰判定があるので、見分け用） 3 = 髪型登録 4=髪色登録 5=目色登録
;定着状態はCFLAG81にビットで保持
;0=髪色定着 1=右目の色定着 2=左目の色定着 3 = 肌色定着 4=全定着
;*******************************************************************************************************
@CORRUPT_CHANGE_LOOKS_MAIN, ARG

;コンフィグ未設定なら実行しない
SIF CONFIG_CHECK_PRISON_F(4) == 0
	RETURN 1

;悪堕ち変身名の定義
SIF TALENT:ARG:変身能力 == 1
	CALL CORRUPT_GET_SPNAME, ARG


;プロフィール未設定なら実行しない
SIF CFLAG:ARG:34 == 0
	RETURN 1

SIF GETBIT(CFLAG:ARG:80, 0) == 0
	SETBIT CFLAG:80, 0

;目つき
CALL GET_CORRUPTED_EYES, ARG

;髪型登録
IF GETBIT(CFLAG:ARG:80, 3) == 0 && CONFIG_CHECK_PRISON_F(5) == 1
	CALL GET_CORRUPTED_HAIR, ARG
	SETBIT CFLAG:80, 3
ENDIF

;髪色登録
IF GETBIT(CFLAG:ARG:80, 4) == 0 && CONFIG_CHECK_PRISON_F(6) == 1
	CALL CORRUPT_CHANGE_HAIR_COLOR, ARG
	SETBIT CFLAG:80, 4
ENDIF

;目色登録
IF GETBIT(CFLAG:ARG:80, 5) == 0 && CONFIG_CHECK_PRISON_F(7) == 1
	CALL CORRUPT_CHANGE_EYE_COLOR, ARG
	SETBIT CFLAG:80, 5
ENDIF

;肌色登録
IF GETBIT(CFLAG:ARG:80, 1) == 0 && EXP:ARG:陥落経験 >=3 && CONFIG_CHECK_PRISON_F(8) == 1
	CALL CORRUPT_CHANGE_SKIN, ARG
	SETBIT CFLAG:80, 1
ENDIF

;容姿変更・すり替え
CALL CORRUPT_CHANGE_LOOKS, ARG

SETBIT CFLAG:80, 2

;色が定着していなければ、色変えメッセージ表示
;髪型が登録されているか、髪色が登録済みで定着していない場合
IF CONFIG_CHECK_PRISON_F(5) == 1 || CONFIG_CHECK_PRISON_F(6) == 1
	SIF GETBIT(CFLAG:ARG:80, 3) == 1 || (GETBIT(CFLAG:ARG:80, 4) == 1 && GETBIT(CFLAG:ARG:81, 0) == 0)
		CALL MESSAGE_CORRUPT_CHANGE_LOOKS_HAIR(ARG)
ENDIF

;完堕ち前は目つきの変更が発生
SIF GETBIT(CFLAG:ARG:81, 4) == 0
		CALL MESSAGE_CORRUPT_CHANGE_LOOKS_EYES(ARG)
		
IF CONFIG_CHECK_PRISON_F(8) == 1
	SIF GETBIT(CFLAG:ARG:80, 1) == 1 && GETBIT(CFLAG:ARG:81, 3) == 0
		CALL MESSAGE_CORRUPT_CHANGE_LOOKS_SKIN(ARG)
ENDIF

;変身名の改竄告知
SIF TALENT:ARG:変身能力 == 1 && CFLAG:ARG:2 == 1
	CALL MESSAGE_CORRUPT_CHANGE_SP_NAME(ARG)
RETURN 0

;*******************************************************************************************************

;*******************************************************************************************************
;元の容姿と登録された容姿を入れ替え
;CSTR50:目つき
;CSTR51:髪色
;CSTR52:右目の色
;CSTR53:左目の色
;CSTR54:肌の色
;CSTR55:キャラの変身後名
;CSTR56:キャラの変身後呼び名
;CSTR57:キャラの前髪
;CSTR58:キャラの髪型
;*******************************************************************************************************
@CORRUPT_CHANGE_LOOKS, ARG
#DIM HAIRSTYLE
#DIM HAIRCOLOR
#DIM REYE
#DIM LEYE
#DIM SKIN

;CSTR番号
IF TALENT:ARG:変身能力 == 1
	HAIRSTYLE = 14
	HAIRCOLOR = 31
	REYE = 34
	LEYE = 35
	SKIN = 37
	
ELSE
	HAIRSTYLE = 13
	HAIRCOLOR = 30
	REYE = 32
	LEYE = 33
	SKIN = 36
ENDIF

;目つき
CALL EXCHANGE_CSTR (ARG, 50, 18)
;髪型
IF GETBIT(CFLAG:ARG:80, 3) == 1 && CONFIG_CHECK_PRISON_F(5) == 1
	CALL EXCHANGE_CSTR (ARG, 57, 12)
	CALL EXCHANGE_CSTR (ARG, 58, HAIRSTYLE)
ENDIF
;髪色
SIF GETBIT(CFLAG:ARG:80, 4) == 1 && CONFIG_CHECK_PRISON_F(6) == 1
	CALL EXCHANGE_CSTR (ARG, 51, HAIRCOLOR)
;目色
IF GETBIT(CFLAG:ARG:80, 5) == 1 && CONFIG_CHECK_PRISON_F(7) == 1
	CALL EXCHANGE_CSTR (ARG, 52, REYE)
	CALL EXCHANGE_CSTR (ARG, 53, LEYE)
ENDIF
;肌
SIF GETBIT(CFLAG:ARG:80, 1) == 1 && CONFIG_CHECK_PRISON_F(8) == 1
	CALL EXCHANGE_CSTR (ARG, 54, SKIN)

;変身後名の改竄
IF TALENT:ARG:変身能力 == 1
	IF GETBIT(CFLAG:ARG:13,0) == 0
		SETBIT CFLAG:ARG:13,0
		PRINTFORML %PRINT_TRANSNAME(ARG)%の変身後名が書き換えられてゆく……
		SETCOLOR 96,96,96
		PRINTFORML 　　　　%CSTR:ARG:0%

		;本来の変身名・呼び名と入れ替え
		;transname
		CALL EXCHANGE_CSTR (ARG, 55, 0)
		CALL SETCOLOR_BY_STR, "紫"
		PRINTFORML 　　　　　————%CSTR:ARG:0%
		RESETCOLOR
		PRINTW 
		;transcallname(＝変身名だった場合)
		IF GETBIT(CFLAG:ARG:13,1) == 0 && CSTR:1 == CSTR:0
			SETBIT CFLAG:ARG:13,1
			CALL EXCHANGE_CSTR (ARG, 56, 1)
		ENDIF
	ENDIF
ENDIF

IF TALENT:ARG:完堕ち == 1
	IF TALENT:ARG:変身能力 == 1
		;名乗りの無様改変
		IF GETBIT(CFLAG:ARG:13,3) == 0
			SETBIT CFLAG:ARG:13,3

			PRINTFORML %PRINT_TRANSNAME(ARG)%の決め台詞が書き換えられていく……

			;主題部分の個人改竄(個人単位での上書き用)
			CALL CORRUPTTION_GET_THEME, ARG

			SETCOLOR 96,96,96
			PRINTFORML 　%CSTR:ARG:3%

			;本来の名乗りをバックアップ(改変時に本来の名乗りを参照するのでここでは値コピーにする)
			CALL CORRUPTTION_GET_NANORI_FINAL(ARG)

			CALL SETCOLOR_BY_STR, "橙"
			PRINTFORML 　　————%CSTR:ARG:3%
			RESETCOLOR
			PRINTW
		ENDIF
		;＠中国版　完堕ち装備
		;変身能力アリなら淫縛の鎖
		IF CFLAG:ARG:41 != 402
			CFLAG:ARG:41 = 402
			CFLAG:42 = 0
			CALL SETCOLOR_BY_STR, "桃"
			PRINTFORML %PRINT_TRANSNAME(ARG)%の変身後衣装が【%ITEMNAME:402%】になった！
			RESETCOLOR
			PRINTW
		ENDIF

	ELSE
		;＠中国版　完堕ち装備
		;変身能力ナシなら触手の花嫁／noinner
		IF CFLAG:ARG:40 != 196
			CFLAG:ARG:40 = 196
			CFLAG:42 = 0
			CALL SETCOLOR_BY_STR, "桃"
			PRINTFORML %PRINT_TRANSNAME(ARG)%の衣装が【%ITEMNAME:196%】になった！
			RESETCOLOR
			PRINTW
		ENDIF
	ENDIF
ENDIF




RETURN 0

