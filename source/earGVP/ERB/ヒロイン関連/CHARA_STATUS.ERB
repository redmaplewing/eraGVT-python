;--------------------------------------------------
;戦闘用		蓄積ダメージ表示
;ここでTCVARn:206（蓄積ダメージ限度値）の値を定める
@STATUS_PRINT_CHARGE
;消耗度（体力+気力+{疲労度*150}）によって限度値(%)が変動する
;消耗度100%~75%：最大体力の120%		消耗度74%~40%：最大体力の100%	消耗度39%~：最大体力の80%
SELECTCASE PERCENT_CAL_F(BASE:体力 + BASE:気力 + (CFLAG:99 * 150), MAXBASE:体力 + MAXBASE:気力)
	CASE 0 TO 39
		LOCAL:0 = 80
	CASE 40 TO 74
		LOCAL:0 = 100
	CASEELSE
		LOCAL:0 = 120
ENDSELECT

TCVARn:206 = MAXBASE:体力 * LOCAL:0 / 100

LOCAL:1 = PERCENT_CAL_F(TCVARn:205, TCVARn:206)
IF LOCAL:1 <= LOCAL:0
	LOCAL:2 = 60
	LOCAL:3 = 75
	LOCAL:4 = 215
ELSEIF INRANGE(LOCAL:1,LOCAL:0,LOCAL:0+20)
	LOCAL:2 = 255
	LOCAL:3 = 255
	LOCAL:4 = 0
ELSEIF INRANGE(LOCAL:1,LOCAL:0,LOCAL:0+40)
	LOCAL:2 = 255
	LOCAL:3 = 123
	LOCAL:4 = 0
ELSE
	LOCAL:2 = 255
	LOCAL:3 = 0
	LOCAL:4 = 0
ENDIF

SIF LOCAL:1 > LOCAL:0
	SETCOLOR LOCAL:2,LOCAL:3,LOCAL:4

FONTBOLD
PRINT CHARGE.
FONTITALIC

PRINTFORM %UNICODE(0x208D)%
CALL COLOR_BAR(TCVARn:205, TCVARn:206, 20, LOCAL:2, LOCAL:3, LOCAL:4, -160, 10, 18, 6, 2, UNICODE(0x25AE), UNICODE(0x25AE))
SIF LOCAL:1 > LOCAL:0
	SETCOLOR LOCAL:2,LOCAL:3,LOCAL:4
PRINTFORM %UNICODE(0x208E)%

FONTREGULAR
PRINTFORM （{TCVARn:205, 5}/{TCVARn:206, 5}）
RESETCOLOR

