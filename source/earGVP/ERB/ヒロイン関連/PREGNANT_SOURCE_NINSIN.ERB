;CFLAG:221前回出産からの膣出回数
;CFLAG:222妊娠日数*2
;CFLAG:223触手日霊
;CFLAG:224育児日数
;TALENT:妊娠 妊娠中


;------------------------------
;受精判定
;------------------------------
@NINSIN_HANTEI,ARG:0,ARG:1,ARG:2 = 0
#DIM PAPA_ID
;千分率
#DIM PREG_PER

SIF ISMALE()
	RETURN 0
SIF TALENT:未熟 > 0
	RETURN 0
SIF TALENT:妊娠 > 0
	RETURN 0
;常時避妊モード
SIF CONFIG_CHECK_OTHER_F(2) > 0
	RETURN 0
;避妊効果
IF CHECK_HININ_F(TARGET, ARG:2) == 1
	;戦闘中かつ避妊に成功した場合は射精量をプールする
	SIF FLAG:700 > 0
		TFLAG:6 += ARG:0
	RETURN 0
ELSE
	;戦闘中かつ避妊に失敗した場合はプールした射精量を戻す
	SIF FLAG:700 > 0
		ARG:0 += TFLAG:6
	TFLAG:6 = 0
ENDIF
;父親のＩＤを取得
;幽閉中の場合は幽閉相手
IF (CFLAG:0 == 1 || CFLAG:0 == 2 || CFLAG:0 == 3 || CFLAG:0 == 9) && ARG:2 == 0
	PAPA_ID = CFLAG:21 + (CFLAG:20 == 1) * 100
;戦闘中の場合
ELSEIF FLAG:700 > 0 && ARG:2 == 0
	;洗脳/悪堕ちキャラの場合、そのキャラのＩＤ
	IF ENEMY_TYPE_CHECK_F("AKUOTI") > 0
		PAPA_ID = CFLAG:(FLAG:111):240 * -1 - 100
		;寄生ふたなりの場合
		SIF (TALENT:(FLAG:111):ふたなり == 2 || TALENT:(FLAG:111):変身時ふたなり == 2) && RAND:4 != 0
			PAPA_ID = 200
	;その他の場合
	ELSE
		;戦闘中の触手のＩＤ
		PAPA_ID = FLAG:11
		;ラスボス触手の場合
		IF ENEMY_TYPE_CHECK_F("LASTBOSS") >= 1
			PAPA_ID += 100
		;雑魚敵の場合
		ELSEIF ENEMY_TYPE_CHECK_F("MOB") == 1 || ENEMY_TYPE_CHECK_F("CITIZEN") == 1
			PAPA_ID += 200
		ENDIF
	ENDIF
;それ以外の場合
ELSE
	PAPA_ID = ARG:2
	;寄生ふたなりの場合
	SIF (TALENT:(CHARAID_F(ARG:2 * -1 - 100)):ふたなり == 2 || TALENT:(CHARAID_F(ARG:2 * -1 - 100)):変身時ふたなり == 2) && RAND:4 != 0
		PAPA_ID = 200
ENDIF
;中出し累積回数を加算
CFLAG:221 += ARG:0
;精液の種類ごとに累積数を加算
;触手の場合
IF PAPA_ID > 0
	CFLAG:232 += ARG:0
	SQRT (ARG:1 * CFLAG:232 * (EXP:出産経験 + 1) / 2)
	PREG_PER = RESULT
;仲間キャラの場合
ELSEIF PAPA_ID <= -100
	FOR LOCAL, 0, CHARANUM
		SIF LOCAL == MASTER
			CONTINUE
		;寄生されてるなら触手、そうでなければ人間扱い
		IF CFLAG:LOCAL:240 == (PAPA_ID * -1 - 100) && TALENT:LOCAL:寄生 > 0
			CFLAG:232 += ARG:0
			SQRT (ARG:1 * CFLAG:232 * (EXP:出産経験 + 1) / 2)
			PREG_PER = RESULT
		ELSEIF CFLAG:LOCAL:240 == (PAPA_ID * -1 - 100)
			CFLAG:233 += ARG:0
			SQRT (ARG:1 * CFLAG:233 * (EXP:出産経験 + 1) / 2)
			PREG_PER = RESULT
		ENDIF
	NEXT
;一般人の場合
ELSEIF PAPA_ID <= -1
	CFLAG:233 += ARG:0
	SQRT (ARG:1 * CFLAG:233 * (EXP:出産経験 + 1) / 2)
	PREG_PER = RESULT
ENDIF
;妊娠確率補正
SIF FLAG:700 == 1
	PREG_PER = PREG_PER * 2
SIF TALENT:苗床化
	PREG_PER = PREG_PER * 4
;妊娠確率アップの効果
SIF FLAG:909
	PREG_PER = PREG_PER * 2
;避妊結界持ちが破られた場合、かつ相手が触手の場合は妊娠確率アップ
SIF TALENT:避妊結界 > 0 && PAPA_ID > 0
	PREG_PER = PREG_PER * 2
;FEAT効果による妊娠確率補正
SIF TALENT:獣性の証 > 0
	PREG_PER = PREG_PER * 125 / 100
SIF TALENT:祝福 > 0
	PREG_PER = PREG_PER * 150 / 100
SIF TALENT:不老長寿 > 0
	PREG_PER = PREG_PER * 75 / 100
SIF (TCVARn:12 & 発情)
	PREG_PER = PREG_PER * 2
;危険日判定(雑に1.5倍とする)
SIF ESTRUS_TEXT_F(TARGET)!=""
	PREG_PER = PREG_PER * 3/2
SIF (TCVARn:12 & 排卵)
	PREG_PER = 1000

;debug妊娠確率表示
IF FLAG:999 == 1
	PRINTL 
	PRINTFORML 基本妊娠確率を入力してください。（負の数で変更なし）
	INPUT
	IF RESULT < 0
	ELSE
		PREG_PER = RESULT * 10
	ENDIF
	SETCOLOR 128,128,128
	PRINTL 
	PRINTFORML 　　妊娠確率 {(PREG_PER + 100 * (CFLAG:0 == 0)) / 10}％
	PRINTL 
	RESETCOLOR
ENDIF
;幽閉されてなければ10%増し
IF RAND:1000 < (PREG_PER + 100 * (CFLAG:0 == 0)) && (TALENT:妊娠 == 0)
	;屈服の珠の増加
	CALL NINSIN_SUBMIT
	;妊娠したら累積中出回数を0に
	CFLAG:221 = 0
	CFLAG:232 = 0
	CFLAG:233 = 0
	;ここで父親の記録を行う
	CFLAG:230 = PAPA_ID
	CALL NINSIN_FLAG
	IF FLAG:700 == 1
		CALL TENTACLE_ACCESS, "GETNAME"
		IF RESULTS == "Ｈ触手" && (TCVARn:12 & 排卵)
			PRINTFORML Ｈ触手が広げた薄膜のモニターには%PRINT_TRANSCALLNAME(TARGET)%の胎内の様子が映し出されており、
			PRINTFORML 成熟した卵子の周りには無数の触手の精子が群がっている。
			PRINTFORML そのうちの一匹が表皮を突き破って悲願を達成し、爆発的な細胞の増殖が始まった。
			PRINTFORML %PRINT_TRANSCALLNAME(TARGET)%は目の前で異種間受精の瞬間を見せつけられてしまった・・・
			PRINTW 
			TALENT:妊娠 = 1
			PRINTFORMW %PRINT_TRANSCALLNAME(TARGET)%は[妊娠]した
			CALL NINSIN_TS_FIX
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 0
;------------------------------
;戦闘終了時の妊娠チェック
;------------------------------
@NINSIN_CHECK_AFTER
;戦闘終了後に初めて地の文が流れる
IF TALENT:妊娠 == 2 && ISFEMALE()
	IF CONFIG_CHECK_OTHER_F(0) > 0
		;触手を妊娠する場合（通常50%、苗床化されている場合は75%）
		IF RAND:100 < 50 + (TALENT:苗床化 > 0) * 25
			TALENT:妊娠 = 1
			CFLAG:227 = NUM_CHILD_TENTACLE(TARGET)
			CFLAG:228 = PREGNANT_RANDOM_SIZE(TARGET)
		ELSE
			TALENT:妊娠 = 3
			CFLAG:228 = PREGNANT_RANDOM_SIZE(TARGET)
		ENDIF
	ELSE
		TALENT:妊娠 = 1
		CFLAG:227 = NUM_CHILD_TENTACLE(TARGET)
		CFLAG:228 = PREGNANT_RANDOM_SIZE(TARGET)
	ENDIF
	PRINTL 
	CALL MESSAGE_NINNSIN
	CALL NINSIN_TS_FIX
ENDIF

;------------------------------
;妊娠フラグを立てて地の文表示
;------------------------------
@NINSIN_FLAG
#DIM CCOUNT
;仲間が父親の場合
IF CFLAG:230 <= -100
	FOR CCOUNT, 0, CHARANUM
		SIF CCOUNT == MASTER
			CONTINUE
		;父親を判定
		IF CFLAG:CCOUNT:240 == CFLAG:230 * -1 - 100
			;父親も母親も寄生されていない場合
			IF TALENT:CCOUNT:寄生 == 0 && TALENT:寄生 == 0
				TALENT:妊娠 = 4
				CFLAG:228 = PREGNANT_RANDOM_SIZE(TARGET)
			ELSE
				TALENT:妊娠 = 2
			ENDIF
		ENDIF
	NEXT
;普通の人間が父親の場合
ELSEIF CFLAG:230 <= -1
	;母親が寄生されていない場合
	IF TALENT:寄生 == 0
		TALENT:妊娠 = 4
		CFLAG:228 = PREGNANT_RANDOM_SIZE(TARGET)
	ELSE
		TALENT:妊娠 = 2
	ENDIF
;それ以外の場合は通常の妊娠フラグを立てる
ELSE
	TALENT:妊娠 = 2
ENDIF
;幽閉中の場合、または戦闘中でない場合は即時に妊娠する
IF CFLAG:21 > 0 || (FLAG:700 == 0 && TALENT:妊娠 == 2)
	IF CONFIG_CHECK_OTHER_F(0) > 0
		;触手を妊娠する場合（通常50%、苗床化されている場合は75%）
		IF ((RAND:100 < 50 + (TALENT:苗床化 > 0) * 25) || CFLAG:22 != 0) && CFLAG:0 == 1
			TALENT:妊娠 = 1
			CFLAG:227 = NUM_CHILD_TENTACLE(TARGET)
			CFLAG:228 = PREGNANT_RANDOM_SIZE(TARGET)
		ELSE
			TALENT:妊娠 = 3
			CFLAG:228 = PREGNANT_RANDOM_SIZE(TARGET)
		ENDIF
	ELSE
		TALENT:妊娠 = 1
		CFLAG:227 = NUM_CHILD_TENTACLE(TARGET)
		CFLAG:228 = PREGNANT_RANDOM_SIZE(TARGET)
	ENDIF
	PRINTL 
	CALL MESSAGE_NINNSIN
	CALL NINSIN_TS_FIX
ENDIF
;ＴＳ変身時の正常妊娠の場合、オトコに戻れなくなる
IF ISFEMALE() && TALENT:変身時ＴＳ > 0 && CFLAG:1 > 0 && TALENT:妊娠 == 4
	PRINTW 
	PRINTFORML %PRINT_CALLNAME(TARGET,1)%の様子がおかしい…
	PRINTFORML なぜか分からないが、身体の奥底に何か違和感を感じる…
	PRINTL 
	PRINTFORML %PRINT_CALLNAME(TARGET,1)%は[オトコ]に戻れなくなった
	PRINTW 
	;女体化処理
	CALL TS_MtoF, TARGET
ENDIF

;------------------------------
;ＴＳ魔法少女の場合、妊娠するとオトコに戻れなくなるor一時的にオトコに変身できなくなる
;------------------------------
@NINSIN_TS_FIX
IF ISFEMALE() && TALENT:変身時ＴＳ > 0 && CFLAG:1 > 0
	;地の文
	CALL MESSAGE_NINNSIN_TS_FIX
	;女体化処理
	CALL TS_MtoF, TARGET
ELSEIF ISFEMALE() && TALENT:変身時ＴＳ > 0 && CFLAG:1 == 0
	;地の文
	CALL MESSAGE_NINNSIN_TS_FIX
ENDIF

;------------------------------
;妊娠段階進行・出産判定
;触手に孕まされた場合と人間相手に妊娠した場合で管理が異なる
;------------------------------
@BIRTH_HANTEI
#DIM CCOUNT
LOCAL:0 = TARGET
FOR CCOUNT,0,CHARANUM
	TARGET = CCOUNT
	SIF CFLAG:0 == 9
		CONTINUE

	;●触手に孕まされている場合
	IF TALENT:妊娠 == 1 || TALENT:妊娠 == 3
		;幽閉中でなく出産直前なら　コマンド入力できない(ソロモードは構わず戦う)
		IF CFLAG:0 == 0 && (CFLAG:222 > 9 || (TALENT:苗床化 > 0 && CFLAG:222 > 3))
			CFLAG:0 = 10
			CALL MESSAGE_MATANITY
			CALL SET_PARTYMEMBER
			DRAWLINE
		ENDIF
		;苗床化は３倍速で成長する
		IF TALENT:苗床化 > 0
			CFLAG:222 += 3
		ELSE
			CFLAG:222 += 1
		ENDIF
		;幽閉中はさらに成長が早まる
		SIF CFLAG:0 == 1
			CFLAG:222 += 2
		;出産可能かどうか
		IF CFLAG:222 > 10
			;フィルタ×でなく、母乳体質でないなら母乳体質にする
			IF TALENT:母乳体質 == 0 && CONFIG_CHECK_MANIAC_F(2) == 1
				TALENT:母乳体質 = 1
				PRINTFORML %PRINT_CALLNAME(TARGET,1)%の胸が張ってきた…
				PRINTL
				PRINTFORML %PRINT_CALLNAME(TARGET,1)%は[%TALENTNAME:1%]になった…
			ENDIF
			;確率で出産　最短5日最長7日半。ただし幽閉中に苗床化されてると常に1/2の確率で即出産
			IF CFLAG:222 >= 30
				LOCAL:1 = 0
			ELSE
				LOCAL:1 = RAND:(30 - CFLAG:222)
			ENDIF
			IF (LOCAL:1 == 0 && CFLAG:222 >= 10) || CFLAG:222 >= 15 || (CFLAG:0 == 1 && TALENT:苗床化 > 0 && RAND:2 == 0)
				;産む
				IF TALENT:妊娠 == 3 && CONFIG_CHECK_OTHER_F(0) > 0
					CALL BIRTH_DAUGHTER_TENTACLE_ORIGIN
				ELSE
					CALL BIRTH_TENTACLES
				ENDIF
			ENDIF
		ENDIF
	;●(ヒト相手に)正常妊娠の場合
	;　しばらくは無自覚
	ELSEIF TALENT:妊娠 == 4
		;苗床化は３倍速で成長する
		IF TALENT:苗床化 > 0
			CFLAG:222 += 3
		ELSE
			CFLAG:222 += 1
		ENDIF
		IF CFLAG:222 >= 20
			PRINTFORML %PRINT_CALLNAME(TARGET,1)%の腹部が明らかに膨らんできている…
			PRINTFORML もう妊娠していることは誰の目にも明らかだ…
			IF ISFEMALE() && TALENT:変身時ＴＳ > 0 && CFLAG:1 == 0
				PRINTW 
				PRINTFORML %PRINT_CALLNAME(TARGET)%は妊娠している間は変身できなくなります
			ENDIF
			PRINTW 
			TALENT:妊娠 = 5
		ELSEIF CFLAG:222 == 12
			PRINTFORML %PRINT_CALLNAME(TARGET,1)%の腹部が膨らんできたような気がする…
			IF CFLAG:21>0
				PRINTFORML 幽閉された身で検査を受けられるはずもなく、%PRINT_CALLNAME(TARGET,1)%はただ不安げに腹部を眺めている…
			ELSE
				PRINTFORML 今まで先延ばしにしてきたが、ちゃんと検査をしておいた方が良いだろう…
			ENDIF
			PRINTW 
		ELSEIF CFLAG:222 == 9
			PRINTFORML %PRINT_CALLNAME(TARGET,1)%の様子がおかしい…
			PRINTFORML 時折強い吐き気を感じているようだ…
			PRINTW 
		ELSEIF CFLAG:222 == 6
			PRINTFORML %PRINT_CALLNAME(TARGET,1)%の様子がおかしい…
			IF RAND:2 == 0
				PRINTFORML 前回から随分と生理が遅れているようだ…
			ELSE
				PRINTFORML 何やら軽い吐き気のようなものを感じているようだ…
			ENDIF
			IF CFLAG:21>0
				PRINTFORML もしも無事な身であれば、医務室で然るべき検査を受けられたのだろうが…
			ELSE
				PRINTFORML 心当たりがあるなら、医務室で検査してみた方が良いかもしれない…
			ENDIF
			PRINTW 
		ENDIF
	;妊娠自覚済み
	ELSEIF TALENT:妊娠 == 5
		;幽閉中でなく出産直前なら　コマンド入力できない(ソロモードは構わず戦う)
		IF CFLAG:0 == 0 && CFLAG:222 > 42
			CFLAG:0 = 10
			CALL MESSAGE_MATANITY
			CALL SET_PARTYMEMBER
			DRAWLINE
		ENDIF
		;苗床化は３倍速で成長する
		IF TALENT:苗床化 > 0
			CFLAG:222 += 3
		ELSE
			CFLAG:222 += 1
		ENDIF
		IF CFLAG:222 >= 16
			;フィルタ×でなく、母乳体質でないなら母乳体質にする
			IF TALENT:母乳体質 == 0 && CONFIG_CHECK_MANIAC_F(2) == 1
				TALENT:母乳体質 = 1
				PRINTFORML %PRINT_CALLNAME(TARGET,1)%の胸が張ってきた…
				PRINTL
				PRINTFORML %PRINT_CALLNAME(TARGET,1)%は[%TALENTNAME:1%]になった…
				PRINTW 
			ENDIF
		ENDIF
		;出産可能化どうか
		;確率で出産　最短26日最長28日半。
		IF CFLAG:222 >= 83
			LOCAL:1 = 0
		ELSE
			LOCAL:1 = RAND:(83 - CFLAG:222)
		ENDIF
		SIF (LOCAL:1 == 0 && CFLAG:222 >= 53) || CFLAG:222 >= 56
			CALL BIRTH_DAUGHTER_HUMAN_ORIGIN
	ELSE
		CONTINUE
	ENDIF

NEXT
TARGET =LOCAL:0

;------------------------------
;出産(孕まされた触手or異形を産み落とす)
;------------------------------
;LOCAL:1 触手の数
@BIRTH_TENTACLES
;出産するキャラは疲労度が蓄積する
CFLAG:99 += 45 + PREGNANCY_BELLY_EXPAND(TARGET) / 20
;生存時に再び行動可能に復帰する
SIF CFLAG:0 == 10
	CALL RECOVER_TO_PARTY,TARGET
;幽閉中とそれ以外で地の文が違う
LOCAL:1 = CFLAG:227
IF CFLAG:21 != 0
	;異形出産描写
	IF CONFIG_CHECK_MANIAC_F(4) == 1
		;育児機能オンなら合いの子率アップ
		IF RAND:4 == 0 || (CONFIG_CHECK_OTHER_F(0) > 0 && RAND:4 != 0)
			CALL MESSAGE_BIRTH_AINOKO_PRISON,LOCAL:1
		ELSE
			CALL MESSAGE_BIRTH_TENTACLES_PRISON,LOCAL:1
		ENDIF
	ELSE
		CALL MESSAGE_BIRTH_TENTACLES_PRISON,LOCAL:1
	ENDIF
	CFLAG:223 = 1
	;今回の出産数を加算
	CFLAG:220 += LOCAL:1
	FLAG:44 += LOCAL:1
ELSE
	CALL MESSAGE_BIRTH_TENTACLES,LOCAL:1
	PRINTL
	;組織にいる場合は触手の欠片追加
	FLAG:200 += LOCAL:1
	PRINTFORML 触手の欠片＋{LOCAL:1}
ENDIF

CALL ABL_UP_BIRTH,LOCAL:1
CALL _ABLUP,1

;妊娠日数中だし回数のリセット、素質[妊娠]の削除
CFLAG:221 = 0
CFLAG:222 = 0
CFLAG:227 = 0
CFLAG:228 = 0
CFLAG:232 = 0
CFLAG:233 = 0
TALENT:妊娠 = 0

;------------------------------
;出産時に上がる能力の計算
;------------------------------
@ABL_UP_BIRTH,ARG
#DIM LCOUNT
VARSET LOCAL

;体力気力の減少処理
BASE:体力 = MAX(BASE:体力/2-500,1)
BASE:気力 = MAX(BASE:体力/2-500,1)

LOCAL = 100

;《従順》をみる
IF ABL:従順 == 0
	TIMES LOCAL , 0.20
ELSEIF ABL:従順 == 1
	TIMES LOCAL , 0.50
ELSEIF ABL:従順 == 2
	TIMES LOCAL , 0.70
ELSEIF ABL:従順 == 3
	TIMES LOCAL , 1.00
ELSEIF ABL:従順 == 4
	TIMES LOCAL , 1.50
ELSE
	TIMES LOCAL , 2.00
ENDIF

;《触手中毒》をみる
IF ABL:触手中毒 == 0
	TIMES LOCAL , 1.00
ELSEIF ABL:触手中毒 == 1
	TIMES LOCAL , 1.10
ELSEIF ABL:触手中毒 == 2
	TIMES LOCAL , 1.30
ELSEIF ABL:触手中毒 == 3
	TIMES LOCAL , 1.50
ELSEIF ABL:触手中毒 == 4
	TIMES LOCAL , 2.00
ELSE
	TIMES LOCAL , 2.50
ENDIF

;《出産経験》をみる
IF EXP:出産経験 < 1
	TIMES LOCAL , 0.50
ELSEIF EXP:出産経験 < 10
	TIMES LOCAL , 0.70
ELSEIF EXP:出産経験 < 30
	TIMES LOCAL , 1.00
ELSEIF EXP:出産経験 < 50
	TIMES LOCAL , 2.00
ELSE
	TIMES LOCAL , 4.00
ENDIF
;修練P入手
CALL GET_SYUREN,LOCAL/10
;組織にいると威力3倍
SIF CFLAG:0 == 10
	TIMES LOCAL , 3.00
;珠ゲット
	LOCAL:1 += (ABL:Ｖ感覚 + 1) * 10 * LOCAL * (1 + (TALENT:Ｖ敏感 > 0) + (TALENT:淫壷 > 0)) / (1+(TALENT:Ｖ鈍感 > 0))
	LOCAL:3 += (ABL:噴乳中毒 + 1) * (ABL:Ｂ感覚 + 1) * 10 * LOCAL * (1 + (TALENT:Ｂ敏感 > 0) + (TALENT:淫乳 > 0)) / (1 + (TALENT:Ｂ鈍感 > 0))
JUEL:快Ｖ = LOCAL:1
JUEL:快Ｂ = LOCAL:3
JUEL:恭順 += (ABL:従順 + 1) * 100 * LOCAL
JUEL:欲情 += (ABL:欲望 + 1) * 25 * LOCAL
JUEL:屈服 += (ABL:従順 + 1) * 250 * LOCAL
JUEL:恥情 += (ABL:露出癖 + 1) * 25 * LOCAL
SQRT (EXP:Ｖ拡張経験+1)
JUEL:苦痛 += (ABL:マゾっ気 + 1) * 300 * LOCAL / RESULT
SQRT (EXP:出産経験+1)
JUEL:恐怖 += 100 * LOCAL / RESULT
;V経験
LOCAL:120 = LOCAL / 10
;絶頂経験
LOCAL:122 = (LOCAL:1 + LOCAL:3) / 1000
;苦痛経験
LOCAL:132 = LOCAL / 50
;噴乳経験
SIF TALENT:母乳体質 == 1
	LOCAL:154 = LOCAL:3 / (6 - ABL:噴乳中毒) / 1000
;V拡張
LOCAL:151 = 1

;出産経験とV拡張経験追加
;初めての出産なら異常経験が入り、体力気力が少し上昇する
IF EXP:出産経験 == 0
