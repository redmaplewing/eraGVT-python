;--------------------------------------------------
;避妊効果の有無を判定する式中関数
;ARG:1 = 相手のＩＤ
@CHECK_HININ_F(ARG, ARG:1)
#FUNCTION
LOCAL = 0
;戦闘中のみの効果
IF FLAG:700 > 0
	;変身中かつソフトボディスーツの場合
	IF CFLAG:ARG:41 == 299 && CFLAG:1 > 0
		LOCAL = 100
	;避妊用ピルの効果
	ELSEIF CFLAG:ARG:241 > 0 && ENEMY_TYPE_CHECK_F("AKUOTI") > 0
		LOCAL = 80
	ELSEIF CFLAG:ARG:241 > 0
		LOCAL = 5
	ENDIF
	;避妊結界
	SIF TALENT:ARG:避妊結界 > 0 && BASE:ARG:性耐性 > 0
		LOCAL = 100
;戦闘中以外
ELSE
	;避妊用ピルの効果
	IF CFLAG:ARG:241 > 0 && ARG:1 < 0
		LOCAL = 80
	ELSEIF CFLAG:ARG:241 > 0
		LOCAL = 5
	ENDIF
	;避妊結界
	SIF TALENT:ARG:避妊結界 > 0 && BASE:ARG:性耐性 > 0 && ARG:1 > 0
		LOCAL = 100
ENDIF
IF RAND:100 < LOCAL
	LOCAL:1 = 1
ELSE
	LOCAL:1 = 0
ENDIF
RETURNF LOCAL:1


