;--------------------------------------------------
;妊娠時のバストの変化
@PREGNANCY_BOOB_EXPAND(ARG)
#FUNCTION
LOCAL = 0
SIF TALENT:ARG:妊娠 == 0
	RETURNF 0
;触手幼体の場合
IF TALENT:ARG:妊娠 == 1
	LOCAL = 20 * CFLAG:ARG:222 / 10
;ヒトの胎児（異常）の場合
