		PRINT 普通
	ENDIF
	PRINTL ] に合わせる
	PRINT [1] 変身後 [
	IF CHARATALENT_F(TARGET,1,"小柄") > 0
		PRINT 小柄
	ELSEIF CHARATALENT_F(TARGET,1,"長身") > 0
		PRINT 長身
	ELSE
		PRINT 普通
	ENDIF
	PRINTL ] のままにする
	PRINTL [2] 小柄　　
	PRINTL [3] 普通　　
	PRINTL [4] 長身　　
	$INPUT_LOOP_4
	INPUT
	IF RESULT == 0
		;体格を通常時に合わせる
		TALENT:変身時体格変動 = 0
	ELSEIF RESULT == 1
		TALENT:変身時体格変動 = TALENT:変身時体格変動
	ELSEIF RESULT == 2
		TALENT:変身時体格変動 = TALENT:小柄 + TALENT:長身 - 1
	ELSEIF RESULT == 3
		TALENT:変身時体格変動 = TALENT:小柄 + TALENT:長身
	ELSEIF RESULT == 4
		TALENT:変身時体格変動 = TALENT:小柄 - TALENT:長身 + 1
	ELSE
		GOTO INPUT_LOOP_4
