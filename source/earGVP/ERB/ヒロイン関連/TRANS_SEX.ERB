	ELSEIF TALENT:変身時外見 == 4
		PRINT スレンダー
	ELSEIF TALENT:変身時外見 == 5
		PRINT 巨尻
	ELSEIF TALENT:変身時外見 == 6
		PRINT 爆尻
	ELSE
		PRINT 普通
	ENDIF
	PRINTL ] に合わせる
