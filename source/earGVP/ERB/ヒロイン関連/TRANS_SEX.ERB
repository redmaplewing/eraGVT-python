;通常の女体化処理
;--------------------------------------------------------------------------------------------------------------------------------------------------------------
@TS_NORMAL, ARG
#DIM KEEP
#DIM TRANS
#DIM BREAST
#DIM BODY
KEEP = TARGET
TARGET = ARG

IF CHARATALENT_F(TARGET,0,"オトコ") == 0
	PRINTFORMW 　! ERROR ! 通常時の性別が女性なのに通常の女体化シーケンスが呼び出されました
	RETURN 0
ENDIF

IF CFLAG:1 > 0
	TRANS = 1
ELSE
	TRANS = 0
ENDIF

;まずは変身を解除する
CALL TRANSFORM, 0

PRINTL 【通常時】　胸サイズ　を選択してください
IF TALENT:変身時ＴＳ > 0
	PRINT [0] 変身後 [
	IF CHARATALENT_F(TARGET,1,"絶壁") > 0
		PRINT 絶壁
		BREAST = -2
	ELSEIF CHARATALENT_F(TARGET,1,"貧乳") > 0
		PRINT 貧乳
		BREAST = -1
	ELSEIF CHARATALENT_F(TARGET,1,"奇乳") > 0
		PRINT 奇乳
		BREAST = 5
	ELSEIF CHARATALENT_F(TARGET,1,"魔乳") > 0
		PRINT 魔乳
		BREAST = 4
	ELSEIF CHARATALENT_F(TARGET,1,"超乳") > 0
		PRINT 超乳
		BREAST = 3
	ELSEIF CHARATALENT_F(TARGET,1,"爆乳") > 0
		PRINT 爆乳
		BREAST = 2
	ELSEIF CHARATALENT_F(TARGET,1,"巨乳") > 0
		PRINT 巨乳
		BREAST = 1
	ELSE
		PRINT 普通
		BREAST = 0
	ENDIF
	PRINTL ] に合わせる
ENDIF
PRINTL [1] 絶壁　　[2] 貧乳　　[3] 普通　　
PRINTL [4] 巨乳　　[5] 爆乳　　[6] 超乳　　[7] 魔乳　　[8] 奇乳　　
$INPUT_LOOP_1
INPUT
IF RESULT == 0 && TALENT:変身時ＴＳ > 0
	;胸サイズを変身後に合わせる
	IF CHARATALENT_F(TARGET,1,"絶壁") > 0
		TALENT:貧乳 = 2
		TALENT:巨乳 = 0
	ELSEIF CHARATALENT_F(TARGET,1,"貧乳") > 0
		TALENT:貧乳 = 1
		TALENT:巨乳 = 0
	ELSEIF CHARATALENT_F(TARGET,1,"奇乳") > 0
		TALENT:貧乳 = 0
		TALENT:巨乳 = 5
	ELSEIF CHARATALENT_F(TARGET,1,"魔乳") > 0
		TALENT:貧乳 = 0
		TALENT:巨乳 = 4
	ELSEIF CHARATALENT_F(TARGET,1,"超乳") > 0
		TALENT:貧乳 = 0
		TALENT:巨乳 = 3
	ELSEIF CHARATALENT_F(TARGET,1,"爆乳") > 0
		TALENT:貧乳 = 0
		TALENT:巨乳 = 2
	ELSEIF CHARATALENT_F(TARGET,1,"巨乳") > 0
		TALENT:貧乳 = 0
		TALENT:巨乳 = 1
	ENDIF
ELSEIF RESULT == 1
	TALENT:貧乳 = 2
	TALENT:巨乳 = 0
ELSEIF RESULT == 2
	TALENT:貧乳 = 1
	TALENT:巨乳 = 0
ELSEIF RESULT == 3
	TALENT:貧乳 = 0
	TALENT:巨乳 = 0
ELSEIF RESULT == 4
	TALENT:貧乳 = 0
	TALENT:巨乳 = 1
ELSEIF RESULT == 5
	TALENT:貧乳 = 0
	TALENT:巨乳 = 2
ELSEIF RESULT == 6
	TALENT:貧乳 = 0
	TALENT:巨乳 = 3
ELSEIF RESULT == 7
	TALENT:貧乳 = 0
	TALENT:巨乳 = 4
ELSEIF RESULT == 8
	TALENT:貧乳 = 0
	TALENT:巨乳 = 5
ELSE
	GOTO INPUT_LOOP_1
ENDIF
;変身時胸サイズ変動の調整
SIF TALENT:変身時ＴＳ > 0
	TALENT:変身時胸サイズ変動 = BREAST - TALENT:巨乳 + TALENT:貧乳
PRINTL 

PRINTL 【通常時】　体格　を選択してください
IF TALENT:変身能力 > 0
	IF CHARATALENT_F(TARGET,1,"小柄") > 0
		BODY = -1
	ELSEIF CHARATALENT_F(TARGET,1,"長身") > 0
		BODY = 1
	ELSE
		BODY = 0
	ENDIF
ENDIF
IF TALENT:変身時ＴＳ > 0
	PRINT [0] 変身後 [
	IF CHARATALENT_F(TARGET,1,"小柄") > 0
		PRINT 小柄
	ELSEIF CHARATALENT_F(TARGET,1,"長身") > 0
		PRINT 長身
	ELSE
		PRINT 普通
	ENDIF
	PRINTL ] に合わせる
ENDIF
PRINT [1] 通常時 [
IF CHARATALENT_F(TARGET,0,"小柄") > 0
	PRINT 小柄
ELSEIF CHARATALENT_F(TARGET,0,"長身") > 0
	PRINT 長身
ELSE
	PRINT 普通
ENDIF
PRINTL ] のままにする
PRINTL [2] 小柄　　
PRINTL [3] 普通　　
PRINTL [4] 長身　　
$INPUT_LOOP_2
INPUT
IF RESULT == 0 && TALENT:変身時ＴＳ > 0
	;体格を変身後に合わせる
	IF CHARATALENT_F(TARGET,1,"小柄") > 0
		TALENT:小柄 = 1
		TALENT:長身 = 0
	ELSEIF CHARATALENT_F(TARGET,1,"長身") > 0
		TALENT:小柄 = 0
		TALENT:長身 = 1
	ENDIF
ELSEIF RESULT == 1
	;特になにも処理しない
ELSEIF RESULT == 2
	TALENT:小柄 = 1
	TALENT:長身 = 0
ELSEIF RESULT == 3
	TALENT:小柄 = 0
	TALENT:長身 = 0
ELSEIF RESULT == 4
	TALENT:小柄 = 0
	TALENT:長身 = 1
ELSE
	GOTO INPUT_LOOP_2
ENDIF
;変身時胸サイズ変動の調整
SIF TALENT:変身能力 > 0
	TALENT:変身時体格変動 = BODY - TALENT:長身 + TALENT:小柄
PRINTL 

IF TALENT:変身能力 > 0 && TALENT:変身時ＴＳ == 0
	PRINTL 【変身後】　胸サイズ　を選択してください
	PRINT [0] 通常時 [
	IF CHARATALENT_F(TARGET,0,"絶壁") > 0
		PRINT 絶壁
	ELSEIF CHARATALENT_F(TARGET,0,"貧乳") > 0
		PRINT 貧乳
	ELSEIF CHARATALENT_F(TARGET,0,"奇乳") > 0
		PRINT 奇乳
	ELSEIF CHARATALENT_F(TARGET,0,"魔乳") > 0
		PRINT 魔乳
	ELSEIF CHARATALENT_F(TARGET,0,"超乳") > 0
		PRINT 超乳
	ELSEIF CHARATALENT_F(TARGET,0,"爆乳") > 0
		PRINT 爆乳
	ELSEIF CHARATALENT_F(TARGET,0,"巨乳") > 0
		PRINT 巨乳
	ELSE
		PRINT 普通
	ENDIF
	PRINTL ] に合わせる
	PRINTL [1] 絶壁　　[2] 貧乳　　[3] 普通　　
	PRINTL [4] 巨乳　　[5] 爆乳　　[6] 超乳　　[7] 魔乳　　[8] 奇乳　　
	$INPUT_LOOP_3
	INPUT
	IF RESULT == 0
		;胸サイズを通常時に合わせる
		TALENT:変身時胸サイズ変動 = 0
	ELSEIF RESULT == 1
		TALENT:変身時胸サイズ変動 = TALENT:貧乳 + TALENT:巨乳 - 2
	ELSEIF RESULT == 2
		TALENT:変身時胸サイズ変動 = TALENT:貧乳 + TALENT:巨乳 - 1
	ELSEIF RESULT == 3
		TALENT:変身時胸サイズ変動 = TALENT:貧乳 - TALENT:巨乳
	ELSEIF RESULT == 4
		TALENT:変身時胸サイズ変動 = TALENT:貧乳 - TALENT:巨乳 + 1
	ELSEIF RESULT == 5
		TALENT:変身時胸サイズ変動 = TALENT:貧乳 - TALENT:巨乳 + 2
	ELSEIF RESULT == 6
		TALENT:変身時胸サイズ変動 = TALENT:貧乳 - TALENT:巨乳 + 3
	ELSEIF RESULT == 7
		TALENT:変身時胸サイズ変動 = TALENT:貧乳 - TALENT:巨乳 + 4
	ELSEIF RESULT == 8
		TALENT:変身時胸サイズ変動 = TALENT:貧乳 - TALENT:巨乳 + 5
	ELSE
		GOTO INPUT_LOOP_3
	ENDIF
	PRINTL 

	PRINTL 【変身後】　体格　を選択してください
	PRINT [0] 通常時 [
	IF CHARATALENT_F(TARGET,0,"小柄") > 0
		PRINT 小柄
	ELSEIF CHARATALENT_F(TARGET,0,"長身") > 0
		PRINT 長身
