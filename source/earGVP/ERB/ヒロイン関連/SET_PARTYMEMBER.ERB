@SET_PARTYMEMBER
#DIM CCOUNT
;パーティキャラ自動管理
SIF CHARANUM < 3 && CHARANUM_SAFE_PARTYCHECK(0) == 0
	FLAG:63 = 0
FOR CCOUNT, 0, CHARANUM
	SIF CCOUNT == MASTER
		CONTINUE

	IF GAME_OPTION_CHECK_F(OPTION_solo)	|| CHECK_GAMEOVER_F() == 1
		;ソロモードなら妊娠中でも戦う。ボテ腹魔法少女ｃ！　ゲームオーバーモードではわざわざ表示しない
	ELSEIF CHECK_PREGNANT_F(CCOUNT) > 0 && CFLAG:CCOUNT:100 == 予定_出撃 && CFLAG:CCOUNT:0 < 1
		PRINTFORML %CALLNAME:CCOUNT%は妊娠しているため出撃できなくなりました
		PRINTW 
		CFLAG:CCOUNT:100 = 予定_休憩
	ELSEIF CHECK_PREGNANT_F(CCOUNT) > 0 && CFLAG:CCOUNT:100 == 予定_防衛
		PRINTFORML %CALLNAME:CCOUNT%は妊娠しているため防衛できなくなりました
		PRINTW 
		CFLAG:CCOUNT:100 = 予定_休憩
	ENDIF
	;離脱したキャラを最後尾に移動
	IF (CFLAG:CCOUNT:0 != 状態_無事) && CCOUNT < CHARANUM -1 && CFLAG:CCOUNT:999
		CFLAG:CCOUNT:999 = 0
		CALL SHIFTBACK_CHARA,CCOUNT
	ELSEIF CFLAG:CCOUNT:0 != 状態_無事 && CFLAG:CCOUNT:999
		CFLAG:CCOUNT:999 = 0
	ENDIF
NEXT

;--------------------------------------------------
;ARG番目のキャラをリストの最後尾に移動する
@SHIFTBACK_CHARA,ARG
VARSET LOCAL
FOR LOCAL, ARG, CHARANUM -1
	SIF LOCAL == MASTER
		CONTINUE
	;RELATION
	FOR LOCAL:1, 0, CHARANUM
		SIF LOCAL:1 == MASTER
			CONTINUE
		SWAP RELATION:(LOCAL:1):LOCAL, RELATION:(LOCAL:1):(LOCAL + 1)
	NEXT
	SWAPCHARA LOCAL,LOCAL + 1
NEXT

;--------------------------------------------------
;ARG番目のキャラをパーティの最前部に移動する
@SHIFTFOWARD_CHARA,ARG
VARSET LOCAL
FOR LOCAL, 0, CHARANUM
	SIF CFLAG:LOCAL:999
		LOCAL:1 = LOCAL
NEXT
FOR LOCAL, ARG, LOCAL:1, -1
	SIF LOCAL == MASTER
		CONTINUE
	;RELATION
	FOR LOCAL:1, 0, CHARANUM
		SIF LOCAL:1 == MASTER
			CONTINUE
		SWAP RELATION:(LOCAL:1):LOCAL, RELATION:(LOCAL:1):(LOCAL - 1)
	NEXT
	SWAPCHARA LOCAL,LOCAL - 1
NEXT

