IF 	EXP:ARG:魅了経験 > GLOBAL:110
	GLOBAL:110 = EXP:ARG:魅了経験
	GLOBALS:14 = %NAME:ARG,40,LEFT%（Lv{ABL:ARG:レベル}）　{GLOBAL:110}
ENDIF

;Shame
IF 	EXP:ARG:Ｖ経験 > GLOBAL:120
	GLOBAL:120 = EXP:ARG:Ｖ経験
	GLOBALS:20 = %NAME:ARG,40,LEFT%（Lv{ABL:ARG:レベル}）　{GLOBAL:120}回
