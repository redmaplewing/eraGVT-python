ENDIF
IF 	EXP:ARG:射精経験 > GLOBAL:128
	GLOBAL:128 = EXP:ARG:射精経験
	GLOBALS:28 = %NAME:ARG,40,LEFT%（Lv{ABL:ARG:レベル}）　{GLOBAL:128}回
