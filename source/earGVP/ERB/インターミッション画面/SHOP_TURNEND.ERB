	GLOBAL:105 = MAXBASE:ARG:性耐性
	GLOBALS:2 = %NAME:ARG,40,LEFT%（Lv{ABL:ARG:レベル}）　{GLOBAL:105}
ENDIF
IF MAXBASE:ARG:攻撃 > GLOBAL:106
	GLOBAL:106 = MAXBASE:ARG:攻撃
	GLOBALS:10 = %NAME:ARG,40,LEFT%（Lv{ABL:ARG:レベル}）　{GLOBAL:106}
ENDIF
IF MAXBASE:ARG:防御 > GLOBAL:107
	GLOBAL:107 = MAXBASE:ARG:防御
