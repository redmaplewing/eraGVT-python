;**********************************************************
;ターン行動と襲撃後処理、新しいターンに移る前に起きるイベント各種
@EVENTTURNEND
#LATER
#DIM CCOUNT
REDRAW 0
;クズ市民関係のフラグをリセット
FLAG:70 = 0
FLAG:71 = 0
FLAG:72 = 0

;PALAM最大値をリセット
VARSET MAX_PALAM

;襲撃/救援イベント後ではなく、行動していないキャラがいる場合、ACTIONに飛ばして再度ループ
SIF FLAG:799 < CHARANUM && FLAG:45 == 0
	JUMP ACTION_MAIN

;パーティメンバー管理
CALL SET_PARTYMEMBER

;前ターンで行動開始前に選択していたキャラにターゲットをあわせる
;ターン中で使用不可になった場合は使用可能なキャラのうち一番若いキャラにあわせる
;memo:この処理の意義は？
;memo:少し下の救出されたキャラの処理でTARGET代入しているので、意味があるとしたら直後のエンディングのみ
;memo:ならエンディング処理で選び直せばよくね？
IF CFLAG:(FLAG:798):0 != 状態_無事
	FOR CCOUNT, 0, CHARANUM
		SIF CCOUNT == MASTER
			CONTINUE
		
		IF CFLAG:CCOUNT:0 == 状態_無事
			TARGET = CCOUNT
			BREAK
		ENDIF
	NEXT
ELSE
	TARGET = FLAG:798
ENDIF

;エンディング判定
CALL ENDING
;強制的にタイトルに戻る場合
IF FLAG:999 == -999
	CLEARLINE LINECOUNT
	RESETDATA
	BEGIN TITLE
ELSEIF FLAG:64 != 0
	;ターン終了処理を終了
	FLAG:48 = 0
	JUMP SHOW_SHOP
ENDIF

;戦闘直後のキャラ再計算処理
CALL RECALC_PARTYMEMBER

;襲撃イベント後のスキップ
;ターン終了後イベント処理で襲撃発生して戦闘が終わるとここに戻ってくるので、イベント処理を飛ばす
IF FLAG:45 > 0
	;襲撃フラグを折る
	FLAG:45 = 0

	BEGIN SHOP
ENDIF

;ゲームクリアモード・引き継ぎスタートでなければ、行動中キャラを0番目にする
;memo:この処理いる？→夜這いイベントでFLAG:799を使い回してやがった。クソが
;memo:それを除去したならもっと下、BEGIN SHOPの直前へ持っていく
SIF FLAG:64 == 0
	FLAG:799 = 0


PRINTL 

;ボス出現停止フラグを折る
FLAG:49 = 0

;ボス触手のダメージ蓄積値が回復
CALL BOSS_TENTACLE_RECOVER

;口上のターン終了時処理を呼び出し
FOR CCOUNT, 0, CHARANUM
	SIF CCOUNT == MASTER
		CONTINUE

	TARGET = CCOUNT
	CALL MESSAGE_TURNEND
NEXT

;クズ市民による脅迫あるいは誘拐監禁
FOR CCOUNT, 1, CHARANUM
	;脅迫イベント（コンフィグで「クズ市民による幽閉を許可する」がONかつ、キャラが無事かつ、レイプされた（クズ市民orナンパ）ことがある）
	IF CONFIG_CHECK_PRISON_F(10) == 1 && (CFLAG:CCOUNT:0 == 状態_無事 || CFLAG:CCOUNT:0 == 5) && (CFLAG:CCOUNT:286 + CFLAG:CCOUNT:320 + CFLAG:CCOUNT:321) > 0
		TARGET = CCOUNT
		CALL INTIMIDATION_EVENT
	;監禁イベント(コンフィグに関わらずキャラメイクで付与されている可能性がある)
	ELSEIF CFLAG:CCOUNT:0 == 状態_クズ監禁
		TARGET = CCOUNT
		CALL KIDNAPPING
	ENDIF
NEXT


;触手幽閉
CALL PRISON
;判定出産
CALL BIRTH_HANTEI
;判定育児終了
CALL GROW_HANTEI

;悪堕ちキャラが暴れるイベント
CALL AKUOTI_ATTACK
;イチャックス
CALL LOVESEX_NIGHT
;夜間自慰
CALL SELF_NIGHT
;夜這い（コンフィグで「仲間による夜這い」がONなら）
SIF CONFIG_CHECK_EVENT_F(2) > 0
	CALL YOBAI

;防衛力の自動変動
CALL DAILY_DEFENCE_CHANGE
;人気度の自動変動
CALL DAILY_POPULARITY_CHANGE

;コンフィグで「一部ウェイトの削減」がOFFならWAIT入れる
SIF CONFIG_CHECK_SCREEN_F(3) == 0
	WAIT

;ボス触手襲来判定（コンフィグで「ボス触手の襲撃」がONなら）
SIF CONFIG_CHECK_EVENT_F(0) > 0
	CALL RAID_HANTEI

;イベント戦闘が発生していなければ新しいターンを開始する
SIF FLAG:45 == 0
	BEGIN SHOP


;**********************************************************
;新しいターンの開始時に起こる処理
@EVENTSHOP
#DIM CCOUNT

REDRAW 0

;ゲーム開始直後の処理だった場合
IF DAY == 0
	DAY = 1
	TIME = 0
	FLAG:64 = 0
	FLAG:799 = 0
	TARGET = 1
	CALL LB
	;PRINTL ゲームを開始します
	;PRINTW 
	JUMP SHOW_SHOP
ENDIF

;memo:これらはターン終了時のイベントでは駄目な理由はなにかある？
;寄生関係
CALL PARASITE
;子触手襲来（コンフィグで「子触手の夜這い」がONなら）
SIF CONFIG_CHECK_EVENT_F(1) > 0
	CALL SMALL_TENTACLE_HANTEI
;子触手の増殖判定
CALL BIRTH_AUTO_RANDOM

;同時出撃人数と戦闘支援人数をリセット
FLAG:41 = 0
FLAG:43 = 0

;昼夜の切り替え
INVERTBIT TIME, 0

;時間経過で自動的に体力,気力,性耐性,結界,淫紋が回復する
CALL RECOVERY_OVER_TIME

;日数
DRAWLINE
IF TIME == 0
	DAY += 1
	IF DAY > 1
		PRINTL 一日が終了しました
		SAVESTR'=""
		;ゲームオーバーでなければ支援金・支出の判定
		IF CHECK_GAMEOVER_F() == 0
			CALL CALC_INCOME_EXPEND
		ENDIF
	ENDIF
ELSE
	PRINTL 夜になりました
	WAIT
ENDIF

;ニュースを初期化
SAVESTR:20'=""
;特定状況下ではニュースを固定
;ゲームオーバーモード
IF CHECK_GAMEOVER_F() == 1
	FLAG:60 = 10001
;ラスボス出現中
ELSEIF FLAG:101 > 0
	FLAG:60 = 10000
ENDIF

;全キャラの結界状態をチェック
;memo:各結界耐久値にLIMITしているだけの本質的に不要な処理（値更新する時に都度すればいいだけ）
;memo:いつか関数ごと削除する
CALL CHECK_SHIELD_ALL

;前ターンで行動開始前に選択していたキャラにターゲットをあわせる
TARGET = FLAG:798

;**********************************************************
;以下、各イベント関数から呼び出される関数
;**********************************************************

;--------------------------------------------------
;戦闘直後のキャラクターデータ再計算処理
@RECALC_PARTYMEMBER
#DIM CCOUNT

LOCAL = TARGET
FOR CCOUNT, 0, CHARANUM
	SIF CCOUNT == MASTER
		CONTINUE
	SIF CCOUNT >= CHARANUM
		BREAK

	;ステータスの再計算
	CALL LEVELSTATUS,CCOUNT

	IF CFLAG:CCOUNT:0 == 状態_救出直後
		TARGET = CCOUNT
		IF CFLAG:TARGET:6 == -1
			PRINTL 
			CALL RESCUE_CHILD,TARGET
			SIF RESULT < 0
				CCOUNT -= RESULT
		ELSE
			CALL AFTER_RESCUED,TARGET
		ENDIF
		PRINTW 
	ELSE
		CALL INMON_RECOVERY,CCOUNT
	ENDIF
	;娘を施設に預けた場合の処理
	SIF CCOUNT > CHARANUM - 1
		BREAK

	;歴代最高記録の更新判定（長いので別関数へ）
	CALL UPDATE_STATUS_RECORD, CCOUNT

	;実績獲得判定
	CALL GET_STATE_TROPHY,CCOUNT
NEXT
TARGET = LOCAL

;--------------------------------------------------
;歴代最高記録の更新判定
; 引数
;	ARG	対象のキャラ番号
