IF 	EXP:ARG:Ａ経験 > GLOBAL:121
	GLOBAL:121 = EXP:ARG:Ａ経験
	GLOBALS:21 = %NAME:ARG,40,LEFT%（Lv{ABL:ARG:レベル}）　{GLOBAL:121}回
ENDIF
IF 	EXP:ARG:自慰経験 > GLOBAL:122
	GLOBAL:122 = EXP:ARG:自慰経験
	GLOBALS:22 = %NAME:ARG,40,LEFT%（Lv{ABL:ARG:レベル}）　{GLOBAL:122}回
ENDIF
IF 	EXP:ARG:フェラ経験 > GLOBAL:123
	GLOBAL:123 = EXP:ARG:フェラ経験
	GLOBALS:23 = %NAME:ARG,40,LEFT%（Lv{ABL:ARG:レベル}）　{GLOBAL:123}回
ENDIF
IF 	EXP:ARG:精液経験 > GLOBAL:124
	GLOBAL:124 = EXP:ARG:精液経験
	GLOBALS:24 = %NAME:ARG,40,LEFT%（Lv{ABL:ARG:レベル}）　{GLOBAL:124}回
ENDIF
IF 	EXP:ARG:絶頂経験 > GLOBAL:125
	GLOBAL:125 = EXP:ARG:絶頂経験
	GLOBALS:25 = %NAME:ARG,40,LEFT%（Lv{ABL:ARG:レベル}）　{GLOBAL:125}回
