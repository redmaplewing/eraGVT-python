;--------------------------------------------------
;最後にTARGETしたキャラの詳細情報表示
;
@SHOP_SHOW_STATUS_TARGET
SIF CFLAG:0 != 状態_無事 || (CFLAG:999 == 0 && FLAG:61 == 0)
	RETURN 0
;
PRINTFORM ◆%NAME:TARGET%(%ISFEMALE(TARGET)?"♀"#"♂"%)

IF CSTR:0 != "" && CSTR:0 != NAME:TARGET
	PRINTFORM 《%CSTR:0%》
ENDIF

PRINTFORM  Lv.{ABL:レベル}
CALL SHOW_SHOP_STATUS_SIGN, TARGET
PRINTL 
CALLFORM COLORSENTENCE_BAR(BASENAME:0, 6, BASE:体力, MAXBASE:体力, 20)
PRINTL 
CALLFORM COLORSENTENCE_BAR(BASENAME:1, 6, BASE:気力, MAXBASE:気力, 20)
PRINTL 
CALLFORM COLORSENTENCE_BAR(BASENAME:2, 6, BASE:性耐性, MAXBASE:性耐性, 20)
