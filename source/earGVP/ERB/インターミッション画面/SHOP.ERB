;**********************************************************
;インターミッション画面(SHOP)の表示処理
;データロード後、または新たなターンの開始とオートセーブ処理後に遷移してくる
;**********************************************************
@SHOW_SHOP
#DIM CCOUNT

;選択中のキャラが編成外なら自動target変更
IF TARGET>CHARANUM || (FLAG:63 == 0 && (CFLAG:TARGET:999 == 0 || !GROUPMATCH(CFLAG:TARGET:0, 状態_無事, 状態_出産直前, 状態_育児中)))
	FOR LOCAL,1,CHARANUM
		IF (CFLAG:(LOCAL):999 == 1 && GROUPMATCH(CFLAG:local:0, 状態_無事, 状態_出産直前, 状態_育児中))
			TARGET = LOCAL
			BREAK
		ENDIF
	NEXT
ENDIF

;途中ロード用
;memo:このリセット要る？
FLAG:799 = 0

;画面を改行送りして画面表示処理を開始
CALL LB

;昼夜で背景色を変える
IF FLAG:999
	SETBGCOLOR 0,0,40
ELSE
	IF TIME == 0
		LOCALS = 昼
		SETBGCOLOR 背景色昼
	ELSEIF TIME == 1
		LOCALS = 夜
		SETBGCOLOR 背景色夜
	ENDIF
ENDIF

;フラッシュニュース更新
DRAWLINE
CALL FLASHNEWS

;触手の探索/発見/交戦状況、悪堕ちキャラの表示
DRAWLINE
CALL SHOP_SHOW_BOSS_INFO

;最後に選択していたキャラの詳細ステータス
DRAWLINE
CALL SHOP_SHOW_STATUS_TARGET

;パーティーキャラのステータス一覧（ソロモード以外かつ仲間が2人以上の場合）
IF (!GAME_OPTION_CHECK_F(OPTION_solo) && CHARANUM_PLAYABLE()>=2)
	PRINTL
	PRINTFORML パーティ人数( {CHARANUM_PARTYCHECK(1)} / {パーティ人数最大値} )
	CALL SHOP_SHOW_STATUS_PARTY_LIST, FALSE
	;キャラ全表示中で控えメンバーがいるなら控えメンバーリストも表示
	SIF FLAG:61 && CHARANUM_RESERVE()
		CALL SHOP_SHOW_STATUS_RESERVE_LIST, FALSE
ENDIF

;一括設定（仲間が2人以上の場合・選択中なら強調表示する）
IF CHARANUM_SAFE() >= 2
	IF FLAG:9 == 1
		FONTBOLD
		SETCOLOR 255, 150, 0
	ELSE
		SETCOLOR 120, 60, 0
	ENDIF
	PRINTFORM [90]一括設定
	RESETCOLOR
	FONTREGULAR
ELSE
	PRINT 　　　　　　
ENDIF


PRINTPLAIN                          

;パーティ編成ボタン（仲間が2人以上、無事なキャラが1人以上いる場合）
;memo:やっぱりCHARANUM > 2で「仲間が2人以上」は無理があるって。このバリアントに「あなた」は要らないだろ
IF CHARANUM > 2 && CHARANUM_SAFE()>0
	PRINT 　　　　　　　　　　　
	PRINT [50] パーティ編成　
	PRINTPLAIN  
	FONTREGULAR
ELSE
	PRINTPLAIN                
ENDIF
;キャラ全表示中で、パーティキャラがいるなら操作キャラのみ表示ボタンを表示
IF CHARANUM_SAFE_PARTYCHECK(0) && FLAG:61
	PRINT     [60] ▲操作キャラのみ
;キャラ全表示中ではなく、控えメンバーがいるなら、全表示ボタンを表示
ELSEIF CHARANUM_RESERVE()
	PRINT         [60] ▼全表示
ENDIF

PRINTL 

;実施不可行動のインフォメーション表示
CALL SHOP_NG_ACTION_INFO

SIF GAME_OPTION_CHECK_F(OPTION_solo) == 0
	DRAWLINE

;一括選択中なら、一口メッセージ口上のために無事なキャラの中からランダムに1人選択
IF FLAG:9 && CHARANUM_SAFE_PARTYCHECK() > 0
	$HITOKUCHI_LOOP
	TARGET = RAND:(CHARANUM-1) + 1
	SIF CFLAG:TARGET:999 == 0 || !GROUPMATCH(CFLAG:TARGET:0, 状態_無事, 状態_出産直前, 状態_育児中)
		GOTO HITOKUCHI_LOOP
ENDIF
;選択したキャラが無事なら無事なキャラの一口メッセージ口上を呼び出す
IF CFLAG:TARGET:0 == 状態_無事 && TARGET != MASTER
	CALL MESSAGE_HITOKUTI_SHOP
	;口上の発言行数を差し引いて空行表示（合計4行）
	REPEAT LIMIT(4 - RESULT, 0, 4)
		PRINTL
	REND
ELSE
	PRINTL
	PRINTL
	PRINTL
	PRINTL
ENDIF

;日数・残り期限・資金・防衛力・人気度の表示
CALL SHOP_INTERMISSON_HEADER

;下部メニュー項目の表示
CALL CPRINTL, "[100]★行動開始★", 文字色時間帯:TIME
PRINTL 
RESETCOLOR
;行動選択（ゲームオーバーでない場合）
IF CHECK_GAMEOVER_F() == 0
	CALL CPRINT, "[101]出撃する　　　 ", 文字色薄赤
	CALL CPRINT, "[102]鍛錬する　　　 ", 文字色薄黄
	CALL CPRINT, "[103]休憩する　　　 ", 文字色薄青
	CALL CPRINT, "[104]特別活動　　　 ", 文字色薄水
	PRINTL 
	IF !GAME_OPTION_CHECK_F(OPTION_solo)
		CALL CPRINT, "[105]拠点防衛　　　 ", 文字色薄桃
	ELSE
		CALL CPRINTPLAIN, "[105]拠点防衛　　　 ", 文字色無効
	ENDIF
	IF CHARANUM >= 3
		CALL CPRINT, "[106]戦闘支援　　　 ", 文字色薄緑
	ELSE
		CALL CPRINTPLAIN, "[106]戦闘支援　　　 ", 文字色無効
	ENDIF
	CALL CPRINT, "[107]情報収集　　　 ", 文字色黄色
	CALL CPRINT, "[108]自由行動", 文字色水色
	PRINTL 
ENDIF
PRINTL 
PRINT [110]ステータス表示 
IF CHECK_GAMEOVER_F() == 0
	PRINT [111]キャラの強化   
	PRINT [112]衣装の設定　　 
	PRINTL [113]メディカルルーム
	PRINT [120]衣装の購入　　 
ENDIF
PRINT [130]状況の確認　　 

IF CHECK_GAMEOVER_F() == 0
	PRINT [150]施設の拡張　　 
	;選択キャラが無事でなければスケジュール設定は選択不可
	IF CFLAG:TARGET:0 != 状態_無事 || TARGET == MASTER || FLAG:9 != 0
		CALL CPRINTPLAIN, "[160]スケジュール設定", 文字色無効
	ELSE
		PRINT [160]スケジュール設定
	ENDIF
ENDIF
PRINTL 

;INSTANTモードなら引退&新人加入を可能に
IF GAME_OPTION_CHECK_F(OPTION_加入引退有り)
	PRINT 　　　　　　　　　　[169]引退者名簿
	PRINT 　　　[170]引退させる　　 
	PRINTL [180]新人を入れる　 
ENDIF


PRINT [200]セーブ　　　　 
PRINT [300]ロード　　　　 
PRINT [700]コンフィグ　　 
PRINT [800]トロフィー確認 


;**********************************************************
;メインメニューで選んだコマンドの処理(USERSHOP)
; 変数
;	CCOUNT			ループカウンタ
@USERSHOP
#DIM CCOUNT

SELECTCASE RESULT

	;操作キャラの選択
	CASE 1 TO CHARANUM -1
		IF CHARANUM > RESULT && CFLAG:RESULT:999 != 0 && CFLAG:RESULT:0 == 状態_無事
			FLAG:9 = 0
			TARGET = RESULT
			PRINTL 
			PRINTFORML 操作キャラを%CALLNAME%に変更しました
			PRINTL 
		ENDIF

	;編成モードへの移行
	CASE 50
		IF CHARANUM > 2 && CHARANUM_SAFE()>0
			PRINTL 編成モードに移行します
			TARGET = 0
			CALL SHOP_ORGANIZE_PARTY
		ENDIF

	;控え表示切り替え
	CASE 60
		IF CHARANUM_SAFE_PARTYCHECK(0)
			IF FLAG:61
				PRINTL キャラを全員表示します
				FLAG:61 = 0
			ELSE
				PRINTL パーティのみ表示します
				FLAG:61 = 1
			ENDIF
		ENDIF

	;一括設定
	CASE 90
		IF CHARANUM_SAFE() >= 2
			SIF TARGET == MASTER
				TARGET = RAND:(CHARANUM-1) + 1
			IF FLAG:9 == 0
				PRINTL 一括設定モードに変更しました
				FLAG:9 = 1
			ENDIF
		ENDIF

	;行動開始
	CASE 100
		CALL USERSHOP_ACTION_CONFIRM

	;行動選択コマンド
	CASE 予定_出撃, 予定_鍛錬, 予定_休憩, 予定_活動, 予定_防衛, 予定_支援, 予定_情報, 予定_自由
		CALL USERSHOP_SET_ACTION, RESULT, FLAG:9

	;ステータス表示
	CASE 110
		TARGET = LIMIT(TARGET, 1, CHARANUM-1)
		CALL SHOW_STATUS_CHARA_SELECT, TARGET

	;キャラの強化
	CASE 111
		SIF CHECK_GAMEOVER_F() == 0 && CHARANUM_ACTIVE()
			CALL CHARA_POWERUP, TARGET

	;衣装の設定
	CASE 112
		SIF CHECK_GAMEOVER_F() == 0 && CHARANUM_ACTIVE()
			CALL CLOTH_WEAR

	;メディカルルーム
	CASE 113
		SIF CHECK_GAMEOVER_F() == 0 && FLAG:63 == 0
			CALL DRUG_PREPARATION

	;衣服の購入
	CASE 120
		SIF CHECK_GAMEOVER_F() == 0 && FLAG:63 == 0
			CALL SHOW_SHOP_CLOTH

	;状況の確認
	CASE 130
		CALL SHOP_SHOW_SITUATION_LIST

	;施設の拡張
	CASE 150
		SIF  CHECK_GAMEOVER_F() == 0
			CALL HOME_ENHANCING

	;スケジュール設定
	CASE 160
		IF CFLAG:0 != 状態_無事 || TARGET == MASTER || FLAG:9
			PRINTW スケジュールを設定するキャラクターが選択されていません
		ELSE
			CALL SCHEDULE
		ENDIF

	;ここからINSTANTモード向けの引退&新人加入処理呼び出し
	CASE 169 && GAME_OPTION_CHECK_F(OPTION_加入引退有り)
		CALL CHAR_INTAI_LIST
	CASE 170 && CHARANUM > 1 && GAME_OPTION_CHECK_F(OPTION_加入引退有り)
		CALL CHARA_INTAI
	CASE 180 && CHARANUM <= 登録最大人数 - 1 && GAME_OPTION_CHECK_F(OPTION_加入引退有り)
		CALL TSUIKAYOUSEI_NORMAL
	;ここまでINSTANTモード向けの引退&新人加入処理呼び出し

	;セーブ・ロード・コンフィグ・実績
	CASE 200
		SAVEGAME
	CASE 300
		LOADGAME
	CASE 700
		CALL CONFIG
	CASE 800
		CALL SHOW_TROPHY

ENDSELECT
