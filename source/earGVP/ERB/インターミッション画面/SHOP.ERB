CALL SHORTLINE

;--------------------------------------------------
;ショップ画面の実施不可行動のインフォメーション表示
; 変数
;	ACTION_NAME		行動の名称（CFLAG.ERHで定義）
;	CCOUNT			ループカウンタ
@SHOP_NG_ACTION_INFO
#DIMS ACTION_NAME
#DIM CCOUNT

;行動に必要な体力などのチェック
FOR CCOUNT, 0, CHARANUM
	SIF CCOUNT == MASTER
		CONTINUE
	IF CFLAG:CCOUNT:0 == 状態_無事 && IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT)

		;行動の名称を取得
		;Emueraには辞書型がないためこうせざるを得ない
		ACTION_NAME = %キャラ行動予定名称:(FINDELEMENT(キャラ行動予定, CFLAG:CCOUNT:100))%
		
		SETCOLORBYNAME RED
		PRINTFORM *%CALLNAME:CCOUNT%は

		SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_廃人)
			PRINTFORML 廃人化しているため、休憩以外の行動ができません

		SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_欠損)
			PRINTFORML 四肢欠損しているため、%ACTION_NAME%ができません

		SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_妊娠)
			PRINTFORML 妊娠中なので、%ACTION_NAME%ができません

		SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_夜魔)
			PRINTFORML 「夜魔の貴族」なため、昼間は%ACTION_NAME%ができません

		SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_戦士)
			PRINTFORML 「生粋の戦士」なため、%ACTION_NAME%ができません

		SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_体力)
			PRINTFORML %ACTION_NAME%に必要な体力がありません
	ENDIF
NEXT

;--------------------------------------------------
;日数・残り期限・資金・防衛力・人気度の表示
; 変数
;	TIMELEFT	次の触手の殲滅猶予日数
; 定数
;	DAYOFWEEK	曜日
;memo:他の場所でも使うならERHに置くべきか
@SHOP_INTERMISSON_HEADER
#DIM TIMELEFT
#DIMS CONST DAYOFWEEK = "日","月","火","水","木","金","土"

SETCOLOR 文字色時間帯:TIME
DRAWLINE
PRINTFORM インターミッション
FONTBOLD
PRINTFORM  \@TIME == 0?[☀昼]#[🌙夜]\@  {DAY} 日目(%DAYOFWEEK:(DAY % 7)%)
FONTREGULAR
RESETCOLOR

;ボスの殲滅猶予日数の表示
;ゲームオーバーモードなら何も表示しない
IF CHECK_GAMEOVER_F() == 1
	PRINTL 
;日数制限解除の効果(周回引き継ぎorフリープレイモード)
ELSEIF GAME_OPTION_CHECK_F(OPTION_制限時間無し)
	PRINTFORML （完全殲滅まで∞日）
;それ以外で通常ボスの出現中
ELSEIF ENEMY_TYPE_CHECK_F("BOSS") == 1
	;
	CALL TENTACLE_SURVIVE, "NUM"
	TIMELEFT = (FLAG:3 - RESULT + 1) * FLAG:2 - DAY + DAY:1
	SELECTCASE TIMELEFT
		CASE IS <= 3 
			SETCOLORBYNAME Red
		CASE IS <=5 
			SETCOLORBYNAME Orange
		CASE IS <=7 
			SETCOLORBYNAME Yellow
	ENDSELECT
	PRINTFORM （{FLAG:3 - RESULT + 1}体目殲滅猶予
	FONTBOLD
	PRINTFORM  {TIMELEFT} 
	FONTREGULAR
	IF GAME_OPTION_CHECK_F(OPTION_endless)
		PRINTFORML 日/完全殲滅まで∞日）
	ELSE
		PRINTFORML 日/完全殲滅まで{FLAG:1 - DAY + DAY:1}日）
	ENDIF
;ラスボス出現後
ELSEIF GET_LASTBOSS_PHASE_F() >= 1
	IF GAME_OPTION_CHECK_F(OPTION_endless)
		PRINTFORML （完全殲滅まで∞日）
	ELSE
		PRINTFORML （完全殲滅まで{FLAG:1 - DAY + DAY:1}日）
	ENDIF
ENDIF
FONTREGULAR

;資金
PRINTFORM 資金：{MONEY}＄　
;防衛力
SELECTCASE FLAG:852
	CASE 0
		SETCOLOR 120,0,0
	CASE IS < 1250
		SETCOLOR 250,0,0
	CASE IS < 2500
		SETCOLOR 250,250,100
	CASE IS < 10000
		SETCOLOR 0,250,60
	CASE IS < 20000
		SETCOLOR 0,200,255
	CASEELSE
		SETCOLOR 200,0,255
ENDSELECT
PRINTFORM 防衛力：{FLAG:852}　　
;人気度
SELECTCASE FLAG:853
	CASE IS <= -75
		SETCOLOR 180,0,0
	CASE IS <= -50
		SETCOLOR 250,50,50
	CASE IS < 0
		SETCOLOR 250,200,200
	CASE IS < 50
		SETCOLOR 200,250,200
	CASE IS < 75
		SETCOLOR 100,250,150
	CASEELSE
		SETCOLOR 100,250,200
ENDSELECT
PRINTFORM 人気度：{FLAG:853}
RESETCOLOR
PRINTL 

SETCOLOR 文字色時間帯:TIME
PRINTL 
DRAWLINE
FONTREGULAR
RESETCOLOR

;--------------------------------------------------
;出撃または防衛予定の人数チェック
; 変数
;	CCOUNT			ループカウンタ
@NUMBER_ON_FRONTLINE
#FUNCTION
#DIM CCOUNT
LOCAL = 0
FOR CCOUNT, 0, CHARANUM
	SIF CCOUNT == MASTER
		CONTINUE
	SIF (CFLAG:CCOUNT:100 == 予定_出撃 || CFLAG:CCOUNT:100 == 予定_防衛 )&& !IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT)
		LOCAL += 1
NEXT
RETURNF LOCAL

;--------------------------------------------------
;行動開始の確認
@USERSHOP_ACTION_CONFIRM
IF FLAG:40 == 0 && CHECK_GAMEOVER_F() == 0
	DRAWLINE
	PRINTL 
	PRINTL 各キャラの行動予定は下のようです
	PRINTL 
	CALL USERSHOP_ACTION_PLANDISP
	PRINTL 
	PRINTL この設定で行動を開始しますか？
	PRINTL ※ 行動を設定していないキャラは自動的に休憩になります
	IF NUMBER_ON_FRONTLINE() == 0 && !GAME_OPTION_CHECK_F(OPTION_solo)
		PRINTL ※ 誰も出撃しない場合は防衛力が低下します
	ENDIF
	DRAWLINE
	PRINTL [0]いいえ
	PRINTL [1]はい
	PRINTL [9]はい（次から確認しない）
	INPUT
	SELECTCASE RESULT
		;次から確認しない場合のフラグセット
		CASE 9
			FLAG:40 = 1
			;注意を一回で済ませた場合
			IF NUMBER_ON_FRONTLINE() == 0 && !GAME_OPTION_CHECK_F(OPTION_solo)
				FLAG:40 = 2
			ENDIF
		;はい以外の値入力なら全部いいえとし、中断
		CASEELSE
			RETURN 0
	ENDSELECT
;出撃もしくは防衛できるキャラがいない
ELSEIF FLAG:40 == 1 && NUMBER_ON_FRONTLINE() == 0 && !GAME_OPTION_CHECK_F(OPTION_solo) && CHECK_GAMEOVER_F() == 0
	DRAWLINE
	PRINTL 
	PRINTL 出撃・防衛を行う予定のキャラが一人も居ません
	PRINTL 
	CALL USERSHOP_ACTION_PLANDISP
	PRINTL 
	PRINTL このまま行動を開始して宜しいですか？
	PRINTL ※ 出撃または防衛しないことにより防衛力が低下します
	DRAWLINE
	PRINTL [0]いいえ
	PRINTL [1]はい
	PRINTL [9]はい（次から確認しない）
	INPUT
	SELECTCASE RESULT
		;次から確認しない場合のフラグセット
		CASE 9
			FLAG:40 = 2
		;はい以外の値入力なら全部いいえとし、中断
		CASEELSE
			RETURN 0
	ENDSELECT
ENDIF
;中断せずに抜けてきたなら行動開始
JUMP ACTION_MAIN

;----------------------------------------------------------
;行動予定を表示する関数
; 変数
;	CCOUNT			ループカウンタ
@USERSHOP_ACTION_PLANDISP
#DIM CCOUNT
VARSET LOCAL
PRINTL 【行動予定】
FOR CCOUNT, 0, CHARANUM
	SIF CCOUNT == MASTER || CFLAG:CCOUNT:999 == 0
		CONTINUE

	IF CFLAG:CCOUNT:0 != 状態_無事
		LOCAL += 1
		CONTINUE
	ENDIF

	SIF LOCAL:2 % 3 == 0 && LOCAL:2 != 0
		PRINTL 
	PRINTPLAINFORM [{CCOUNT}]%CALLNAME:CCOUNT%：
	CALL SHOP_PRINT_ACTIONPLAN, CFLAG:CCOUNT:100
	PRINT   
	;実行可能性のチェック
	SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_体力)
		PRINT （体力不足）
	SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_夜魔)
		PRINT （夜魔の貴族＆昼）
	SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_戦士)
		PRINT （生粋の戦士）
	SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_支援無効)
		PRINT （支援無効）
	SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_妊娠)
		PRINT （妊娠中）
	SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_欠損)
		PRINT （四肢欠損）
	SIF IS_ACTION_INCAPABLE(CFLAG:CCOUNT:100, CCOUNT, 行動制約_廃人)
		PRINT （廃人）
	
	LOCAL:2 += 1

NEXT

;--------------------------------------------------
;行動選択コマンドを選んだ場合の行動予定のセット処理
; 引数
;	SELECTACT	インターミッション画面で選んだ行動の番号（CFLAG.ERHで定義）
;	MULTISET	一括選択中かどうか
; 変数
;	HAS_INCAPABLE	1キャラでも何らかの行動制約にかかったかどうか
;	CCOUNT			ループカウンタ
@USERSHOP_SET_ACTION, SELECTACT, MULTISET
#DIM SELECTACT
#DIM MULTISET
#DIM DYNAMIC HAS_INCAPABLE = FALSE
#DIM CCOUNT

;ゲームオーバーモードか、一括選択中でない時に行動可能なキャラが選択されていないなら中止
SIF CHECK_GAMEOVER_F() || TARGET == MASTER || (CFLAG:0 != 状態_無事 && !MULTISET)
	RETURN 0
;ソロモードの場合防衛は選択できない（コマンド直打ち対策）
SIF SELECTACT == 予定_防衛 && GAME_OPTION_CHECK_F(OPTION_solo)
	RETURN 0
;パーティメンバーが2人以上いないと支援は選択できない（コマンド直打ち対策）
SIF SELECTACT == 予定_支援 && CHARANUM < 3
	RETURN 0

;一括選択中でないなら
IF MULTISET == 0
	;なんらかの行動制約にかかっているか？
	IF IS_ACTION_INCAPABLE(SELECTACT, TARGET)
		HAS_INCAPABLE = TRUE
	ELSE
		;行動制約にかかっていないなら行動予定をセット
		CFLAG:100 = SELECTACT
	ENDIF
	;行動予定（もしくは行動不可理由）の画面表示
	CALL USERSHOP_PRINT_ACTION_MSG, SELECTACT, TARGET

;一括選択中なら全キャラクターに対してセットする
ELSE
	FOR CCOUNT, 0, CHARANUM
		;パーティメンバーでなければ飛ばす
		SIF CCOUNT == MASTER || CFLAG:CCOUNT:999 == 0
			CONTINUE
		;操作可能な状態でなければ飛ばす
		;memo:この判定いる？　そもそもこの状態ならパーティメンバーから外れているはず
		;memo:判定漏れ対策というのなら条件が抜けてる（無事以外は不可にすべきでは）
		SIF GROUPMATCH(CFLAG:CCOUNT:0, 状態_幽閉, 状態_洗脳, 状態_クズ監禁, 状態_死亡)
			CONTINUE
		;なんらかの行動制約にかかっているか？
		IF IS_ACTION_INCAPABLE(SELECTACT, CCOUNT)
			HAS_INCAPABLE = TRUE
		ELSE
			;行動制約にかかっていないなら行動予定をセット
			CFLAG:CCOUNT:100 = SELECTACT
		ENDIF
		;行動予定（もしくは行動不可理由）の画面表示
		CALL USERSHOP_PRINT_ACTION_MSG, SELECTACT, CCOUNT
	NEXT
ENDIF

;行動制約にかかったキャラがいた（＝行動不可理由の表示があった）ならウェイトを入れて表示を見せる
SIF HAS_INCAPABLE == TRUE
	WAIT

;--------------------------------------------------
;行動予定（もしくは行動不可理由）の画面表示
; 引数
;	SELECTACT	インターミッション画面で選んだ行動の番号（CFLAG.ERHで定義）
;	TGTNUM		行動対象のキャラ番号
; 変数
;	ACTION_NAME	行動の名称（CFLAG.ERHで定義）
; 定数
;	ACTION_STR	行動予定の出力文（CFLAG.ERHの「キャラ行動予定」と同じ順序で並べること）
@USERSHOP_PRINT_ACTION_MSG, SELECTACT, TGTNUM
#DIM SELECTACT
#DIM TGTNUM
#DIMS ACTION_NAME
{
#DIMS CONST ACTION_STR =
"",
"出撃することにしました",
"鍛錬をすることにしました",
"休憩することにしました",
"資金を稼ぐことにしました",
"拠点を防衛することにしました",
"後方で戦闘支援に徹します",
"後方で情報収集に徹します",
"自由に行動することにしました"
}

;行動の名称を取得
;Emueraには辞書型がないためこうせざるを得ない
ACTION_NAME = %キャラ行動予定名称:(FINDELEMENT(キャラ行動予定, SELECTACT))%

PRINTL 
;体力が低下しているとできない
IF IS_ACTION_INCAPABLE(SELECTACT, TGTNUM, 行動制約_体力)
	PRINTFORML %CALLNAME:TGTNUM%は%ACTION_NAME%に必要な体力がありません
;妊娠中はできない
ELSEIF IS_ACTION_INCAPABLE(SELECTACT, TGTNUM, 行動制約_妊娠)
	PRINTFORML %CALLNAME:TGTNUM%は妊娠中のため%ACTION_NAME%ができません
;四肢欠損ならほとんどの行動ができない
ELSEIF IS_ACTION_INCAPABLE(SELECTACT, TGTNUM, 行動制約_欠損)
	PRINTFORML %CALLNAME:TGTNUM%は四肢欠損しているため%ACTION_NAME%ができません
;廃人なら休息以外できない
ELSEIF IS_ACTION_INCAPABLE(SELECTACT, TGTNUM, 行動制約_廃人)
	PRINTFORML %CALLNAME:TGTNUM%は廃人化しているため%ACTION_NAME%ができません
;FEAT効果によるコマンド制限
ELSEIF IS_ACTION_INCAPABLE(SELECTACT, TGTNUM, 行動制約_夜魔)
	SETCOLOR 文字色橙色
	PRINTFORML %CALLNAME:TGTNUM%は[夜魔の貴族]の効果で昼間は外出できません！
	RESETCOLOR
ELSEIF IS_ACTION_INCAPABLE(SELECTACT, TGTNUM, 行動制約_戦士)
	SETCOLOR 文字色橙色
	PRINTFORML %CALLNAME:TGTNUM%は[生粋の戦士]の効果で%ACTION_NAME%に参加できません！
	RESETCOLOR
;どの制限もないなら行動予定を表示
ELSE
	PRINTFORM %CALLNAME:TGTNUM%は%ACTION_STR:(FINDELEMENT(キャラ行動予定, SELECTACT))%
ENDIF
PRINTL
