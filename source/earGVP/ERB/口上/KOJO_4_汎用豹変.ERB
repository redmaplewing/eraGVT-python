;==================================================
;【独自関数】
;--------------------------------------------------
;豹変する場面の選択肢を表示する関数
;----------------------------------------------------------
;ARG	LOCAL
@GET_CFLAG277_CHOICE_KOJO_4(ARG)
SIF GETBIT(CFLAG:277,ARG)
	SETCOLOR 255,60,220
SELECTCASE ARG
	CASE K4普段
		PRINTFORML [{ARG}] 普段　　　　　
	CASE K4会敵
		PRINTFORML [{ARG}] 会敵　　　　　
	CASE K4襲来
		PRINTFORML [{ARG}] 襲来　　　　　
	CASE K4戦闘
		PRINTFORML [{ARG}] 戦闘　　　　　
	CASE K4戦闘_変身
		PRINTFORML [{ARG}] 戦闘(変身)　　
	CASE K4鍛錬
		PRINTFORML [{ARG}] 鍛錬　　　　　
	CASE K4休憩
		PRINTFORML [{ARG}] 休憩　　　　　
	CASE K4特別活動
		PRINTFORML [{ARG}] 特別活動　　　
	CASE K4特別活動_変身
		PRINTFORML [{ARG}] 特別活動(変身)
	CASE K4情報収集
		PRINTFORML [{ARG}] 情報収集　　　
	CASE K4情報収集_変身
		PRINTFORML [{ARG}] 情報収集(変身)
	CASE K4自由行動
		PRINTFORML [{ARG}] 自由行動　　　
	CASE K4自由行動_変身
		PRINTFORML [{ARG}] 自由行動(変身)
	CASE K4幽閉
		PRINTFORML [{ARG}] 幽閉　　　　　
	CASE K4幽閉_変身
		PRINTFORML [{ARG}] 幽閉(変身)　　
	CASE K4洗脳
		PRINTFORML [{ARG}] 洗脳　　　　　
	CASE K4悪堕ち
		PRINTFORML [{ARG}] 悪堕ち　　　　
ENDSELECT
RESETCOLOR

