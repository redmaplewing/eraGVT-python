	SELECTCASE RAND:2
		CASE 0
			PRINTFORML 「ぉ゛……あ゛……げ、げぼっ……ぅ゛ぶ……がは……あ゛……」
		CASEELSE
			PRINTFORML 「……ぶひ……ぶぎぃ……げぽっ、ぉ゛げぇ゛……た、ひゅか……ぁぅ……?」
	ENDSELECT
