
@randt(ARGS,ARGS:1,ARGS:2,ARGS:3,ARGS:4,ARGS:5,ARGS:6,ARGS:7,ARGS:8,ARGS:9,ARGS:10,ARGS:11,ARGS:12,)
#FUNCTIONS
	FOR LOCAL, 0, 12
		SIF ARGS:LOCAL == ""
			BREAK
	NEXT
	IF LOCAL>0
		LOCAL=RAND:(LOCAL)
		RETURNF ARGS:LOCAL
	ENDIF
	RETURNF

