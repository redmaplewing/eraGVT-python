;**************************************************
;救出された際
;**************************************************
;幽閉状態から救出された
;--------------------------------------------------
@KOJO_1_OTHER_BATTLE_END_RESCUED_16
IF TALENT:触手の虜
	PRINTFORML 「ぐげぇ……げぼぉ…ぉ゛ぁ゛あ゛……あ？ ……ここは、%SELF_CALL(7)%は……ぁ、ああぁ……」
ELSEIF ABL:触手中毒>=3
	SELECTCASE RAND:2
		CASE 0
			PRINTFORML 「ぉ゛……あ゛……げ、げぼっ……ぅ゛ぶ……がは……あ゛……」
		CASEELSE
			PRINTFORML 「……ぶひ……ぶぎぃ……げぽっ、ぉ゛げぇ゛……た、ひゅか……ぁぅ……?」
	ENDSELECT
ELSE
	PRINTFORML 「……ごめん」
	PRINTFORML 目を伏せたまま、地面に倒れ伏したまま、%CALLNAME%はぽつりと声を漏らした。
ENDIF



