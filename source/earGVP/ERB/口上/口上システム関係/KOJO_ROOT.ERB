;==============================================================================
;口上共通ルート処理
; 引数
;	C_NO	キャラ番号
;	CODE	呼び出す口上種類を表す文字列（口上変数の名前の一部）
;	FORCEPRINT	気絶していても強制的に口上を表示する場合
;	BEFORE_LINECOUNT	口上表示前のLINECOUNTの値（表示した口上の行数を返すために使う）
; 戻り値
;	該当口上が見つからない場合、-1を返す
;	口上で特殊な値を返した場合、その値をそのまま返す（現在999のみ）
;	それ以外の場合、出力行数を返す
@KOJO_ROOT(C_NO, CODE, FORCEPRINT)
#DIM C_NO
#DIMS CODE
#DIM FORCEPRINT
#DIM BEFORE_LINECOUNT
;気絶状態の場合は口上なし、ただしFORCEPRINTフラグが立っている呼び出しは除く
IF (TCVARn:12 & 気絶) && !FORCEPRINT
	;ランダム分岐フラグをリセット
	FLAG:900 = 0
	RETURN 0
ENDIF
;結界で防がれた場合は口上なし
IF BASE:Ｃ結界耐久力 > 0 && (STRFIND(CODE, "SEX_COM0") != -1 || STRFIND(CODE, "SEX_COM1") != -1 || STRFIND(CODE, "SPCOM0") != -1)
	;ランダム分岐フラグをリセット
	FLAG:900 = 0
	RETURN 0
ENDIF
IF BASE:Ｖ結界耐久力 > 0 && (STRFIND(CODE, "SEX_COM2") != -1 || STRFIND(CODE, "SEX_COM3") != -1 || STRFIND(CODE, "SPCOM1") != -1)
	;ランダム分岐フラグをリセット
	FLAG:900 = 0
	RETURN 0
ENDIF
IF BASE:Ａ結界耐久力 > 0 && (STRFIND(CODE, "SEX_COM4") != -1 || STRFIND(CODE, "SEX_COM5") != -1 || STRFIND(CODE, "SPCOM2") != -1)
	;ランダム分岐フラグをリセット
	FLAG:900 = 0
	RETURN 0
ENDIF
IF BASE:Ｂ結界耐久力 > 0 && (STRFIND(CODE, "SEX_COM6") != -1 || STRFIND(CODE, "SEX_COM7") != -1 || STRFIND(CODE, "SPCOM3") != -1 || STRFIND(CODE, "SPCOM5") != -1)
	;ランダム分岐フラグをリセット
	FLAG:900 = 0
	RETURN 0
ENDIF

;口上呼び出し前の行数を記録する
BEFORE_LINECOUNT = LINECOUNT

;口上色設定、口上呼び出し
IF C_NO == キャラ口上_女性汎用 || C_NO == キャラ口上_オトコ汎用
	IF STRFIND(CODE, "OTHER_") == -1
		FLAG:62 = 0
		TRYCALLFORM KOJO_{C_NO}_COLOR_{SEIKAKU_CHECK_F(TARGET)}
		TRYCCALLFORM KOJO_{C_NO}_%CODE%_{SEIKAKU_CHECK_F(TARGET)}
		CATCH
			RESETCOLOR
			;ランダム分岐フラグをリセット
			FLAG:900 = 0
			RETURN -1
		ENDCATCH
	ELSE
		FLAG:62 = 1
		TRYCALLFORM KOJO_{C_NO}_OTHER_COLOR_{SEIKAKU_CHECK_F(FLAG:111)}
		TRYCCALLFORM KOJO_{C_NO}_%CODE%_{SEIKAKU_CHECK_F(FLAG:111)}
		CATCH
			RESETCOLOR
			;ランダム分岐フラグをリセット
			FLAG:900 = 0
			RETURN -1
		ENDCATCH
	ENDIF
ELSE
	IF STRFIND(CODE, "OTHER_") == -1
		TRYCALLFORM KOJO_{C_NO}_COLOR
		FLAG:62 = 0
	ELSE
		TRYCALLFORM KOJO_{C_NO}_OTHER_COLOR
		FLAG:62 = 1
	ENDIF
	TRYCCALLFORM KOJO_{C_NO}_%CODE%
	CATCH
		RESETCOLOR
		;ランダム分岐フラグをリセット
		FLAG:900 = 0
		RETURN -1
	ENDCATCH
ENDIF

;終了処理
RESETCOLOR
;ランダム分岐フラグをリセット
FLAG:900 = 0
;一部口上の演出発生戻り値はそのまま返す
SIF RESULT == 999
	RETURN 999

;出力行数を返す
RETURN LINECOUNT - BEFORE_LINECOUNT
