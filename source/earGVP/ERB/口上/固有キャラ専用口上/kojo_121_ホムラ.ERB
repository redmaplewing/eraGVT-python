@KOJO_121_BATTLE_CHARA_NANORI
CFLAG:5 = 1
STRDATA LOCALS
	DATAFORM 、参上
	DATAFORM 、見参
	DATAFORM 、推参
	DATAFORM 、準備完了
ENDDATA
IF TALENT:おっとり
	STRDATA LOCALS:1
		DATAFORM ！
		DATAFORM ！
		DATAFORM ……用意はいいかしら？
		DATAFORM ……さて、行きますよ
	ENDDATA
ELSE
	STRDATA LOCALS:1
		DATAFORM ！
		DATAFORM ！
		DATAFORM ！
		DATAFORM …さあ、行くわよ！
		DATAFORM …負けないわよ！
		DATAFORM …覚悟しなさい！
	ENDDATA
ENDIF
CSTR:3=%CSTR:0%%LOCALS%%LOCALS:1%
