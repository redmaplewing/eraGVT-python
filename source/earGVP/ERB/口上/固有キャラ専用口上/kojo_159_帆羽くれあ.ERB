;口上オリジナルの名乗りを使用する場合のみコメントアウトを外して記述してください
;@KOJO_159_BATTLE_CHARA_NANORI

;SP変身時のかけ声	再変身、必殺技の一つ
@KOJO_159_BATTLE_CHARA_SP_TRANSFORMCALL
IF CSTR:5 == "エクレールアタック" && CSTR:6 == "エクレールアタック" && CSTR:7 == "エクレールアタック" && CDFLAG:TARGET:近距離:戦闘スタイル == 0 && CDFLAG:TARGET:中距離:戦闘スタイル == 0 && CDFLAG:TARGET:遠距離:戦闘スタイル == 0
	TALENT:魔力貯蔵 = 0
	TALENT:秘められし力 = 0
	TALENT:超反応 = 1
	TALENT:エアマスター = 1
	TALENT:空中得意 = 1
	MAXBASE:空中ダッシュ ++
	BASE:空中ダッシュ = MAXBASE:空中ダッシュ
	BASE:攻撃 -= 30
	BASE:防御 -= 5
	BASE:敏捷 += 65
	BASE:知性 -= 5
	CSTR:34 = 0//255//255
	CSTR:5 = エクレールイリュージョン
	CDFLAG:TARGET:近距離:戦闘スタイル = 1
	CSTR:6 = きらめきタイム
	CDFLAG:TARGET:中距離:戦闘スタイル = 3
	CSTR:7 = プリキュア・フライング・インフィニティ
	CDFLAG:TARGET:遠距離:戦闘スタイル = 3
	PRINTL 右目の色が一時的に変わった！
	PRINTDL 一時的に空中得意になった！
	PRINTDL 一時的にフィートと戦闘スタイルが変わった！
	PRINTFORMDL 
	PRINTFORMDL 　近距離『%CSTR:5%』<<%FSTYLE_NAME_F(TARGET,1)%>>
	PRINTFORMDL 　中距離『%CSTR:6%』<<%FSTYLE_NAME_F(TARGET,2)%>>
	PRINTFORMDL 　遠距離『%CSTR:7%』<<%FSTYLE_NAME_F(TARGET,3)%>>

	;ステータスの再計算
	CALL LEVELSTATUS, TARGET

	;見切りフラグを立てる
	TFLAG:25 = 1
	;体力20%回復
	LOCAL = MAXBASE:体力
	TIMES LOCAL, 0.20
	SIF BASE:体力 + LOCAL >= MAXBASE:体力
		LOCAL = MAXBASE:体力 - BASE:体力
	;体力が尽きている場合、10%しか回復しない
	SIF BASE:体力 == 0
		TIMES LOCAL, 0.5
	BASE:体力 += LOCAL
	;気力20%回復
	LOCAL = MAXBASE:気力
	TIMES LOCAL, 0.20
	SIF BASE:気力 + LOCAL >= MAXBASE:気力
		LOCAL = MAXBASE:気力 - BASE:気力
	;気力が尽きている場合、10%しか回復しない
	SIF BASE:気力 == 0
		TIMES LOCAL, 0.5
	BASE:気力 += LOCAL
ENDIF
PRINTL 
PRINTL 「きらめきタイム！！」

