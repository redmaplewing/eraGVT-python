;eraGVT　帆羽くれあ口上　ver0.3　by Musue　2026/08/30
;
;
;戦況に応じて戦闘スタイルを変えることができるプリキュア
;SP変身すると右目の色とフィートと戦闘スタイルが変化する（デフォルトの武器名と戦闘スタイルのみ）
;口上の改造部分などの権利関係はすべて放棄しておりますのでご自由にどうぞ
;
;帆羽くれあ　　　　　　　　　変身前でもある程度は戦えるが、限界がある
;　魔力貯蔵、秘められし力、狩人の勘
;キュアエクレール　　　　　　消耗の少ない持久戦が得意
;　魔力貯蔵、秘められし力、狩人の勘
;キュアエクレール（SP変身）　高機動な空中戦が得意
;　空中ダッシュ＋、空中得意、超反応、狩人の勘、エアマスター、見切り、体力と気力10％～20％回復
;
;（変身前ステータス　50％　　　変身後ステータス　100％　　　SP変身後ステータス　120％）
;
;
;ver0.1　　新規作成
;ver0.2　　変身時の名乗りを補完
;ver0.3　　各フォームのバランス調整
;
;
;--------------------------------------------------------------------------------------------------------------------------------------------------------

;必殺技リセット
;--------------------------------------------------
@KOJO_159_SKILL_RESET
IF CSTR:5 == "エクレールイリュージョン" && CSTR:6 == "きらめきタイム" && CSTR:7 == "プリキュア・フライング・インフィニティ" && CDFLAG:TARGET:近距離:戦闘スタイル == 1 && CDFLAG:TARGET:中距離:戦闘スタイル == 3 && CDFLAG:TARGET:遠距離:戦闘スタイル == 3
	TALENT:超反応 = 0
	TALENT:エアマスター = 0
	TALENT:空中得意 = 0
	MAXBASE:空中ダッシュ --
	BASE:空中ダッシュ = MAXBASE:空中ダッシュ
	TALENT:魔力貯蔵 = 1
	TALENT:秘められし力 = 1
	BASE:攻撃 += 30
	BASE:防御 += 5
	BASE:敏捷 -= 65
	BASE:知性 += 5
	CSTR:34 = 255//125//8
	CSTR:5 = エクレールアタック
	CDFLAG:TARGET:近距離:戦闘スタイル = 0
	CSTR:6 = エクレールアタック
	CDFLAG:TARGET:中距離:戦闘スタイル = 0
	CSTR:7 = エクレールアタック
	CDFLAG:TARGET:遠距離:戦闘スタイル = 0
	PRINTDL 
	SETCOLOR 255,125,8
	PRINTL 右目の色が戻った！
	PRINTDL 空中得意じゃなくなった！
	PRINTDL フィートと戦闘スタイルが戻った！
	PRINTFORMDL 
	PRINTFORMDL 　近距離『%CSTR:5%』<<%FSTYLE_NAME_F(TARGET,1)%>>
	PRINTFORMDL 　中距離『%CSTR:6%』<<%FSTYLE_NAME_F(TARGET,2)%>>
	PRINTFORMDL 　遠距離『%CSTR:7%』<<%FSTYLE_NAME_F(TARGET,3)%>>

	;ステータスの再計算
	CALL LEVELSTATUS, TARGET
ENDIF

